{
  "name": "sellercalchub",
  "type": "module",
  "version": "0.0.1",
  "description": "Free, fast marketplace fee and profit calculators for resellers and online sellers",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:prod": "tsx scripts/lint-seo.ts && STRICT_PROD=true astro build && tsx scripts/check-thin-content.ts",
    "lint:seo": "tsx scripts/lint-seo.ts",
    "check:thin-content": "tsx scripts/check-thin-content.ts",
    "verify:fees": "STRICT_PROD=true astro sync",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "tsx scripts/check-links.ts",
    "audit:freshness": "tsx scripts/check-fee-freshness.ts",
    "audit:onpage": "tsx scripts/generate-seo-audits.ts",
    "indexnow:ping": "tsx scripts/ping-indexnow.ts",
    "lhci": "lhci autorun",
    "audit:perf": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@lhci/cli": "^0.16.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
