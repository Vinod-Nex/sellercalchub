{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/whatnot-fee-calculator/index.html",
        "http://localhost/etsy-fee-calculator/index.html",
        "http://localhost/etsy-offsite-ads-fee-calculator/index.html",
        "http://localhost/ebay-fee-calculator/index.html",
        "http://localhost/ebay-final-value-fee-calculator/index.html",
        "http://localhost/ebay-profit-calculator/index.html",
        "http://localhost/ebay-shipping-fee-calculator/index.html",
        "http://localhost/ebay-fee-calculator-uk/index.html",
        "http://localhost/ebay-and-paypal-fee-calculator/index.html",
        "http://localhost/marketplace-fee-calculators/index.html",
        "http://localhost/twitch-bits-to-usd/index.html",
        "http://localhost/about/index.html",
        "http://localhost/methodology/index.html",
        "http://localhost/contact/index.html",
        "http://localhost/privacy/index.html",
        "http://localhost/terms/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
