---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';

export interface Props {
  /** Page title - required per page (no default hard-coded in layout) */
  title: string;
  /** Meta description - required per page (no default hard-coded in layout) */
  description: string;
  /** Explicit canonical path (e.g. '/whatnot-fee-calculator/') or defaults to current pathname */
  canonicalPath?: string;
  /** Open Graph preview image URL */
  ogImage?: string;
  /** Open Graph type ('website' | 'article') */
  ogType?: 'website' | 'article';
  /** Prevent search engines from indexing this page */
  noindex?: boolean;
  /** Schema.org structured data object or array */
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** HTML document language code (defaults to current Astro locale or 'en') */
  lang?: string;
  /** Optional class name for the <main> container */
  mainClass?: string;
}

/**
 * HEADING HIERARCHY CONVENTION:
 * Every page consuming BaseLayout MUST render exactly ONE <h1> tag inside the
 * <main id="main-content"> element to ensure strict WCAG AA accessibility
 * and search engine indexing compliance. Do not place multiple <h1> tags per page.
 */

const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogType,
  noindex,
  structuredData,
  lang = Astro.currentLocale ?? 'en',
  mainClass = '',
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <Head
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      structuredData={structuredData}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-canvas text-body font-sans transition-colors duration-150 antialiased overflow-x-hidden">
    <!-- Accessible Skip Link (WCAG AA 2.4.1) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-3 focus:min-h-[44px] focus:inline-flex focus:items-center focus:bg-primary focus:text-on-primary focus:font-bold focus:text-ui-label focus:rounded-xs focus:shadow-level-4 focus:outline-none focus:ring-2 focus:ring-on-primary"
    >
      Skip to main content
    </a>

    <!-- Sticky-free Header Slot with default Header component -->
    <slot name="header">
      <Header />
    </slot>

    <!-- Main Content Region -->
    <main id="main-content" class={`flex-1 min-w-0 w-full max-w-full ${mainClass}`}>
      <slot />
    </main>

    <!-- Footer Slot with default Footer component -->
    <slot name="footer">
      <Footer />
    </slot>

    <!-- Non-blocking Privacy / Consent Banner -->
    <ConsentBanner />

    <!-- Privacy-Preserving Cloudflare Web Analytics & Custom Event Dispatcher -->
    <CloudflareAnalytics />
  </body>
</html>
