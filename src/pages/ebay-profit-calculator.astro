---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalculatorIsland from "../components/CalculatorIsland.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustHeader from "../components/TrustHeader.astro";
import FormulaBlock from "../components/FormulaBlock.astro";
import WorkedExample from "../components/WorkedExample.astro";
import EdgeCases from "../components/EdgeCases.astro";
import FAQ from "../components/FAQ.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import LastVerified from "../components/LastVerified.astro";
import AuthorByline from "../components/AuthorByline.astro";
import { getPageSeo } from "../lib/seo";
import { buildCalculatorStructuredData } from "../lib/schema";

const seo = getPageSeo("/ebay-profit-calculator/");

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "All Calculators", href: "/marketplace-fee-calculators/" },
  { name: "eBay Fee Calculator", href: "/ebay-fee-calculator/" },
  { name: "Profit Calculator" },
];

// FAQ definitions
const faqs = [
  {
    question: "How do I calculate my true net profit on an eBay sale?",
    answer:
      "True net profit is calculated by starting with the total payment collected from the buyer (item price + shipping charged), and then subtracting: (1) eBay's Final Value Fee, (2) the per-order fee ($0.30 or $0.40), (3) optional Promoted Listings fees, (4) your cost of goods sold (what you paid to acquire or manufacture the item), and (5) your actual postage and packaging expenses.",
  },
  {
    question: "What is a healthy profit margin for an eBay reseller?",
    answer:
      "Most successful online resellers aim for a profit margin between 35% and 55% for used or thrifted goods, and 20% to 35% for wholesale or brand-new inventory. Lower-margin items (under 15%) carry higher risk of loss if a customer returns an item or if shipping costs fluctuate.",
  },
  {
    question: "How does the reverse profit calculator mode work?",
    answer:
      "Our reverse calculator uses a high-precision binary search engine to solve for the exact sale price you need to list at. Simply toggle to 'Reverse Mode', choose whether you want to target a dollar net profit (e.g., $30) or a target profit margin percentage (e.g., 40%), enter your inventory cost and postage, and the tool immediately returns the required listing price.",
  },
  {
    question: "What is a break-even price and why is it important?",
    answer:
      "Your break-even price is the absolute lowest price you can sell an item for without losing money ($0.00 net profit). Selling below your break-even price means you are paying out of pocket to ship the item to the buyer. Knowing your break-even point protects you when running discounts or accepting 'Best Offers'.",
  },
  {
    question: "How do Promoted Listings impact my bottom-line profit?",
    answer:
      "Promoted Listings Standard fees are deducted as a percentage of the total transaction amount (including shipping). If you set an ad rate of 5% on a $100 sale with $10 shipping, eBay deducts an extra $5.50 in ad fees. Because this fee is taken from the top line, it directly reduces your net profit dollar-for-dollar.",
  },
];

// Structured Data
const structuredData = buildCalculatorStructuredData({
  name: seo.h1,
  url: "/ebay-profit-calculator/",
  description: seo.metaDescription,
  currency: "USD",
  breadcrumbs,
  faqs,
});
---

<BaseLayout
  title={seo.title}
  description={seo.metaDescription}
  canonicalPath="/ebay-profit-calculator/"
  structuredData={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header & Direct Answer in First Paragraph -->
    <header class="space-y-4">
      <TrustHeader platform="ebay-us" />

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>

      <p class="text-body-lg text-body max-w-3xl leading-relaxed">
        To calculate net profit after eBay fees, deduct your total Final Value Fee (<strong class="text-ink">13.25% + $0.40</strong> on gross buyer payment), item acquisition cost (COGS), actual postage label costs, and packaging supplies from your gross sale price. For example, on a $100 sale with $30 inventory cost and $8 shipping, your net profit is <strong class="text-ink">$48.35</strong> (a 48.4% net margin and 127% ROI). Use this calculator to model your net profit or switch to reverse target-pricing mode to find the exact price required for your profit goal.
      </p>

      <!-- Reciprocal Link to Pillar -->
      <div class="pt-1">
        <a
          href="/ebay-fee-calculator/"
          class="inline-flex items-center gap-1.5 min-h-[44px] py-2 text-primary hover:underline font-semibold text-ui-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary rounded-xxs"
        >
          <svg class="w-4 h-4" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          <span>Looking for category commission schedules? Go to the main eBay Fee Calculator</span>
        </a>
      </div>
    </header>

    <!-- 2. Calculator Island Above the Fold -->
    <section class="space-y-4" id="calculator">
      <CalculatorIsland
        platform="ebay-us"
        showPlatformTabs={false}
        initialPrice={100.0}
        initialItemCost={30.0}
        initialShippingCharged={0.0}
        initialShippingCost={8.0}
      />
    </section>

    <!-- 3. Formula in Plain Text -->
    <FormulaBlock platform="ebay-us" />

    <!-- 4. One Worked Example -->
    <WorkedExample
      platform="ebay-us"
      title="Worked Example: Net Profit & ROI on a $100 Sale"
      description="Step-by-step P&L breakdown for an item sold at $100.00 with free shipping, $30.00 acquisition cost, and $8.00 postage:"
      itemPrice={100.0}
      itemCost={30.0}
      shippingCharged={0.0}
      shippingCost={8.0}
    />

    <!-- 5. Edge Cases -->
    <EdgeCases platform="ebay-us" />

    <!-- Reverse Pricing Mode Guide -->
    <section class="space-y-4 border-t border-hairline pt-8">
      <h2 class="text-heading-2 font-bold text-ink">
        How Reverse Pricing Mode Works
      </h2>
      <p class="text-body text-body leading-relaxed">
        Instead of guessing prices and seeing what profit is left over, reverse mode calculates backwards to solve for your target bottom line:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-lg border border-hairline-strong bg-canvas p-5 space-y-2">
          <span class="text-caption font-bold text-primary uppercase tracking-wider block">
            Target Profit ($) Mode
          </span>
          <h3 class="text-heading-4 font-bold text-ink">
            Set Desired Net Dollars
          </h3>
          <p class="text-body-sm text-body leading-relaxed">
            Enter the exact amount of cash you want to deposit into your bank account after all fees and expenses (e.g. $40.00). The engine solves for the required listing price using exact round-trip validation.
          </p>
        </div>

        <div class="rounded-lg border border-hairline-strong bg-canvas p-5 space-y-2">
          <span class="text-caption font-bold text-primary uppercase tracking-wider block">
            Target Margin % Mode
          </span>
          <h3 class="text-heading-4 font-bold text-ink">
            Set Desired Profit Margin
          </h3>
          <p class="text-body-sm text-body leading-relaxed">
            Enter your business margin goal (e.g. 50%). The engine determines the exact price where your net profit divided by the gross buyer total matches your target margin percentage.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. FAQ Section -->
    <FAQ
      items={faqs}
      title="Frequently Asked Questions About eBay Profit & Margins"
      description="Expert guidance on improving margins, controlling packaging costs, and price optimization."
    />

    <!-- 7. Related Calculators -->
    <RelatedCalculators currentPlatform="ebay-us" />

    <!-- Trust signals footer -->
    <AuthorByline platform="ebay-us" />
    <LastVerified platform="ebay-us" />
  </div>
</BaseLayout>
