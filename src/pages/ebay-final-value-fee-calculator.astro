---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalculatorIsland from "../components/CalculatorIsland.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustHeader from "../components/TrustHeader.astro";
import FormulaBlock from "../components/FormulaBlock.astro";
import WorkedExample from "../components/WorkedExample.astro";
import EdgeCases from "../components/EdgeCases.astro";
import FAQ from "../components/FAQ.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import LastVerified from "../components/LastVerified.astro";
import AuthorByline from "../components/AuthorByline.astro";
import { EBAY_US_CATEGORIES } from "../lib/calc/ebay-us";
import { getPageSeo } from "../lib/seo";

const seo = getPageSeo("/ebay-final-value-fee-calculator/");

// FAQ definitions
const faqs = [
  {
    question: "What is eBay's Final Value Fee and what does it include?",
    answer:
      "eBay's Final Value Fee (FVF) is the primary commission fee deducted when an item sells. It consists of two parts: a category-based percentage of the total buyer payment (typically 13.25% for standard sellers or 12.35% for Store subscribers) and a fixed per-order fee ($0.30 for orders ≤ $10.00, or $0.40 for orders > $10.00). Payment processing is built into this fee, so sellers do not pay separate payment gateway charges.",
  },
  {
    question: "Why does the Final Value Fee percentage drop over $7,500?",
    answer:
      "For most categories, eBay caps its standard 13.25% (or 12.35% Store) rate at the first $7,500 of the sale per item. Any portion of the sale amount above $7,500 is assessed at a significantly reduced rate of 2.35%. In specialized categories like Consumer Electronics, the lower threshold kicks in at $2,500 for Store subscribers.",
  },
  {
    question: "How do I qualify for the 10% Top Rated Plus discount on FVF?",
    answer:
      "Top Rated Sellers who offer same-day or 1-business-day handling and 30-day or longer free returns on their listings receive a 10% discount on the percentage portion of the Final Value Fee. For example, a 13.25% fee is reduced to 11.92%. The discount applies strictly to the percentage fee, not to the fixed $0.30/$0.40 per-order fee.",
  },
  {
    question:
      "Are sneakers and athletic shoes subject to a different Final Value Fee?",
    answer:
      "Yes. For Men's and Women's Athletic Shoes sold for $150 or more, eBay charges a reduced flat Final Value Fee of 8.0%, and the standard fixed per-order fee ($0.40) is completely waived. Athletic shoes sold under $150 are subject to standard footwear/clothing category rates.",
  },
  {
    question:
      "Does eBay charge the Final Value Fee on sales tax collected from the buyer?",
    answer:
      "Yes. Because eBay processes the entire financial transaction through its managed payments system, the percentage Final Value Fee applies to the total amount paid by the buyer at checkout, which includes applicable state sales tax and shipping fees.",
  },
];

// Structured Data
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "eBay Final Value Fee Calculator",
    url: "https://sellercalchub.com/ebay-final-value-fee-calculator/",
    description: seo.metaDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "eBay Final Value Fee Calculator",
    applicationCategory: "BusinessApplication",
    operatingSystem: "All",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={seo.title}
  description={seo.metaDescription}
  canonicalPath="/ebay-final-value-fee-calculator/"
  structuredData={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs
      items={[
        { name: "Home", href: "/" },
        { name: "All Calculators", href: "/marketplace-fee-calculators/" },
        { name: "eBay Fee Calculator", href: "/ebay-fee-calculator/" },
        { name: "Final Value Fee Calculator" },
      ]}
    />

    <!-- Header & Direct Answer in the First Paragraph -->
    <header class="space-y-4">
      <TrustHeader platform="ebay-us" />

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>

      <p class="text-body-lg text-body max-w-3xl leading-relaxed">
        eBay Final Value Fees (FVF) range from <strong class="text-ink">3.0% to 15.3%</strong> depending on category, plus a fixed <strong class="text-ink">$0.40 per order ($0.30 for orders $10.00 or less)</strong>. Most standard categories are charged <strong class="text-ink">13.25%</strong> on the first $7,500 of the sale and <strong class="text-ink">2.35%</strong> on the portion over $7,500. Guitars are charged 6.7%, heavy equipment 3.0%, jewelry and watches 15.0% up to $5,000, and sneakers $150+ are 8.0% with the $0.40 order fee waived. Enter your sale price and category to isolate your exact final value fee.
      </p>

      <!-- Reciprocal Link to Pillar -->
      <div class="pt-1">
        <a
          href="/ebay-fee-calculator/"
          class="inline-flex items-center gap-1.5 min-h-[44px] text-primary hover:underline font-semibold text-ui-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary rounded-xxs"
        >
          <svg class="w-4 h-4" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          <span>
            Need full net profit, postage costs, and COGS? Go to the main eBay Fee & Profit Calculator
          </span>
        </a>
      </div>
    </header>

    <!-- 2. Calculator Island Above the Fold -->
    <section class="space-y-4" id="calculator">
      <CalculatorIsland platform="ebay-us" showPlatformTabs={false} />
    </section>

    <!-- 3. Formula in Plain Text -->
    <FormulaBlock platform="ebay-us" />

    <!-- 4. One Worked Example -->
    <WorkedExample
      platform="ebay-us"
      title="Worked Example: Final Value Fee on a $120 Sale"
      description="Step-by-step isolation of the percentage final value fee and per-order fee on a $120 transaction:"
      itemPrice={120.0}
      itemCost={40.0}
      shippingCharged={10.0}
      shippingCost={9.5}
    />

    <!-- 5. Edge Cases -->
    <EdgeCases platform="ebay-us" />

    <!-- Category Rate Schedule Table -->
    <section class="space-y-4 border-t border-hairline pt-8">
      <div class="space-y-1">
        <h2 class="text-heading-2 font-bold text-ink">
          Official eBay US Category Rate Schedule
        </h2>
        <p class="text-body text-body leading-relaxed">
          eBay final value fees vary by listing category and whether you subscribe to a Basic or higher eBay Store:
        </p>
      </div>

      <div
        class="overflow-x-auto rounded-lg border border-hairline-strong bg-canvas focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary"
        tabindex="0"
        role="region"
        aria-label="eBay category fee rate comparison table"
      >
        <table class="w-full text-body-sm text-left border-collapse">
          <thead>
            <tr class="border-b border-hairline bg-canvas-soft text-ink font-bold">
              <th class="p-3.5">Category</th>
              <th class="p-3.5 text-center">Standard Seller Rate</th>
              <th class="p-3.5 text-center">eBay Store Rate</th>
              <th class="p-3.5">Threshold & High-Value Rules</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            {EBAY_US_CATEGORIES.map((cat) => (
              <tr class="hover:bg-canvas-soft/40 transition-colors">
                <td class="p-3.5 font-medium text-ink">{cat.name}</td>
                <td class="p-3.5 text-center font-mono font-bold text-ink">
                  {cat.rateStandard}%
                </td>
                <td class="p-3.5 text-center font-mono font-bold text-primary">
                  {cat.rateStore}%
                </td>
                <td class="p-3.5 text-caption text-muted">
                  {cat.threshold
                    ? `${cat.rateAboveThreshold}% on portion over $${cat.threshold.toLocaleString()}`
                    : cat.id === "athletic_shoes_150"
                      ? "No per-order fee for items $150+"
                      : "Standard tier"}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 6. FAQ Section -->
    <FAQ
      items={faqs}
      title="Frequently Asked Questions About Final Value Fees"
      description="Common questions about eBay Final Value Fee deductions, percentages, and seller exemptions."
    />

    <!-- 7. Related Calculators -->
    <RelatedCalculators currentPlatform="ebay-us" />

    <!-- Trust signals footer -->
    <AuthorByline platform="ebay-us" />
    <LastVerified platform="ebay-us" />
  </div>
</BaseLayout>
