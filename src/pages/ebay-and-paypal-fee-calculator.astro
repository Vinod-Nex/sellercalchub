---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorIsland from '../components/CalculatorIsland.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TrustHeader from '../components/TrustHeader.astro';
import FormulaBlock from '../components/FormulaBlock.astro';
import WorkedExample from '../components/WorkedExample.astro';
import EdgeCases from '../components/EdgeCases.astro';
import FAQ from '../components/FAQ.astro';
import RelatedCalculators from '../components/RelatedCalculators.astro';
import LastVerified from '../components/LastVerified.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { getPageSeo } from '../lib/seo';
import { buildCalculatorStructuredData } from '../lib/schema';

const seo = getPageSeo('/ebay-and-paypal-fee-calculator/');

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'All Calculators', href: '/marketplace-fee-calculators/' },
  { name: 'eBay Fee Calculator', href: '/ebay-fee-calculator/' },
  { name: 'eBay & PayPal Explainer' },
];

// FAQ definitions
const faqs = [
  {
    question: "Does eBay charge a separate PayPal fee if a buyer pays with PayPal?",
    answer:
      "No. Even if a buyer completes checkout using their PayPal balance or PayPal Credit, eBay processes the transaction through eBay Managed Payments. You are never charged a separate PayPal merchant fee, and PayPal takes $0.00 from your seller payout.",
  },
  {
    question: "When did eBay stop using PayPal for seller payouts?",
    answer:
      "eBay and PayPal originally spun off into separate public companies in 2015. Between 2018 and 2021, eBay phased in its own internal Managed Payments system in partnership with Adyen. By mid-2021, Managed Payments became mandatory globally, eliminating PayPal as the merchant processor for eBay sellers.",
  },
  {
    question: "Can buyers still use PayPal to purchase items on eBay?",
    answer:
      "Yes. Buyers can freely pay with PayPal, PayPal Credit, Apple Pay, Google Pay, Venmo, credit cards, and debit cards. eBay acts as the merchant of record and absorbs all payment acquiring fees. As a seller, you receive your payout directly to your bank account regardless of which payment method the buyer selected.",
  },
  {
    question: "Where do my eBay sales proceeds get deposited?",
    answer:
      "Your net sales funds are deposited directly into your linked checking account or bank account via automated ACH electronic funds transfer. You can configure your payout schedule to daily, weekly, biweekly, or monthly.",
  },
  {
    question: "Why do some online calculators still show a 2.9% + $0.30 PayPal fee for eBay?",
    answer:
      "Outdated online calculators built before 2021 have not been updated to reflect eBay Managed Payments. Prior to 2021, sellers paid a 10% fee to eBay and a separate 2.9% + $0.30 fee to PayPal. Today, eBay charges a single consolidated Final Value Fee (typically 13.25% + $0.30/$0.40) with zero third-party processing charges.",
  },
];

// Structured Data
const structuredData = buildCalculatorStructuredData({
  name: seo.h1,
  url: '/ebay-and-paypal-fee-calculator/',
  description: seo.metaDescription,
  currency: 'USD',
  breadcrumbs,
  faqs,
});
---

<BaseLayout
  title={seo.title}
  description={seo.metaDescription}
  canonicalPath="/ebay-and-paypal-fee-calculator/"
  structuredData={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header & Direct Answer in First Paragraph -->
    <header class="space-y-4">
      <TrustHeader platform="ebay-us" />

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>

      <p class="text-body-lg text-body leading-relaxed max-w-3xl">
        Modern eBay Managed Payments charges an all-in <strong class="text-ink">13.25% + $0.40 fee</strong> with zero separate payment processing charges. Under eBay's legacy model (prior to 2021), sellers paid eBay a 10.0% Final Value Fee plus PayPal's merchant fee of 2.9% + $0.30 (totaling 12.9% + $0.30). Managed Payments provides lower fees on orders above $50 and eliminates PayPal's separate international cross-border surcharges. Compare historical eBay + PayPal fees with modern Managed Payments below.
      </p>

      <!-- Reciprocal Link to Main Pillar -->
      <div class="pt-1">
        <a
          href="/ebay-fee-calculator/"
          class="inline-flex items-center gap-1.5 min-h-[44px] text-primary hover:underline font-semibold text-ui-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary rounded-xxs"
        >
          <svg class="w-4 h-4" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          <span>Calculate your complete profit with store rates and promoted listings on the main eBay Fee Calculator</span>
        </a>
      </div>
    </header>

    <!-- 2. Calculator Island Above the Fold -->
    <section class="space-y-4" id="calculator">
      <CalculatorIsland platform="ebay-us" showPlatformTabs={false} />
    </section>

    <!-- 3. Formula in Plain Text -->
    <FormulaBlock platform="ebay-us" />

    <!-- 4. One Worked Example -->
    <WorkedExample
      platform="ebay-us"
      title="Worked Example: $50 Sale Under Managed Payments vs Legacy PayPal"
      description="Detailed comparison of modern eBay Managed Payments vs historical eBay + PayPal dual fees on a $50 item with $5 shipping:"
      itemPrice={50.0}
      itemCost={15.0}
      shippingCharged={5.0}
      shippingCost={4.5}
    />

    <!-- 5. Edge Cases -->
    <EdgeCases platform="ebay-us" />

    <!-- Side-by-Side: Myth vs Reality Table -->
    <section class="space-y-4 border-t border-hairline pt-8">
      <h2 class="text-heading-2 font-bold text-ink">Old Legacy System vs. How Payments Work Now</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Legacy Card -->
        <div class="rounded-lg border border-hairline bg-canvas p-5 space-y-3">
          <span class="text-caption font-bold text-muted uppercase tracking-wider block">Legacy Era (Pre-2021) — Outdated</span>
          <h3 class="text-heading-4 font-bold text-ink">Two Separate Invoices & Fees</h3>
          <ul class="space-y-2 text-body-sm text-body list-disc pl-5">
            <li><strong>eBay Fee:</strong> 10.0% billed monthly via an itemized invoice.</li>
            <li><strong>PayPal Fee:</strong> 2.9% + $0.30 deducted instantly at checkout.</li>
            <li><strong>Payouts:</strong> Deposited into your PayPal digital wallet.</li>
            <li><strong>Total Fees:</strong> ~12.9% + $0.30 across two separate companies.</li>
          </ul>
        </div>

        <!-- Modern Reality Card -->
        <div class="rounded-lg border-2 border-primary/40 bg-mint-50/50 dark:bg-mint-200/10 p-5 space-y-3">
          <span class="text-caption font-bold text-primary uppercase tracking-wider block">Current Reality (2026) — Active</span>
          <h3 class="text-heading-4 font-bold text-ink">One Consolidated Final Value Fee</h3>
          <ul class="space-y-2 text-body-sm text-body list-disc pl-5">
            <li><strong>eBay Fee:</strong> 13.25% + $0.30/$0.40 deducted automatically.</li>
            <li><strong>PayPal Fee:</strong> <strong class="text-primary font-bold">$0.00 (Zero)</strong>.</li>
            <li><strong>Payouts:</strong> Automated direct deposit straight into your checking account.</li>
            <li><strong>Buyer Options:</strong> Buyers can still use PayPal, Apple Pay, Google Pay, or credit cards.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. FAQ Section -->
    <FAQ
      items={faqs}
      title="Frequently Asked Questions About eBay & PayPal Fees"
      description="Common questions about managed payments, direct bank deposits, and legacy PayPal integrations."
    />

    <!-- 7. Related Calculators -->
    <RelatedCalculators currentPlatform="ebay-us" />

    <!-- Trust signals footer -->
    <AuthorByline platform="ebay-us" />
    <LastVerified platform="ebay-us" />
  </div>
</BaseLayout>
