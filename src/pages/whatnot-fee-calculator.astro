---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorIsland from '../components/CalculatorIsland.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TrustHeader from '../components/TrustHeader.astro';
import FormulaBlock from '../components/FormulaBlock.astro';
import WorkedExample from '../components/WorkedExample.astro';
import EdgeCases from '../components/EdgeCases.astro';
import AuthorByline from '../components/AuthorByline.astro';
import FAQ from '../components/FAQ.astro';
import RelatedCalculators from '../components/RelatedCalculators.astro';
import EmbedModal from '../components/EmbedModal.astro';
import LastVerified from '../components/LastVerified.astro';
import { getPageSeo } from '../lib/seo';
import { buildCalculatorStructuredData } from '../lib/schema';

const seo = getPageSeo('/whatnot-fee-calculator/');

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'All Calculators', href: '/marketplace-fee-calculators/' },
  { name: 'Whatnot Fee Calculator' },
];

// FAQ definitions
const faqs = [
  {
    question: 'Does Whatnot charge listing or monthly subscription fees?',
    answer:
      'No. Whatnot does not charge any listing fees, insertion fees, or monthly subscription fees. You only pay fees when an item successfully sells in a livestream or Buy-It-Now store.',
  },
  {
    question: 'Who pays for shipping on Whatnot?',
    answer:
      "By default, the buyer pays for shipping. Whatnot calculates shipping costs based on the item weight and generates a prepaid shipping label for the seller. Sellers only incur postage costs if they choose to offer free shipping or if the package exceeds the declared weight.",
  },
  {
    question: 'Does Whatnot charge payment processing fees on sales tax?',
    answer:
      "Whatnot's 8.0% commission is charged strictly on the item sold price, not on sales tax. However, the 2.9% + $0.30 payment processing fee applies to the entire transaction amount charged to the buyer's credit card, which includes applicable state sales tax and shipping.",
  },
  {
    question: 'What happens to fees if an order is cancelled or refunded?',
    answer:
      'If an order is cancelled before shipping or refunded by Whatnot support, Whatnot credits back the 8.0% commission. The payment processing fee is generally subject to merchant processor rules and may not be refunded on customer-initiated cancellations.',
  },
  {
    question: 'When do Whatnot sales payouts deposit into my bank account?',
    answer:
      'Funds become available in your Whatnot seller balance once USPS or the shipping carrier scans the tracking number as delivered. Top-tier, verified sellers may qualify for early payout upon the initial carrier acceptance scan. You can transfer funds to your bank via ACH (1-3 business days) or PayPal at any time.',
  },
];

// Structured Data: WebApplication, BreadcrumbList, and FAQPage schemas
const structuredData = buildCalculatorStructuredData({
  name: seo.h1,
  url: '/whatnot-fee-calculator/',
  description: seo.metaDescription,
  currency: 'USD',
  breadcrumbs,
  faqs,
});
---

<BaseLayout
  title={seo.title}
  description={seo.metaDescription}
  canonicalPath="/whatnot-fee-calculator/"
  structuredData={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header & 1-Paragraph Direct Answer -->
    <header class="space-y-4">
      <TrustHeader platform="whatnot" />

      <!-- 1. H1 -->
      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>

      <!-- 2. One-paragraph answer -->
      <p class="text-body-lg text-body leading-relaxed max-w-3xl">
        Whatnot charges an <strong class="text-ink">8.0% commission</strong> on the final hammer price of the sold item plus a <strong class="text-ink">2.9% + $0.30 payment processing fee</strong> on the buyer's full order total (including shipping and applicable sales tax). Whatnot charges zero listing fees, zero insertion fees, and no monthly subscription charges. Buyers pay for shipping by default through Whatnot prepaid labels. Enter your sold price and inventory costs below to calculate your exact net cash payout.
      </p>
    </header>

    <!-- 2. Calculator Above the Fold -->
    <section aria-label="Whatnot Fee Calculator Island">
      <CalculatorIsland platform="whatnot" showPlatformTabs={false} />
    </section>

    <!-- 3. Formula in Plain Text -->
    <FormulaBlock
      platform="whatnot"
      title="Whatnot Fee Formula"
      description="Whatnot breaks its fees into two distinct deductions on every completed sale:"
    />

    <!-- 4. One Worked Example -->
    <WorkedExample
      platform="whatnot"
      title="Worked Example: Selling a $50 Collectible"
      description="Here is a step-by-step breakdown of what you actually keep when selling an item for $50.00 on a Whatnot livestream:"
      itemPrice={50.0}
      itemCost={15.0}
    />

    <!-- 5. Edge Cases -->
    <EdgeCases platform="whatnot" />

    <!-- 6. FAQ Section -->
    <FAQ
      items={faqs}
      title="Frequently Asked Questions About Whatnot Fees"
      description="Clear answers to common questions about selling fees, payouts, shipping labels, and cancellations on Whatnot."
    />

    <!-- Dedicated Guide Callout -->
    <section class="rounded-lg border border-hairline bg-canvas p-6 space-y-3">
      <div class="flex items-center gap-2">
        <span class="text-micro font-bold uppercase tracking-wider text-forest bg-mint-50 dark:bg-mint-200/10 px-2 py-0.5 rounded-xs">
          Comprehensive Guide
        </span>
      </div>
      <h3 class="text-heading-3 font-bold text-ink">Want to Learn More About Whatnot Fee Mechanics?</h3>
      <p class="text-body-sm text-body leading-relaxed">
        Read our complete breakdown covering the 8% commission, smart shipping bundling, and Early Payout status in <a href="/guides/whatnot-fees-explained/" class="text-primary font-bold hover:underline">Whatnot Fees Explained: Live Auction Commission &amp; Payouts &rarr;</a>.
      </p>
    </section>

    <!-- Embed Widget Card -->
    <EmbedModal calculatorSlug="whatnot-fee-calculator" calculatorName="Whatnot Fee & Profit Calculator" />

    <!-- 7. Related Calculators Grid -->
    <RelatedCalculators currentPlatform="whatnot" />

    <!-- Trust signals footer -->
    <AuthorByline platform="whatnot" />
    <LastVerified platform="whatnot" />
  </div>
</BaseLayout>
