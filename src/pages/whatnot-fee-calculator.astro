---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorIsland from '../components/CalculatorIsland.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getEntry } from 'astro:content';
import { PLATFORM_CONFIGS } from '../lib/calc';

// Load Whatnot fee metadata from content collection
const whatnotEntry = await getEntry('fees', 'whatnot');
const feeData = whatnotEntry?.data;
const config = PLATFORM_CONFIGS.whatnot;

const verifiedOnIso = feeData?.verified_on ?? config.verifiedOn;
const sourceUrl = feeData?.source_url ?? config.sourceUrl;

function formatVerifiedDate(isoDate: string): string {
  try {
    const [year, month, day] = isoDate.split('-').map(Number);
    const date = new Date(Date.UTC(year, month - 1, day));
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    });
  } catch {
    return isoDate;
  }
}

const verifiedDateFormatted = formatVerifiedDate(verifiedOnIso);

// FAQ definitions
const faqs = [
  {
    question: 'Does Whatnot charge listing or monthly subscription fees?',
    answer:
      'No. Whatnot does not charge any listing fees, insertion fees, or monthly subscription fees. You only pay fees when an item successfully sells in a livestream or Buy-It-Now store.',
  },
  {
    question: 'Who pays for shipping on Whatnot?',
    answer:
      "By default, the buyer pays for shipping. Whatnot calculates shipping costs based on the item weight and generates a prepaid shipping label for the seller. Sellers only incur postage costs if they choose to offer free shipping or if the package exceeds the declared weight.",
  },
  {
    question: 'Does Whatnot charge payment processing fees on sales tax?',
    answer:
      "Whatnot's 8.0% commission is charged strictly on the item sold price, not on sales tax. However, the 2.9% + $0.30 payment processing fee applies to the entire transaction amount charged to the buyer's credit card, which includes applicable state sales tax and shipping.",
  },
  {
    question: 'What happens to fees if an order is cancelled or refunded?',
    answer:
      'If an order is cancelled before shipping or refunded by Whatnot support, Whatnot credits back the 8.0% commission. The payment processing fee is generally subject to merchant processor rules and may not be refunded on customer-initiated cancellations.',
  },
  {
    question: 'When do Whatnot sales payouts deposit into my bank account?',
    answer:
      'Funds become available in your Whatnot seller balance once USPS or the shipping carrier scans the tracking number as delivered. Top-tier, verified sellers may qualify for early payout upon the initial carrier acceptance scan. You can transfer funds to your bank via ACH (1-3 business days) or PayPal at any time.',
  },
];

// Structured Data: WebPage, SoftwareApplication, and FAQPage schemas
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Whatnot Fee & Profit Calculator',
    url: 'https://sellercalchub.com/whatnot-fee-calculator/',
    description:
      'Free, fast Whatnot fee and profit calculator. Calculate your exact 8% commission, 2.9% + $0.30 processing fees, profit margin, and break-even sale price.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Whatnot Seller Fee Calculator',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title="Whatnot Fee & Profit Calculator (Verified 2026 Rates)"
  description="Free Whatnot fee and profit calculator. Calculate your 8.0% commission, 2.9% + $0.30 processing fee, net payout, profit margin, and break-even price instantly."
  canonicalPath="/whatnot-fee-calculator/"
  structuredData={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Calculators', href: '/#calculators' },
        { name: 'Whatnot Fee Calculator' },
      ]}
    />

    <!-- Header & 1-Paragraph Direct Answer -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-xs bg-mint-50 dark:bg-mint-200/10 border border-mint-200 text-caption text-primary font-bold">
        <span>Verified Whatnot Rate: 8.0% + 2.9% + $0.30</span>
      </div>

      <!-- 1. H1 -->
      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        Whatnot Fee & Profit Calculator
      </h1>

      <!-- 2. One-paragraph answer -->
      <p class="text-body-lg text-body leading-relaxed max-w-3xl">
        Whatnot charges an <strong>8.0% commission</strong> on the final sold price of the item plus a <strong>2.9% + $0.30 payment processing fee</strong> on the buyer's full order total (including shipping and applicable sales tax). There are no listing fees, insertion fees, or monthly subscription charges to sell on Whatnot. Your net take-home payout is the sale price minus these two deductions and your own inventory and packaging costs.
      </p>
    </header>

    <!-- 3. Calculator Above the Fold -->
    <section aria-label="Whatnot Fee Calculator Island">
      <CalculatorIsland platform="whatnot" showPlatformTabs={false} />
    </section>

    <!-- 4. Formula in Plain Text -->
    <section class="space-y-6 pt-6 border-t border-hairline">
      <div class="space-y-2">
        <h2 class="text-heading-2 font-bold text-ink">Whatnot Fee Formula</h2>
        <p class="text-body-md text-muted max-w-2xl">
          Whatnot breaks its fees into two distinct deductions on every completed sale:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-5 rounded-lg bg-canvas-soft border border-hairline-strong space-y-2">
          <span class="text-ui-label font-bold text-primary uppercase tracking-wider block">
            1. Platform Commission
          </span>
          <p class="text-stat-value font-mono font-bold text-ink tabular-nums">
            Commission = Sold Price × 8.0%
          </p>
          <p class="text-caption text-muted">
            Charged solely on the item’s hammer price. Whatnot does not charge this 8% fee on shipping costs or sales tax.
          </p>
        </div>

        <div class="p-5 rounded-lg bg-canvas-soft border border-hairline-strong space-y-2">
          <span class="text-ui-label font-bold text-primary uppercase tracking-wider block">
            2. Payment Processing Fee
          </span>
          <p class="text-stat-value font-mono font-bold text-ink tabular-nums">
            Processing = (Total Buyer Paid × 2.9%) + $0.30
          </p>
          <p class="text-caption text-muted">
            Charged by the payment processor on the full transaction amount, including item price, buyer shipping, and tax.
          </p>
        </div>
      </div>

      <!-- Plain Text Formula Summary Box -->
      <div class="rounded-lg border border-hairline-strong bg-canvas p-6 space-y-3 font-mono text-ui-sm text-body">
        <div class="text-caption font-sans font-bold uppercase tracking-wider text-muted">Complete Net Profit Formula</div>
        <div class="p-3 bg-canvas-soft rounded-xs border border-hairline overflow-x-auto text-ink">
          <code>Total Whatnot Fees = (Sold Price × 0.08) + ((Sold Price + Shipping Charged + Tax) × 0.029) + $0.30</code>
        </div>
        <div class="p-3 bg-canvas-soft rounded-xs border border-hairline overflow-x-auto text-ink">
          <code>Net Profit = Sold Price − Total Whatnot Fees − Inventory Cost (COGS) − Seller Postage/Packaging</code>
        </div>
        <div class="p-3 bg-canvas-soft rounded-xs border border-hairline overflow-x-auto text-ink">
          <code>Profit Margin (%) = (Net Profit ÷ Sold Price) × 100</code>
        </div>
      </div>
    </section>

    <!-- 5. One Worked Example -->
    <section class="space-y-6 pt-6 border-t border-hairline">
      <div class="space-y-2">
        <h2 class="text-heading-2 font-bold text-ink">Worked Example: Selling a $50 Collectible</h2>
        <p class="text-body-md text-muted max-w-2xl">
          Here is a step-by-step breakdown of what you actually keep when selling an item for $50.00 on a Whatnot livestream.
        </p>
      </div>

      <div class="rounded-lg border border-hairline-strong bg-canvas overflow-hidden shadow-level-3">
        <div class="p-4 bg-canvas-soft border-b border-hairline flex flex-wrap justify-between items-center gap-2">
          <span class="font-bold text-ink">Transaction Assumptions</span>
          <span class="text-caption text-muted">Item Sale Price: $50.00 · Inventory Cost: $15.00 · Buyer Pays Shipping</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-ui-sm text-left">
            <caption class="sr-only">Step-by-step calculation breakdown for a $50 Whatnot sale</caption>
            <thead class="bg-canvas-soft/50 text-caption text-muted uppercase font-bold border-b border-hairline">
              <tr>
                <th scope="col" class="py-3 px-4">Step</th>
                <th scope="col" class="py-3 px-4">Fee / Deduction</th>
                <th scope="col" class="py-3 px-4">Math Calculation</th>
                <th scope="col" class="py-3 px-4 text-right">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr>
                <td class="py-3 px-4 font-bold text-muted">1</td>
                <th scope="row" class="py-3 px-4 font-medium text-ink">Whatnot 8% Commission</th>
                <td class="py-3 px-4 text-muted font-mono">$50.00 × 8.0%</td>
                <td class="py-3 px-4 text-right font-bold text-ink tabular-nums">-$4.00</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-bold text-muted">2</td>
                <th scope="row" class="py-3 px-4 font-medium text-ink">Payment Processing (2.9% + $0.30)</th>
                <td class="py-3 px-4 text-muted font-mono">($50.00 × 2.9%) + $0.30</td>
                <td class="py-3 px-4 text-right font-bold text-ink tabular-nums">-$1.75</td>
              </tr>
              <tr class="bg-mint-50/50 dark:bg-mint-200/5 font-semibold">
                <td class="py-3 px-4 text-primary font-bold">Total</td>
                <th scope="row" class="py-3 px-4 text-primary">Total Whatnot Deductions</th>
                <td class="py-3 px-4 text-muted font-mono">$4.00 + $1.75 (11.5% effective)</td>
                <td class="py-3 px-4 text-right text-primary font-bold tabular-nums">-$5.75</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-bold text-muted">3</td>
                <th scope="row" class="py-3 px-4 font-medium text-ink">Whatnot Payout Deposited</th>
                <td class="py-3 px-4 text-muted font-mono">$50.00 − $5.75</td>
                <td class="py-3 px-4 text-right font-bold text-ink tabular-nums">$44.25</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-bold text-muted">4</td>
                <th scope="row" class="py-3 px-4 font-medium text-ink">Inventory Cost (COGS)</th>
                <td class="py-3 px-4 text-muted font-mono">Original wholesale purchase</td>
                <td class="py-3 px-4 text-right font-bold text-ink tabular-nums">-$15.00</td>
              </tr>
            </tbody>
            <tfoot class="bg-canvas-soft border-t-2 border-hairline-strong font-bold text-ui-label">
              <tr>
                <td colspan="3" class="py-3 px-4 text-ink">Your Net Take-Home Profit</td>
                <td class="py-3 px-4 text-right text-primary text-stat-value tabular-nums">+$29.25</td>
              </tr>
              <tr>
                <td colspan="3" class="py-2 px-4 text-caption text-muted font-normal">Profit Margin / ROI / Break-Even</td>
                <td class="py-2 px-4 text-right text-caption text-muted tabular-nums">58.5% Margin · 195.0% ROI · $17.18 Break-Even</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </section>

    <!-- 6. FAQ Section -->
    <section class="space-y-6 pt-6 border-t border-hairline">
      <div class="space-y-2">
        <h2 class="text-heading-2 font-bold text-ink">Frequently Asked Questions About Whatnot Fees</h2>
        <p class="text-body-md text-muted max-w-2xl">
          Clear answers to common questions about selling fees, payouts, shipping labels, and cancellations on Whatnot.
        </p>
      </div>

      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-lg border border-hairline-strong bg-canvas p-4 transition-colors hover:border-primary">
            <summary class="flex items-center justify-between font-bold text-ink text-ui-label cursor-pointer list-none select-none">
              <span>{faq.question}</span>
              <svg
                class="w-4 h-4 text-muted group-open:rotate-180 transition-transform duration-150 shrink-0 ml-2"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="mt-3 text-body text-body-sm leading-relaxed border-t border-hairline pt-3">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- 7. Related Calculators Grid -->
    <section class="space-y-6 pt-6 border-t border-hairline">
      <div class="space-y-2">
        <h2 class="text-heading-2 font-bold text-ink">Compare Other Marketplace Fees</h2>
        <p class="text-body-md text-muted max-w-2xl">
          Cross-list your inventory? Compare your net margins against other major reseller platforms.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          {
            name: 'TikTok Shop Fee Calculator',
            rate: '6.0% + $0.30',
            desc: 'Calculate referral fees, affiliate creator commissions, and live-selling margins.',
            href: '/tiktok-shop-fee-calculator/',
          },
          {
            name: 'Depop Fee Calculator',
            rate: '0% selling (US) + 3.3% + $0.45',
            desc: 'Calculate marketplace processing fees for vintage apparel and second-hand fashion.',
            href: '/depop-fee-calculator/',
          },
          {
            name: 'Etsy Fee Calculator',
            rate: '6.5% + $0.20 listing + 3% + $0.25',
            desc: 'Calculate transaction fees, 4-month listing fees, and offsite ads deductions.',
            href: '/etsy-fee-calculator/',
          },
          {
            name: 'eBay Fee Calculator',
            rate: '13.25% + $0.40',
            desc: 'Calculate final value fees, store subscription discounts, and promoted listing rates.',
            href: '/ebay-fee-calculator/',
          },
          {
            name: 'eBay UK Fee Calculator',
            rate: '0% private / 12.8% business',
            desc: 'Calculate fees under the new 0% UK private seller fee structure.',
            href: '/ebay-uk-fee-calculator/',
          },
          {
            name: 'Twitch Bits Converter',
            rate: '$0.01 per Bit payout',
            desc: 'Calculate streamer take-home earnings from Bits cheers and Twitch bundle pricing.',
            href: '/twitch-bits-to-usd/',
          },
        ].map((item) => (
          <a
            href={item.href}
            class="block rounded-lg border border-hairline-strong bg-canvas p-5 hover:border-primary hover:bg-mint-50/40 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary shadow-sm"
          >
            <span class="text-caption font-bold text-primary block mb-1">{item.rate}</span>
            <span class="text-heading-4 font-bold text-ink block mb-2">{item.name}</span>
            <span class="text-caption text-muted block">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 8. Last-Verified Stamp -->
    <footer class="pt-6 border-t border-hairline">
      <div class="rounded-lg border border-mint-200 bg-mint-50 dark:bg-mint-200/10 p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-primary shrink-0" aria-hidden="true"></span>
            <span class="text-ui-label font-bold text-ink">
              Official Rate Verification
            </span>
          </div>
          <p class="text-caption text-muted">
            Whatnot fee rates officially verified on <strong class="text-ink">{verifiedDateFormatted}</strong>. Sourced directly from Whatnot’s published fee documentation.
          </p>
        </div>

        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-canvas border border-hairline-strong hover:border-primary rounded-xs text-ui-sm font-bold text-primary transition-colors shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          <span>Official Fee Schedule</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h4a.75.75 0 010 1.5h-4z" clip-rule="evenodd" />
            <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 001.06 1.06l7.5-7.5V9a.75.75 0 001.5 0V4.5a.75.75 0 00-.75-.75H11a.75.75 0 000 1.5h2.693l-7.499 7.503z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>
