---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EmailAction from '../components/EmailAction.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: '500 Server Error' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Internal Server Error (500) - Seller Calc Hub',
    url: 'https://sellercalchub.com/500/',
    description: 'An unexpected system error occurred. Explore our verified marketplace fee and profit calculators.',
  },
  buildBreadcrumbSchema(breadcrumbs, '/500/'),
];

const popularCalculators = [
  {
    name: 'eBay Fee Calculator (US)',
    href: '/ebay-fee-calculator/',
    rate: '13.25% + $0.40',
    desc: 'Calculate final value fees, store subscriber rates, and promoted listings deductions.',
  },
  {
    name: 'eBay Fee Calculator (UK)',
    href: '/ebay-fee-calculator-uk/',
    rate: '0% Private / 12.8% Business',
    desc: 'Verify 0% private seller fee savings versus standard business seller rates.',
  },
  {
    name: 'Whatnot Fee Calculator',
    href: '/whatnot-fee-calculator/',
    rate: '8.0% + 2.9% + $0.30',
    desc: 'Accurately estimate livestream auction earnings and buyer-paid shipping fee deductions.',
  },
  {
    name: 'TikTok Shop Fee Calculator',
    href: '/tiktok-shop-fee-calculator/',
    rate: '6.0% Referral Fee',
    desc: 'Calculate social commerce take-home payouts and creator affiliate commissions.',
  },
  {
    name: 'Depop Fee Calculator',
    href: '/depop-fee-calculator/',
    rate: '0% Selling Fee',
    desc: 'Project profits under Depop’s 0% commission structure for US and UK sellers.',
  },
  {
    name: 'Etsy Fee Calculator',
    href: '/etsy-fee-calculator/',
    rate: '6.5% + $0.20 + 3%',
    desc: 'Account for listing renewals, transaction fees, and mandatory Offsite Ads.',
  },
  {
    name: 'Twitch Bits to USD Converter',
    href: '/twitch-bits-to-usd/',
    rate: '$0.01 / Bit Payout',
    desc: 'Convert cheered Twitch Bits directly into exact streamer cash payouts.',
  },
  {
    name: 'Marketplace Comparison Hub',
    href: '/marketplace-fee-calculators/',
    rate: 'Cross-Platform',
    desc: 'Compare take-home profit and effective commission rates side-by-side across all platforms.',
  },
];
---

<BaseLayout
  title="Internal Server Error (500) - Seller Calc Hub"
  description="An unexpected system or network error occurred. Seller Calc Hub calculators run client-side. Reload the page or explore verified fee calculators."
  canonicalPath="/500/"
  noindex={true}
  structuredData={structuredData}
>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-16 space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- 500 Hero Section -->
    <header class="space-y-5 text-center md:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/40 text-caption font-bold text-rose-700 dark:text-rose-400">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>HTTP 500 · Internal Server Error</span>
      </div>

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        Temporary System Interruption
      </h1>

      <p class="text-body-lg text-body max-w-2xl leading-relaxed">
        We apologize for the inconvenience. Seller Calc Hub is built using high-performance Static Site Generation (SSG) with client-side calculations—meaning our calculators run entirely in your web browser without communicating with a centralized database. This error is typically caused by a transient network timeout, edge CDN glitch, or stale browser cache.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2 justify-center md:justify-start">
        <button
          type="button"
          id="reload-page-btn"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 min-h-[44px] rounded-xs bg-forest hover:bg-primary-deep text-white font-bold text-ui-label transition-colors shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Reload This Page</span>
        </button>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 min-h-[44px] rounded-xs border border-hairline-strong bg-canvas text-ink font-bold text-ui-label hover:border-primary hover:bg-mint-50/40 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          <span>Return to Homepage</span>
        </a>
        <a
          href="/marketplace-fee-calculators/"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 min-h-[44px] rounded-xs border border-hairline-strong bg-canvas text-ink font-bold text-ui-label hover:border-primary hover:bg-mint-50/40 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          <span>All Calculators</span>
        </a>
      </div>
    </header>

    <!-- Quick Troubleshooting Steps -->
    <section class="space-y-4 border-t border-hairline pt-8">
      <h2 class="text-heading-2 font-bold text-ink">Troubleshooting &amp; Recovery</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-5 rounded-lg border border-hairline bg-canvas space-y-2">
          <div class="text-caption font-mono font-bold text-primary uppercase">Step 1</div>
          <h3 class="text-heading-4 font-bold text-ink">Hard Refresh</h3>
          <p class="text-caption text-body leading-relaxed">
            Press <kbd class="px-1.5 py-0.5 rounded-xxs border border-hairline bg-canvas-soft text-micro font-mono text-ink">Ctrl + F5</kbd> or <kbd class="px-1.5 py-0.5 rounded-xxs border border-hairline bg-canvas-soft text-micro font-mono text-ink">Cmd + Shift + R</kbd> to reload the latest pre-rendered static assets.
          </p>
        </div>

        <div class="p-5 rounded-lg border border-hairline bg-canvas space-y-2">
          <div class="text-caption font-mono font-bold text-primary uppercase">Step 2</div>
          <h3 class="text-heading-4 font-bold text-ink">Zero Data Loss</h3>
          <p class="text-caption text-body leading-relaxed">
            Your calculation parameters are not tied to an account or remote database. Once reloaded, your calculator will be fresh and responsive.
          </p>
        </div>

        <div class="p-5 rounded-lg border border-hairline bg-canvas space-y-2">
          <div class="text-caption font-mono font-bold text-primary uppercase">Step 3</div>
          <h3 class="text-heading-4 font-bold text-ink">Platform Status</h3>
          <p class="text-caption text-body leading-relaxed">
            Check our <a href="/fee-changes/" class="text-primary hover:underline font-semibold">Changelog &amp; Deployments</a> or alert our engineering team if issues persist.
          </p>
        </div>
      </div>
    </section>

    <!-- Popular Calculators Directory -->
    <section class="space-y-6 border-t border-hairline pt-10">
      <div class="space-y-1">
        <h2 class="text-heading-2 font-bold text-ink">Verified Reseller Fee Calculators</h2>
        <p class="text-body-md text-muted">
          Access our most frequently used verified calculators:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          popularCalculators.map((calc) => (
            <a
              href={calc.href}
              class="block rounded-lg border border-hairline-strong bg-canvas p-5 hover:border-primary hover:bg-mint-50/40 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary shadow-xs group flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-caption font-bold text-primary block">{calc.rate}</span>
                </div>
                <span class="text-heading-4 font-bold text-ink group-hover:text-primary transition-colors block mb-1.5">
                  {calc.name}
                </span>
                <span class="text-caption text-body block leading-relaxed">{calc.desc}</span>
              </div>
              <span class="text-caption font-bold text-primary inline-flex items-center gap-1 mt-3 group-hover:translate-x-0.5 transition-transform">
                <span>Calculate Fees</span>
                <span aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Support Desk Callout -->
    <section class="rounded-lg border border-hairline bg-canvas-soft p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="space-y-1">
        <h3 class="text-body-md font-bold text-ink">Experiencing persistent issues or repeated errors?</h3>
        <p class="text-caption text-muted">
          Our engineering desk investigates server and CDN edge delivery incidents immediately.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <EmailAction
          email="info@sellercalchub.com"
          subject="HTTP 500 Error Report"
          label="Email Engineering Desk"
          variant="secondary"
          class="sm:w-auto"
        />
        <a
          href="/contact/"
          class="shrink-0 inline-flex items-center justify-center gap-1.5 px-4 py-2 min-h-[44px] rounded-xs bg-forest hover:bg-primary-deep text-white font-bold text-caption transition-colors"
        >
          <span>Contact Page</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function setupReloadButton() {
    const btn = document.getElementById('reload-page-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        window.location.reload();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupReloadButton);
  } else {
    setupReloadButton();
  }
</script>
