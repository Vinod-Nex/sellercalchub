---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorIsland from '../components/CalculatorIsland.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TrustHeader from '../components/TrustHeader.astro';
import FormulaBlock from '../components/FormulaBlock.astro';
import WorkedExample from '../components/WorkedExample.astro';
import EdgeCases from '../components/EdgeCases.astro';
import AuthorByline from '../components/AuthorByline.astro';
import FAQ from '../components/FAQ.astro';
import RelatedCalculators from '../components/RelatedCalculators.astro';
import EmbedModal from '../components/EmbedModal.astro';
import LastVerified from '../components/LastVerified.astro';
import { getPageSeo } from '../lib/seo';
import { buildCalculatorStructuredData } from '../lib/schema';

const seo = getPageSeo('/tiktok-shop-fee-calculator/');

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'All Calculators', href: '/marketplace-fee-calculators/' },
  { name: 'TikTok Shop Fee Calculator' },
];

// FAQ definitions
const faqs = [
  {
    question: 'What are the seller fees on TikTok Shop US in 2026?',
    answer:
      'TikTok Shop charges a standard referral fee of 6.0% per order total (including item price and shipping charged). Standard payment processing is included directly in this referral fee with no separate gateway fee on domestic transactions.',
  },
  {
    question: 'How do TikTok Shop affiliate commissions work?',
    answer:
      'If you sell products through the TikTok Shop Affiliate Creator program, you configure a commission percentage (typically 5% to 20%) paid directly to the creator who tagged your product in their viral video or livestream.',
  },
  {
    question: 'Does TikTok Shop charge a monthly subscription fee?',
    answer:
      'No. There is zero monthly subscription cost to operate a TikTok Shop storefront. You only incur fees when orders are placed.',
  },
  {
    question: 'Who covers shipping labels on TikTok Shop?',
    answer:
      'Sellers can choose between Shipping by TikTok (where TikTok provides subsidized shipping labels) or Shipping by Seller. Buyer shipping fees are deposited to the seller if the seller fulfills postage independently.',
  },
];

// Structured Data
const structuredData = buildCalculatorStructuredData({
  name: seo.h1,
  url: '/tiktok-shop-fee-calculator/',
  description: seo.metaDescription,
  currency: 'USD',
  breadcrumbs,
  faqs,
});
---

<BaseLayout
  title={seo.title}
  description={seo.metaDescription}
  canonicalPath="/tiktok-shop-fee-calculator/"
  structuredData={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header & Direct Answer in First Paragraph -->
    <header class="space-y-4">
      <TrustHeader platform="tiktok-shop" />

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>

      <p class="text-body-lg text-body leading-relaxed max-w-3xl">
        TikTok Shop US charges sellers a flat <strong class="text-ink">6.0% referral fee</strong> on the total customer payment (item price plus buyer-paid shipping and applicable sales tax). Payment processing is included directly in the 6.0% referral fee, with zero listing fees, zero monthly subscription charges, and no hidden gateway fees on standard domestic transactions. Enter your product price and costs below to calculate your exact payout and net margin.
      </p>
    </header>

    <!-- 2. Calculator Island Above the Fold -->
    <section aria-label="TikTok Shop Fee Calculator Island">
      <CalculatorIsland platform="tiktok-shop" showPlatformTabs={false} />
    </section>

    <!-- 3. Formula Block -->
    <FormulaBlock platform="tiktok-shop" />

    <!-- 4. One Worked Example -->
    <WorkedExample
      platform="tiktok-shop"
      title="Worked Example: Selling a $50 Item on TikTok Shop"
      description="Here is how TikTok Shop calculates platform deductions on a typical $50.00 sale with $15.00 sourcing and $5.00 postage:"
      itemPrice={50.0}
      itemCost={15.0}
      shippingCharged={0.0}
      shippingCost={5.0}
    />

    <!-- 5. Edge Cases -->
    <EdgeCases platform="tiktok-shop" />

    <!-- 6. FAQ Accordion -->
    <FAQ
      items={faqs}
      title="Frequently Asked Questions About TikTok Shop Fees"
      description="Common questions about referral deductions, creator affiliate commissions, and payout schedules."
    />

    <!-- Embed Widget Card -->
    <EmbedModal calculatorSlug="tiktok-shop-fee-calculator" calculatorName="TikTok Shop Fee & Profit Calculator" />

    <!-- 7. Related Calculators -->
    <RelatedCalculators currentPlatform="tiktok-shop" />

    <!-- Trust signals footer -->
    <AuthorByline platform="tiktok-shop" />
    <LastVerified platform="tiktok-shop" />
  </div>
</BaseLayout>
