<script>
  class TwitchBitsConverter extends HTMLElement {
    private bitsInput: HTMLInputElement | null = null;
    private usdInput: HTMLInputElement | null = null;
    private outStreamerUsd: HTMLElement | null = null;
    private outViewerWeb: HTMLElement | null = null;
    private outTwitchCut: HTMLElement | null = null;

    connectedCallback() {
      if (this.dataset.initialized === "true") return;
      this.dataset.initialized = "true";

      this.bitsInput = this.querySelector<HTMLInputElement>("#bits-input");
      this.usdInput = this.querySelector<HTMLInputElement>("#usd-input");
      this.outStreamerUsd = this.querySelector<HTMLElement>(
        "[data-out-streamer-usd]",
      );
      this.outViewerWeb = this.querySelector<HTMLElement>(
        "[data-out-viewer-web]",
      );
      this.outTwitchCut = this.querySelector<HTMLElement>(
        "[data-out-twitch-cut]",
      );

      // Input listeners
      this.bitsInput?.addEventListener("input", () => this.handleBitsInput());
      this.usdInput?.addEventListener("input", () => this.handleUsdInput());

      // Quick preset buttons
      const presetButtons =
        this.querySelectorAll<HTMLButtonElement>("[data-preset-bits]");
      presetButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const bits = parseInt(btn.dataset.presetBits || "0", 10);
          if (bits > 0 && this.bitsInput) {
            this.bitsInput.value = bits.toLocaleString();
            this.updateFromBits(bits);
          }
        });
      });
    }

    private parseNumber(val: string): number {
      const clean = val.replace(/[^0-9.]/g, "");
      const parsed = parseFloat(clean);
      return isNaN(parsed) ? 0 : parsed;
    }

    private handleBitsInput() {
      if (!this.bitsInput) return;
      const bits = Math.floor(this.parseNumber(this.bitsInput.value));
      this.updateFromBits(bits);
    }

    private handleUsdInput() {
      if (!this.usdInput) return;
      const dollars = this.parseNumber(this.usdInput.value);
      const bits = Math.round(dollars * 100);
      if (this.bitsInput) {
        this.bitsInput.value = bits.toLocaleString();
      }
      this.updateCalculations(bits, dollars);
    }

    private updateFromBits(bits: number) {
      const dollars = bits / 100;
      if (this.usdInput) {
        this.usdInput.value = dollars.toFixed(2);
      }
      this.updateCalculations(bits, dollars);
    }

    private updateCalculations(bits: number, dollars: number) {
      // 100 bits costs approx $1.40 on web (with volume discounts on larger tiers)
      let viewerCost = 0;
      if (bits >= 25000) {
        viewerCost = bits * 0.01232; // ~12% discount
      } else if (bits >= 10000) {
        viewerCost = bits * 0.0126; // 10% discount
      } else if (bits >= 5000) {
        viewerCost = bits * 0.01288; // 8% discount
      } else if (bits >= 1500) {
        viewerCost = bits * 0.0133; // 5% discount
      } else {
        viewerCost = bits * 0.014; // $1.40 per 100 bits
      }

      const twitchCut = Math.max(0, viewerCost - dollars);

      if (this.outStreamerUsd) {
        this.outStreamerUsd.textContent = `$${dollars.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }
      if (this.outViewerWeb) {
        this.outViewerWeb.textContent = `$${viewerCost.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }
      if (this.outTwitchCut) {
        this.outTwitchCut.textContent = `$${twitchCut.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }
    }
  }

  if (!customElements.get("twitch-bits-converter")) {
    customElements.define("twitch-bits-converter", TwitchBitsConverter);
  }
</script>
