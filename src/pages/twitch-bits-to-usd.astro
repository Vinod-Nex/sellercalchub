          <!-- Converter Live Result Banner -->
          <div class="rounded-lg bg-mint-50 dark:bg-mint-200/10 border border-mint-200 p-5 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center sm:text-left">
            <div>
              <span class="block text-caption font-bold uppercase tracking-wider text-primary">
                Streamer Payout
              </span>
              <span
                class="text-display-lg font-bold text-ink font-mono tabular-nums"
                data-out-streamer-usd
              >
                $10.00
              </span>
              <span class="block text-micro text-muted">
                100% of $0.01 per bit rate
              </span>
            </div>

            <div>
              <span class="block text-caption font-bold uppercase tracking-wider text-muted">
                Viewer Paid (Desktop Web)
              </span>
              <span
                class="text-heading-2 font-bold text-ink font-mono tabular-nums"
                data-out-viewer-web
              >
                $14.00
              </span>
              <span class="block text-micro text-muted">
                Estimated at standard bundle rate
              </span>
            </div>

            <div>
              <span class="block text-caption font-bold uppercase tracking-wider text-muted">
                Twitch Platform Cut
              </span>
              <span
                class="text-heading-2 font-bold text-muted font-mono tabular-nums"
                data-out-twitch-cut
              >
                $4.00
              </span>
              <span class="block text-micro text-muted">
                Collected upfront from buyer
              </span>
            </div>
          </div>
        </twitch-bits-converter>
      </div>
    </section>

    <!-- 4. Common Amounts Table (Streamer Payout vs Viewer Cost by Bundle) -->
    <section class="space-y-6 pt-6 border-t border-hairline">
      <div class="space-y-2">
        <h2 class="text-heading-2 font-bold text-ink">
          Twitch Bits to USD Conversion Table
        </h2>
        <p class="text-body-md text-muted max-w-2xl">
          Full breakdown of what the streamer receives versus what the viewer
          pays across official Twitch desktop and mobile purchase bundles.
        </p>
      </div>

      <div class="rounded-lg border border-hairline-strong bg-canvas overflow-hidden shadow-level-3">
        <div
          class="overflow-x-auto focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary"
          tabindex="0"
          role="region"
          aria-label="Twitch Bits conversion table"
        >
          <table class="w-full text-ui-sm text-left">
            <caption class="sr-only">
              Table of Twitch Bits conversions showing streamer earnings and
              viewer bundle costs
            </caption>
            <thead class="bg-canvas-soft text-caption text-muted uppercase font-bold border-b border-hairline">
              <tr>
                <th scope="col" class="py-3.5 px-4">
                  Bits Cheered
                </th>
                <th scope="col" class="py-3.5 px-4 text-right">
                  Streamer Receives
