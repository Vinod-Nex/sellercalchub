---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustHeader from "../components/TrustHeader.astro";
import FormulaBlock from "../components/FormulaBlock.astro";
import WorkedExample from "../components/WorkedExample.astro";
import EdgeCases from "../components/EdgeCases.astro";
import FAQ from "../components/FAQ.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import LastVerified from "../components/LastVerified.astro";
import AuthorByline from "../components/AuthorByline.astro";
import { getPageSeo } from "../lib/seo";
import { buildCalculatorStructuredData } from "../lib/schema";

const seo = getPageSeo("/twitch-bits-to-usd/");

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "All Calculators", href: "/marketplace-fee-calculators/" },
  { name: "Twitch Bits to USD" },
];

// Standard Twitch Bits Bundle Table Data
const commonAmounts = [
  {
    bits: 100,
    streamerUsd: 1.0,
    viewerWebUsd: 1.4,
    viewerMobileUsd: 1.99,
    twitchCutUsd: 0.4,
    creatorSharePct: 71.4,
    discountBadge: null,
  },
  {
    bits: 500,
    streamerUsd: 5.0,
    viewerWebUsd: 7.0,
    viewerMobileUsd: 9.99,
    twitchCutUsd: 2.0,
    creatorSharePct: 71.4,
    discountBadge: null,
  },
  {
    bits: 1000,
    streamerUsd: 10.0,
    viewerWebUsd: 14.0, // Or $12.60 with first-time/promotional 5% discount
    viewerMobileUsd: 19.99,
    twitchCutUsd: 4.0,
    creatorSharePct: 71.4,
    discountBadge: "5% Web Discount available ($12.60)",
  },
  {
    bits: 1500,
    streamerUsd: 15.0,
    viewerWebUsd: 19.95,
    viewerMobileUsd: 28.99,
    twitchCutUsd: 4.95,
    creatorSharePct: 75.2,
    discountBadge: "5% Discount",
  },
  {
    bits: 5000,
    streamerUsd: 50.0,
    viewerWebUsd: 64.4,
    viewerMobileUsd: 89.99,
    twitchCutUsd: 14.4,
    creatorSharePct: 77.6,
    discountBadge: "8% Discount",
  },
  {
    bits: 10000,
    streamerUsd: 100.0,
    viewerWebUsd: 126.0,
    viewerMobileUsd: 174.99,
    twitchCutUsd: 26.0,
    creatorSharePct: 79.4,
    discountBadge: "10% Discount",
  },
  {
    bits: 25000,
    streamerUsd: 250.0,
    viewerWebUsd: 308.0,
    viewerMobileUsd: 429.99,
    twitchCutUsd: 58.0,
    creatorSharePct: 81.2,
    discountBadge: "12% Discount",
  },
];

// FAQs for Twitch Bits
const faqs = [
  {
    question: "How much is 1 Twitch Bit worth in USD?",
    answer:
      "Each Bit is worth exactly $0.01 USD (1 cent) to the streamer. If a viewer cheers 100 Bits, the streamer receives $1.00 USD. If a viewer cheers 1,000 Bits, the streamer receives $10.00 USD.",
  },
  {
    question: "Why do viewers pay more than $0.01 per Bit when buying bundles?",
    answer:
      "Twitch takes its platform revenue share upfront when viewers purchase Bits, rather than deducting fees from the streamer’s payout. For example, 100 Bits cost a viewer $1.40 USD on desktop web. Twitch keeps $0.40 (approx. 28.6% of the purchase), and passes the full $1.00 (71.4%) to the streamer upon cheering.",
  },
  {
    question:
      "Why are Twitch Bits more expensive on iPhone and Android mobile apps?",
    answer:
      "Apple’s App Store and Google Play charge a 30% platform fee on all in-app digital purchases. To offset this, Twitch charges higher prices on mobile (e.g. $1.99 USD for 100 Bits on iOS vs $1.40 USD on web). Regardless of where the viewer buys Bits, the streamer still receives exactly $0.01 USD per Bit.",
  },
  {
    question: "What is the minimum payout threshold for Twitch Bits?",
    answer:
      "Twitch has a $50.00 USD minimum payout threshold for Affiliates and Partners (lowered from $100 in 2022) for ACH direct deposit, PayPal, and check. Wire transfers still require a $100.00 USD threshold. That means you need at least 5,000 Bits (or a combination of Bits, subscriptions, and ad revenue totaling $50) to receive a payout.",
  },
  {
    question:
      "Does Twitch take any fees when transferring Bits money to my bank account?",
    answer:
      "Twitch does not take a cut from cheered Bits, but third-party payout processors may charge standard transaction fees. ACH direct deposit is free for US streamers. PayPal costs $0.75 USD (or 2% outside the US), and wire transfers cost $25.00 USD.",
  },
];

// Schema.org Structured Data
const structuredData = buildCalculatorStructuredData({
  name: seo.h1,
  url: "/twitch-bits-to-usd/",
  description: seo.metaDescription,
  currency: "USD",
  applicationCategory: "UtilityApplication",
  breadcrumbs,
  faqs,
});
---

<BaseLayout
  title={seo.title}
  description={seo.metaDescription}
  canonicalPath="/twitch-bits-to-usd/"
  structuredData={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header & Direct Answer in the First Paragraph -->
    <header class="space-y-4">
      <TrustHeader platform="twitch-bits" />

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>

      <p class="text-body-lg text-body leading-relaxed max-w-3xl">
        Twitch pays creators exactly <strong class="text-ink">$0.01 USD (1 cent) per Bit cheered</strong> on eligible Twitch Affiliate and Partner channels. There are zero platform fee deductions taken from the creator's 1 cent per bit payout; Twitch collects its revenue upfront from viewers, who pay $1.40 for 100 bits on web (a ~40% markup). Enter any bit amount below to calculate your exact cash payout and progress toward Twitch's $50 payout threshold.
      </p>
    </header>

    <!-- 3. Interactive Converter Island (Above the Fold) -->
    <section aria-label="Interactive Bits to USD Converter">
      <div class="rounded-lg border border-hairline-strong bg-canvas p-6 md:p-8 shadow-level-3 space-y-6">
        <div class="border-b border-hairline pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h2 class="text-heading-3 font-bold text-ink">
              Instant Bits ⇄ USD Converter
            </h2>
            <p class="text-caption text-muted">
              Enter Bits amount or desired dollar value to convert in real time.
            </p>
          </div>
          <span class="text-micro font-bold uppercase tracking-wider text-primary bg-mint-50 px-2 py-1 rounded-xxs border border-mint-200 shrink-0">
            1 Bit = $0.01 USD
          </span>
        </div>

        <twitch-bits-converter class="block space-y-6" data-initialized="false">
          <!-- Converter Inputs Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-start">
            <!-- Left: Bits Input -->
            <div class="space-y-2">
              <label
                for="bits-input"
                class="block text-ui-label font-bold text-ink"
              >
                Bits Amount (Cheered)
              </label>
              <div class="relative flex items-center">
                <span class="absolute left-3 text-muted font-bold pointer-events-none select-none text-ui-sm">
                  ✦
                </span>
                <input
                  type="text"
                  id="bits-input"
                  name="bits"
                  value="1,000"
                  inputmode="numeric"
                  autocomplete="off"
                  class="w-full pl-8 pr-4 py-3 rounded-xs border border-hairline-strong bg-canvas text-ink text-heading-3 font-mono font-bold focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-colors tabular-nums"
                  aria-label="Bits Amount"
                />
              </div>
              <p class="text-caption text-muted">
                Common: 100, 500, 1,000, 5,000, 10,000
              </p>
            </div>

            <!-- Right: USD Payout Output / Input -->
            <div class="space-y-2">
              <label
                for="usd-input"
                class="block text-ui-label font-bold text-ink"
              >
                Streamer Receives (USD)
              </label>
              <div class="relative flex items-center">
                <span class="absolute left-3 text-muted font-bold pointer-events-none select-none text-ui-sm">
                  $
                </span>
                <input
                  type="text"
                  id="usd-input"
                  name="usd"
                  value="10.00"
                  inputmode="decimal"
                  autocomplete="off"
                  class="w-full pl-8 pr-4 py-3 rounded-xs border border-hairline-strong bg-canvas text-ink text-heading-3 font-mono font-bold focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-colors tabular-nums"
                  aria-label="Streamer USD Payout"
                />
              </div>
              <p class="text-caption text-muted">
                What lands in your creator payout balance
              </p>
            </div>
          </div>

          <!-- Quick Preset Buttons -->
          <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-hairline">
            <span class="text-caption font-bold text-muted uppercase tracking-wider mr-2">
              Quick Presets:
            </span>
            {[100, 500, 1000, 2500, 5000, 10000, 25000].map((amount) => (
              <button
                type="button"
                data-preset-bits={amount}
                class="px-3 py-2 min-h-[44px] inline-flex items-center justify-center rounded-xs bg-canvas-soft border border-hairline hover:border-primary hover:text-ink text-body text-ui-sm font-semibold transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary tabular-nums"
              >
                ✦ {amount.toLocaleString()}
              </button>
            ))}
          </div>

          <!-- Converter Live Result Banner -->
          <div class="rounded-lg bg-mint-50 dark:bg-mint-200/10 border border-mint-200 p-5 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center sm:text-left">
            <div>
              <span class="block text-caption font-bold uppercase tracking-wider text-primary">
                Streamer Payout
              </span>
              <span
                class="text-display-lg font-bold text-ink font-mono tabular-nums"
                data-out-streamer-usd
              >
                $10.00
              </span>
              <span class="block text-micro text-muted">
                100% of $0.01 per bit rate
              </span>
            </div>

            <div>
              <span class="block text-caption font-bold uppercase tracking-wider text-muted">
                Viewer Paid (Desktop Web)
              </span>
              <span
                class="text-heading-2 font-bold text-ink font-mono tabular-nums"
                data-out-viewer-web
              >
                $14.00
              </span>
              <span class="block text-micro text-muted">
                Estimated at standard bundle rate
              </span>
            </div>

            <div>
              <span class="block text-caption font-bold uppercase tracking-wider text-muted">
                Twitch Platform Cut
              </span>
              <span
                class="text-heading-2 font-bold text-muted font-mono tabular-nums"
                data-out-twitch-cut
              >
                $4.00
              </span>
              <span class="block text-micro text-muted">
                Collected upfront from buyer
              </span>
            </div>
          </div>
        </twitch-bits-converter>
      </div>
    </section>

    <!-- 4. Common Amounts Table (Streamer Payout vs Viewer Cost by Bundle) -->
    <section class="space-y-6 pt-6 border-t border-hairline">
      <div class="space-y-2">
        <h2 class="text-heading-2 font-bold text-ink">
          Twitch Bits to USD Conversion Table
        </h2>
        <p class="text-body-md text-muted max-w-2xl">
          Full breakdown of what the streamer receives versus what the viewer
          pays across official Twitch desktop and mobile purchase bundles.
        </p>
      </div>

      <div class="rounded-lg border border-hairline-strong bg-canvas overflow-hidden shadow-level-3">
        <div
          class="overflow-x-auto focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary"
          tabindex="0"
          role="region"
          aria-label="Twitch Bits conversion table"
        >
          <table class="w-full text-ui-sm text-left">
            <caption class="sr-only">
              Table of Twitch Bits conversions showing streamer earnings and
              viewer bundle costs
            </caption>
            <thead class="bg-canvas-soft text-caption text-muted uppercase font-bold border-b border-hairline">
              <tr>
                <th scope="col" class="py-3.5 px-4">
                  Bits Cheered
                </th>
                <th scope="col" class="py-3.5 px-4 text-right">
                  Streamer Receives
                </th>
                <th scope="col" class="py-3.5 px-4 text-right">
                  Viewer Web Cost
                </th>
                <th scope="col" class="py-3.5 px-4 text-right">
                  Twitch Markup
                </th>
                <th scope="col" class="py-3.5 px-4 text-right">
                  Creator Cut %
                </th>
                <th scope="col" class="py-3.5 px-4">
                  Bundle Discount Notes
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {commonAmounts.map((row) => (
                <tr class="hover:bg-canvas-soft/40 transition-colors">
                  <th
                    scope="row"
                    class="py-3.5 px-4 font-bold text-ink font-mono tabular-nums"
                  >
                    ✦ {row.bits.toLocaleString()} Bits
                  </th>
                  <td class="py-3.5 px-4 text-right font-bold text-primary font-mono tabular-nums text-ui-label">
                    ${row.streamerUsd.toFixed(2)}
                  </td>
                  <td class="py-3.5 px-4 text-right text-ink font-mono tabular-nums">
                    ${row.viewerWebUsd.toFixed(2)}
                  </td>
                  <td class="py-3.5 px-4 text-right text-muted font-mono tabular-nums">
                    ${row.twitchCutUsd.toFixed(2)}
                  </td>
                  <td class="py-3.5 px-4 text-right font-semibold text-ink font-mono tabular-nums">
                    {row.creatorSharePct.toFixed(1)}%
                  </td>
                  <td class="py-3.5 px-4 text-caption text-muted">
                    {row.discountBadge ? (
                      <span class="inline-block px-2 py-0.5 rounded-xxs bg-mint-50 border border-mint-200 text-primary font-semibold text-micro">
                        {row.discountBadge}
                      </span>
                    ) : (
                      "Standard $0.014/bit rate"
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot class="bg-canvas-soft border-t-2 border-hairline-strong font-bold text-caption text-muted">
              <tr>
                <td colspan="6" class="py-3 px-4">
                  * Note: Mobile app purchases (iOS App Store & Google Play)
                  cost approximately 30% more due to mobile platform store fees
                  (e.g. $1.99 for 100 bits). Streamer payout remains fixed at
                  $0.01 USD per bit.
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </section>

    <!-- 5. How Twitch Bits Economics Work (No Filler) -->
    <section class="space-y-6 pt-6 border-t border-hairline">
      <div class="space-y-2">
        <h2 class="text-heading-2 font-bold text-ink">
          How Twitch Bits Economics Work
        </h2>
        <p class="text-body-md text-muted max-w-2xl">
          Unlike subscriptions which take a 50/50 revenue split on payout, Bits
          revenue is paid out in full to the creator.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-5 rounded-lg border border-hairline-strong bg-canvas space-y-2">
          <span class="text-ui-label font-bold text-primary uppercase tracking-wider block">
            1. Streamer Keeps 100%
          </span>
          <p class="text-heading-4 font-mono font-bold text-ink">
            $0.01 per Bit Flat
          </p>
          <p class="text-caption text-muted">
            Whether a viewer cheers 1 bit or 100,000 bits, you receive exactly
            one penny per bit with no backend Twitch cut.
          </p>
        </div>

        <div class="p-5 rounded-lg border border-hairline-strong bg-canvas space-y-2">
          <span class="text-ui-label font-bold text-primary uppercase tracking-wider block">
            2. Upfront Markup
          </span>
          <p class="text-heading-4 font-mono font-bold text-ink">
            ~28% to 40% Viewer Markup
          </p>
          <p class="text-caption text-muted">
            Twitch charges the viewer a markup when buying the bundle to cover
            credit card processing, infrastructure, and margin.
          </p>
        </div>

        <div class="p-5 rounded-lg border border-hairline-strong bg-canvas space-y-2">
          <span class="text-ui-label font-bold text-primary uppercase tracking-wider block">
            3. $50 Payout Threshold
          </span>
          <p class="text-heading-4 font-mono font-bold text-ink">
            5,000 Bits Minimum
          </p>
          <p class="text-caption text-muted">
            Bits pool together with subscription revenue and ad earnings toward
            the standard $50 threshold for monthly payouts.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. Formula Block -->
    <FormulaBlock platform="twitch-bits" />

    <!-- 5. Worked Example -->
    <WorkedExample
      platform="twitch-bits"
      title="Worked Example: Receiving 5,000 Bits ($50.00)"
      description="Here is the step-by-step breakdown of creator payout and viewer web purchase cost for 5,000 Bits:"
      itemPrice={50.0}
    />

    <!-- 6. Edge Cases -->
    <EdgeCases platform="twitch-bits" />

    <!-- 7. FAQ Section -->
    <FAQ
      items={faqs}
      title="Frequently Asked Questions About Twitch Bits"
      description="Common questions on cheering conversions, payout schedules, and bank transfer fees."
    />

    <!-- 8. Related Tools -->
    <RelatedCalculators currentPlatform="twitch-bits" />

    <!-- Trust signals footer -->
    <AuthorByline platform="twitch-bits" />
    <LastVerified platform="twitch-bits" />
  </div>
</BaseLayout>

<script>
  import { trackEvent } from "../lib/analytics";

  class TwitchBitsConverter extends HTMLElement {
    private bitsInput: HTMLInputElement | null = null;
    private usdInput: HTMLInputElement | null = null;
    private outStreamerUsd: HTMLElement | null = null;
    private outViewerWeb: HTMLElement | null = null;
    private outTwitchCut: HTMLElement | null = null;
    private calcTimeout: ReturnType<typeof setTimeout> | null = null;

    connectedCallback() {
      if (this.dataset.initialized === "true") return;
      this.dataset.initialized = "true";

      this.bitsInput = this.querySelector<HTMLInputElement>("#bits-input");
      this.usdInput = this.querySelector<HTMLInputElement>("#usd-input");
      this.outStreamerUsd = this.querySelector<HTMLElement>(
        "[data-out-streamer-usd]",
      );
      this.outViewerWeb = this.querySelector<HTMLElement>(
        "[data-out-viewer-web]",
      );
      this.outTwitchCut = this.querySelector<HTMLElement>(
        "[data-out-twitch-cut]",
      );

      // Input listeners
      this.bitsInput?.addEventListener("input", () => this.handleBitsInput());
      this.usdInput?.addEventListener("input", () => this.handleUsdInput());

      // Quick preset buttons
      const presetButtons =
        this.querySelectorAll<HTMLButtonElement>("[data-preset-bits]");
      presetButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const bits = parseInt(btn.dataset.presetBits || "0", 10);
          if (bits > 0 && this.bitsInput) {
            this.bitsInput.value = bits.toLocaleString();
            this.updateFromBits(bits);
          }
        });
      });
    }

    private parseNumber(val: string): number {
      const clean = val.replace(/[^0-9.]/g, "");
      const parsed = parseFloat(clean);
      return isNaN(parsed) ? 0 : parsed;
    }

    private handleBitsInput() {
      if (!this.bitsInput) return;
      const bits = Math.floor(this.parseNumber(this.bitsInput.value));
      this.updateFromBits(bits);
    }

    private handleUsdInput() {
      if (!this.usdInput) return;
      const dollars = this.parseNumber(this.usdInput.value);
      const bits = Math.round(dollars * 100);
      if (this.bitsInput) {
        this.bitsInput.value = bits.toLocaleString();
      }
      this.updateCalculations(bits, dollars);
    }

    private updateFromBits(bits: number) {
      const dollars = bits / 100;
      if (this.usdInput) {
        this.usdInput.value = dollars.toFixed(2);
      }
      this.updateCalculations(bits, dollars);
    }

    private updateCalculations(bits: number, dollars: number) {
      // 100 bits costs approx $1.40 on web (with volume discounts on larger tiers)
      let viewerCost = 0;
      if (bits >= 25000) {
        viewerCost = bits * 0.01232; // ~12% discount
      } else if (bits >= 10000) {
        viewerCost = bits * 0.0126; // 10% discount
      } else if (bits >= 5000) {
        viewerCost = bits * 0.01288; // 8% discount
      } else if (bits >= 1500) {
        viewerCost = bits * 0.0133; // 5% discount
      } else {
        viewerCost = bits * 0.014; // $1.40 per 100 bits
      }

      const twitchCut = Math.max(0, viewerCost - dollars);

      if (this.outStreamerUsd) {
        this.outStreamerUsd.textContent = `$${dollars.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }
      if (this.outViewerWeb) {
        this.outViewerWeb.textContent = `$${viewerCost.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }
      if (this.outTwitchCut) {
        this.outTwitchCut.textContent = `$${twitchCut.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }

      this.queueAnalytics();
    }

    private queueAnalytics() {
      if (typeof window === "undefined") return;
      if (this.calcTimeout) clearTimeout(this.calcTimeout);
      this.calcTimeout = setTimeout(() => {
        trackEvent("calculator_used", {
          platform: "twitch-bits",
          mode: "forward",
        });
      }, 800);
    }
  }

  if (!customElements.get("twitch-bits-converter")) {
    customElements.define("twitch-bits-converter", TwitchBitsConverter);
  }
</script>
