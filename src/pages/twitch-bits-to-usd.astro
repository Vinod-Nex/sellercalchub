---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getEntry } from "astro:content";
import { PLATFORM_CONFIGS } from "../lib/calc";

// Load verified Twitch Bits fee metadata directly from content collection
const twitchEntry = await getEntry("fees", "twitch-bits");
const feeData = twitchEntry?.data;
const config = PLATFORM_CONFIGS["twitch-bits"];

const verifiedOnIso = feeData?.verified_on ?? config.verifiedOn;
const sourceUrl = feeData?.source_url ?? config.sourceUrl;

function formatVerifiedDate(isoDate: string): string {
  try {
    const [year, month, day] = isoDate.split("-").map(Number);
    const date = new Date(Date.UTC(year, month - 1, day));
    return date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    });
  } catch {
    return isoDate;
  }
}

const verifiedDateFormatted = formatVerifiedDate(verifiedOnIso);

// Standard Twitch Bits Bundle Table Data
const commonAmounts = [
  {
    bits: 100,
    streamerUsd: 1.0,
    viewerWebUsd: 1.4,
    viewerMobileUsd: 1.99,
    twitchCutUsd: 0.4,
    creatorSharePct: 71.4,
    discountBadge: null,
  },
  {
    bits: 500,
    streamerUsd: 5.0,
    viewerWebUsd: 7.0,
    viewerMobileUsd: 9.99,
    twitchCutUsd: 2.0,
    creatorSharePct: 71.4,
    discountBadge: null,
  },
  {
    bits: 1000,
    streamerUsd: 10.0,
    viewerWebUsd: 14.0, // Or $12.60 with first-time/promotional 5% discount
    viewerMobileUsd: 19.99,
    twitchCutUsd: 4.0,
    creatorSharePct: 71.4,
    discountBadge: "5% Web Discount available ($12.60)",
  },
  {
    bits: 1500,
    streamerUsd: 15.0,
    viewerWebUsd: 19.95,
    viewerMobileUsd: 28.99,
    twitchCutUsd: 4.95,
    creatorSharePct: 75.2,
    discountBadge: "5% Discount",
  },
  {
    bits: 5000,
    streamerUsd: 50.0,
    viewerWebUsd: 64.4,
    viewerMobileUsd: 89.99,
    twitchCutUsd: 14.4,
    creatorSharePct: 77.6,
    discountBadge: "8% Discount",
  },
  {
    bits: 10000,
    streamerUsd: 100.0,
    viewerWebUsd: 126.0,
    viewerMobileUsd: 174.99,
    twitchCutUsd: 26.0,
    creatorSharePct: 79.4,
    discountBadge: "10% Discount",
  },
  {
    bits: 25000,
    streamerUsd: 250.0,
    viewerWebUsd: 308.0,
    viewerMobileUsd: 429.99,
    twitchCutUsd: 58.0,
    creatorSharePct: 81.2,
    discountBadge: "12% Discount",
  },
];

// FAQs for Twitch Bits
const faqs = [
  {
    question: "How much is 1 Twitch Bit worth in USD?",
    answer:
      "Each Bit is worth exactly $0.01 USD (1 cent) to the streamer. If a viewer cheers 100 Bits, the streamer receives $1.00 USD. If a viewer cheers 1,000 Bits, the streamer receives $10.00 USD.",
  },
  {
    question: "Why do viewers pay more than $0.01 per Bit when buying bundles?",
    answer:
      "Twitch takes its platform revenue share upfront when viewers purchase Bits, rather than deducting fees from the streamer’s payout. For example, 100 Bits cost a viewer $1.40 USD on desktop web. Twitch keeps $0.40 (approx. 28.6% of the purchase), and passes the full $1.00 (71.4%) to the streamer upon cheering.",
  },
  {
    question:
      "Why are Twitch Bits more expensive on iPhone and Android mobile apps?",
    answer:
      "Apple’s App Store and Google Play charge a 30% platform fee on all in-app digital purchases. To offset this, Twitch charges higher prices on mobile (e.g. $1.99 USD for 100 Bits on iOS vs $1.40 USD on web). Regardless of where the viewer buys Bits, the streamer still receives exactly $0.01 USD per Bit.",
  },
  {
    question: "What is the minimum payout threshold for Twitch Bits?",
    answer:
      "Twitch has a $50.00 USD minimum payout threshold for Affiliates and Partners (lowered from $100 in 2022) for ACH direct deposit, PayPal, and check. Wire transfers still require a $100.00 USD threshold. That means you need at least 5,000 Bits (or a combination of Bits, subscriptions, and ad revenue totaling $50) to receive a payout.",
  },
  {
    question:
      "Does Twitch take any fees when transferring Bits money to my bank account?",
    answer:
      "Twitch does not take a cut from cheered Bits, but third-party payout processors may charge standard transaction fees. ACH direct deposit is free for US streamers. PayPal costs $0.75 USD (or 2% outside the US), and wire transfers cost $25.00 USD.",
  },
];

// Schema.org Structured Data
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Twitch Bits to USD Converter & Calculator",
    url: "https://sellercalchub.com/twitch-bits-to-usd/",
    description:
      "Fast, verified Twitch Bits to USD converter. Calculate what streamers receive ($0.01/bit) and what viewers pay across all official web bundle tiers.",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Twitch Bits to USD Converter",
    applicationCategory: "UtilityApplication",
    operatingSystem: "All",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title="Twitch Bits to USD Converter & Fee Calculator (Verified 2026)"
  description="Convert Twitch Bits to USD instantly. See exact streamer payouts ($0.01 per Bit), viewer web bundle costs, Twitch platform markups, and minimum payout thresholds."
  canonicalPath="/twitch-bits-to-usd/"
  structuredData={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { name: "Home", href: "/" },
        { name: "All Calculators", href: "/marketplace-fee-calculators/" },
        { name: "Twitch Bits to USD" },
      ]}
    />

    <!-- Header & Direct Answer -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-xs bg-mint-50 dark:bg-mint-200/10 border border-mint-200 text-caption text-primary font-bold">
        <span>Verified Twitch Payout: Flat $0.01 USD per 1 Bit Cheered</span>
      </div>

      <!-- 1. H1 -->
      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        Twitch Bits to USD Converter & Calculator
      </h1>

      <!-- 2. One-paragraph answer -->
      <p class="text-body-lg text-body leading-relaxed max-w-3xl">
        Twitch pays streamers exactly{" "}
        <strong>$0.01 USD (1 cent) per Bit cheered</strong> on eligible
        Affiliate and Partner channels. Twitch takes its cut upfront from
        viewers when purchasing Bits bundles (typically $1.40 per 100 Bits on
        desktop web), meaning streamers experience{" "}
        <strong>0% platform deduction</strong> on cheer revenue. Payouts
        transfer once your combined channel balance reaches the $50.00 minimum
        threshold.
      </p>
    </header>

    <!-- 3. Interactive Converter Island (Above the Fold) -->
    <section aria-label="Interactive Bits to USD Converter">
      <div class="rounded-lg border border-hairline-strong bg-canvas p-6 md:p-8 shadow-level-3 space-y-6">
        <div class="border-b border-hairline pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h2 class="text-heading-3 font-bold text-ink">
              Instant Bits ⇄ USD Converter
            </h2>
            <p class="text-caption text-muted">
              Enter Bits amount or desired dollar value to convert in real time.
            </p>
          </div>
          <span class="text-micro font-bold uppercase tracking-wider text-primary bg-mint-50 px-2 py-1 rounded-xxs border border-mint-200 shrink-0">
            1 Bit = $0.01 USD
          </span>
        </div>

        <twitch-bits-converter class="block space-y-6" data-initialized="false">
          <!-- Converter Inputs Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-start">
            <!-- Left: Bits Input -->
            <div class="space-y-2">
              <label
                for="bits-input"
                class="block text-ui-label font-bold text-ink"
              >
                Bits Amount (Cheered)
              </label>
              <div class="relative flex items-center">
                <span class="absolute left-3 text-muted font-bold pointer-events-none select-none text-ui-sm">
                  ✦
                </span>
                <input
                  type="text"
                  id="bits-input"
                  name="bits"
                  value="1,000"
                  inputmode="numeric"
                  autocomplete="off"
                  class="w-full pl-8 pr-4 py-3 rounded-xs border border-hairline-strong bg-canvas text-ink text-heading-3 font-mono font-bold focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-colors tabular-nums"
                  aria-label="Bits Amount"
                />
              </div>
              <p class="text-caption text-muted">
                Common: 100, 500, 1,000, 5,000, 10,000
              </p>
            </div>

            <!-- Right: USD Payout Output / Input -->
            <div class="space-y-2">
              <label
                for="usd-input"
                class="block text-ui-label font-bold text-ink"
              >
                Streamer Receives (USD)
              </label>
              <div class="relative flex items-center">
                <span class="absolute left-3 text-muted font-bold pointer-events-none select-none text-ui-sm">
                  $
                </span>
                <input
                  type="text"
                  id="usd-input"
                  name="usd"
                  value="10.00"
                  inputmode="decimal"
                  autocomplete="off"
                  class="w-full pl-8 pr-4 py-3 rounded-xs border border-hairline-strong bg-canvas text-ink text-heading-3 font-mono font-bold focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-colors tabular-nums"
                  aria-label="Streamer USD Payout"
                />
              </div>
