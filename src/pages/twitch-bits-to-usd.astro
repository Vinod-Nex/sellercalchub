                <th scope="col" class="py-3.5 px-4 text-right">
                  Viewer Web Cost
                </th>
                <th scope="col" class="py-3.5 px-4 text-right">
                  Twitch Markup
                </th>
                <th scope="col" class="py-3.5 px-4 text-right">
                  Creator Cut %
                </th>
                <th scope="col" class="py-3.5 px-4">
                  Bundle Discount Notes
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {commonAmounts.map((row) => (
                <tr class="hover:bg-canvas-soft/40 transition-colors">
                  <th
                    scope="row"
                    class="py-3.5 px-4 font-bold text-ink font-mono tabular-nums"
                  >
                    ✦ {row.bits.toLocaleString()} Bits
                  </th>
                  <td class="py-3.5 px-4 text-right font-bold text-primary font-mono tabular-nums text-ui-label">
                    ${row.streamerUsd.toFixed(2)}
