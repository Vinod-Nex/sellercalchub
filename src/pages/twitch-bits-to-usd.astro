            <span class="text-caption font-bold text-muted uppercase tracking-wider mr-2">
              Quick Presets:
            </span>
            {[100, 500, 1000, 2500, 5000, 10000, 25000].map((amount) => (
              <button
                type="button"
                data-preset-bits={amount}
                class="px-3 py-2 min-h-[44px] inline-flex items-center justify-center rounded-xs bg-canvas-soft border border-hairline hover:border-primary hover:text-ink text-body text-ui-sm font-semibold transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary tabular-nums"
