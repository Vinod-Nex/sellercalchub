---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Design Tokens' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Design Tokens Verification - Seller Calc Hub',
    url: 'https://sellercalchub.com/design-tokens/',
    description:
      'Verification and reference showcase for all Seller Calc Hub design tokens from DESIGN.md in Light and Dark mode.',
  },
  buildBreadcrumbSchema(breadcrumbs, '/design-tokens/'),
];

const colors = [
  { group: 'Brand & Accent', tokens: [
    { name: 'primary', class: 'bg-primary text-on-primary', hex: 'var(--color-primary)' },
    { name: 'primary-deep', class: 'bg-primary-deep text-on-primary', hex: 'var(--color-primary-deep)' },
    { name: 'forest', class: 'bg-forest text-on-primary', hex: 'var(--color-forest)' },
    { name: 'on-primary', class: 'bg-on-primary text-primary border border-hairline', hex: 'var(--color-on-primary)' },
    { name: 'lime-hero', class: 'bg-lime-hero text-forest', hex: 'var(--color-lime-hero)' },
    { name: 'lime-panel', class: 'bg-lime-panel text-ink', hex: 'var(--color-lime-panel)' },
    { name: 'lime-accent', class: 'bg-lime-accent text-forest', hex: 'var(--color-lime-accent)' },
    { name: 'lime-ribbon', class: 'bg-lime-ribbon text-forest', hex: 'var(--color-lime-ribbon)' },
    { name: 'logo-lime', class: 'bg-logo-lime text-on-primary', hex: 'var(--color-logo-lime)' },
  ]},
  { group: 'Surfaces', tokens: [
    { name: 'canvas', class: 'bg-canvas text-ink border border-hairline-strong', hex: 'var(--color-canvas)' },
    { name: 'canvas-soft', class: 'bg-canvas-soft text-ink border border-hairline', hex: 'var(--color-canvas-soft)' },
    { name: 'mint-50', class: 'bg-mint-50 text-ink border border-hairline', hex: 'var(--color-mint-50)' },
    { name: 'mint-100', class: 'bg-mint-100 text-ink border border-hairline', hex: 'var(--color-mint-100)' },
    { name: 'mint-200', class: 'bg-mint-200 text-ink border border-hairline', hex: 'var(--color-mint-200)' },
    { name: 'hairline', class: 'bg-hairline text-ink border border-hairline-strong', hex: 'var(--color-hairline)' },
    { name: 'hairline-strong', class: 'bg-hairline-strong text-ink', hex: 'var(--color-hairline-strong)' },
  ]},
  { group: 'Text Tiers', tokens: [
    { name: 'ink', class: 'bg-canvas text-ink border border-hairline', hex: 'var(--color-ink)' },
    { name: 'body', class: 'bg-canvas text-body border border-hairline', hex: 'var(--color-body)' },
    { name: 'muted', class: 'bg-canvas text-muted border border-hairline', hex: 'var(--color-muted)' },
    { name: 'faint', class: 'bg-canvas text-faint border border-hairline', hex: 'var(--color-faint)' },
  ]},
  { group: 'Semantic', tokens: [
    { name: 'link', class: 'bg-link text-white', hex: 'var(--color-link)' },
    { name: 'info', class: 'bg-info text-white', hex: 'var(--color-info)' },
    { name: 'error', class: 'bg-error text-white', hex: 'var(--color-error)' },
  ]},
];

const typography = [
  { token: 'display-xl', size: '52px', weight: '700', lh: '1.15', sample: 'Display XL (52px / 700)' },
  { token: 'display-lg', size: '40px', weight: '700', lh: '1.2', sample: 'Display LG Editorial Title (40px / 700)' },
  { token: 'heading-1', size: '36px', weight: '700', lh: '1.2', sample: 'Heading 1 Section Title (36px / 700)' },
  { token: 'heading-2', size: '28px', weight: '700', lh: '1.25', sample: 'Heading 2 Sub-Section (28px / 700)' },
  { token: 'stat-value', size: '24px', weight: '700', lh: '1.2', sample: '$1,452.80 Net Profit' },
  { token: 'heading-3', size: '20px', weight: '700', lh: '1.3', sample: 'Heading 3 Card Headline (20px / 700)' },
  { token: 'heading-4', size: '20px', weight: '500', lh: '1.3', sample: 'Heading 4 Light Subheading (20px / 500)' },
  { token: 'body-lg', size: '18px', weight: '300', lh: '1.5', sample: 'Body Large: Enter sale price and item costs to see take-home net.' },
  { token: 'body-md', size: '16px', weight: '300', lh: '1.5', sample: 'Body Medium: Standard copy across calculator inputs, rate descriptions, and disclosures.' },
  { token: 'body-sm', size: '14px', weight: '300', lh: '1.5', sample: 'Body Small: Dense financial breakdown tables, fee schedules, and comparisons.' },
  { token: 'ui-label', size: '14px', weight: '700', lh: '1.2', sample: 'CALCULATE PROFIT (14px / 700)' },
  { token: 'ui-sm', size: '13px', weight: '500', lh: '1.3', sample: 'UI Small: Compact control labels and table headers (13px / 500)' },
  { token: 'caption', size: '12px', weight: '500', lh: '1.4', sample: 'Caption: Payment processing fee: 2.9% + $0.30' },
  { token: 'eyebrow', size: '12px', weight: '700', lh: '1.2', sample: 'SECTION EYEBROW LABEL' },
  { token: 'micro', size: '11px', weight: '500', lh: '1.4', sample: 'VERIFIED OFFICIAL RATES 2026' },
];

const spacing = [
  { token: 'xxs', value: '4px', class: 'w-xxs' },
  { token: 'xs', value: '8px', class: 'w-xs' },
  { token: 'sm', value: '12px', class: 'w-sm' },
  { token: 'md', value: '16px', class: 'w-md' },
  { token: 'lg', value: '20px', class: 'w-lg' },
  { token: 'xl', value: '24px', class: 'w-xl' },
  { token: 'xxl', value: '32px', class: 'w-xxl' },
  { token: 'section', value: '40px', class: 'w-section' },
];

const radii = [
  { token: 'none', value: '0px', class: 'rounded-none' },
  { token: 'xxs', value: '1px', class: 'rounded-xxs' },
  { token: 'xs', value: '2px (Buttons)', class: 'rounded-xs' },
  { token: 'sm', value: '4px', class: 'rounded-sm' },
  { token: 'md', value: '6px', class: 'rounded-md' },
  { token: 'lg', value: '8px (Cards)', class: 'rounded-lg' },
  { token: 'xl', value: '10px', class: 'rounded-xl' },
  { token: 'xxl', value: '12px', class: 'rounded-xxl' },
  { token: 'xxxl', value: '16px (Panels)', class: 'rounded-xxxl' },
  { token: 'tooltip', value: '20px', class: 'rounded-tooltip' },
  { token: 'full', value: '9999px (Pills)', class: 'rounded-full' },
];
---

<BaseLayout
  title="Design Tokens Verification - Seller Calc Hub"
  description="Verification and reference showcase for all Seller Calc Hub design tokens from DESIGN.md in Light and Dark mode."
  canonicalPath="/design-tokens/"
  noindex={true}
  structuredData={structuredData}
>
  <div class="max-w-6xl mx-auto px-4 py-8 space-y-12">
    <!-- Visible Semantic Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Band Component from DESIGN.md -->
    <section class="rounded-lg overflow-hidden bg-gradient-to-r from-forest via-primary-deep to-primary text-on-primary p-6 md:p-10 shadow-level-3">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-micro font-bold uppercase tracking-wider text-lime-panel bg-forest/50 px-2 py-0.5 rounded-xs">
          ✓ Verified Official Design System
        </span>
      </div>
      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-white mb-3">
        Design Token Test Page
      </h1>
      <p class="text-body-lg font-light text-mint-50 max-w-2xl">
        Complete verification of NerdWallet-inspired design tokens from <code class="bg-forest/80 px-1.5 py-0.5 rounded-xs font-mono text-ui-sm">DESIGN.md</code> in both Light and Dark themes.
      </p>
    </section>

    <!-- Colors Section -->
    <section class="space-y-6">
      <div class="border-b border-hairline pb-2">
        <h2 class="text-heading-2 font-bold text-ink">Color Tokens</h2>
        <p class="text-body-md text-muted font-light">Deep spruce green, three-step mint ladder, lime accents, and surface contrast.</p>
      </div>

      <div class="space-y-6">
        {colors.map((group) => (
          <div class="space-y-3">
            <h3 class="text-ui-label uppercase tracking-wider text-muted font-bold">{group.group}</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
              {group.tokens.map((token) => (
                <div class="rounded-lg border border-hairline bg-canvas p-3 space-y-2">
                  <div class={`h-12 w-full rounded-sm flex items-center justify-center font-bold text-ui-sm ${token.class}`}>
                    {token.name}
                  </div>
                  <div class="text-caption text-muted flex justify-between items-center">
                    <span class="font-mono text-ink text-ui-sm">--color-{token.name}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Typography Scale Section -->
    <section class="space-y-6">
      <div class="border-b border-hairline pb-2">
        <h2 class="text-heading-2 font-bold text-ink">Typography Hierarchy</h2>
        <p class="text-body-md text-muted font-light">Self-hosted Montserrat with 300 body copy vs 700 headings weight contrast.</p>
      </div>

      <div class="divide-y divide-hairline rounded-lg border border-hairline bg-canvas overflow-hidden">
        {typography.map((item) => (
          <div class="p-4 flex flex-col md:flex-row md:items-center justify-between gap-2">
            <div class="w-48 shrink-0">
              <span class="text-ui-label font-bold text-primary block">{item.token}</span>
              <span class="text-caption text-muted font-mono">{item.size} · w{item.weight} · lh {item.lh}</span>
            </div>
            <div class="flex-1">
              <span class={`text-${item.token} font-[${item.weight}] text-ink block`}>
                {item.sample}
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Spacing & Radii Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Spacing Scale -->
      <section class="space-y-4">
        <div class="border-b border-hairline pb-2">
          <h2 class="text-heading-3 font-bold text-ink">Spacing Scale (8px Base)</h2>
        </div>
        <div class="rounded-lg border border-hairline bg-canvas p-4 space-y-3">
          {spacing.map((s) => (
            <div class="flex items-center gap-3">
              <div class="w-20 text-ui-sm font-mono text-muted">--spacing-{s.token}</div>
              <div class="w-16 text-caption text-muted font-mono">{s.value}</div>
              <div class={`h-4 bg-primary rounded-xxs ${s.class}`}></div>
            </div>
          ))}
        </div>
      </section>

      <!-- Radii Scale -->
      <section class="space-y-4">
        <div class="border-b border-hairline pb-2">
          <h2 class="text-heading-3 font-bold text-ink">Radius Scale</h2>
        </div>
        <div class="rounded-lg border border-hairline bg-canvas p-4 space-y-3">
          {radii.map((r) => (
            <div class="flex items-center gap-3">
              <div class="w-28 text-ui-sm font-mono text-muted">{r.token}</div>
              <div class="w-28 text-caption text-muted">{r.value}</div>
              <div class={`w-10 h-10 border-2 border-primary bg-mint-50 flex items-center justify-center ${r.class}`}></div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- Components from DESIGN.md -->
    <section class="space-y-6">
      <div class="border-b border-hairline pb-2">
        <h2 class="text-heading-2 font-bold text-ink">Component Archetypes from DESIGN.md</h2>
        <p class="text-body-md text-muted font-light">Buttons at 2px radius, 16px flat padding; hairline borders; mint washes.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Buttons Group -->
        <div class="rounded-lg border border-hairline bg-canvas p-6 space-y-4">
          <h3 class="text-heading-3 text-ink font-bold">Buttons</h3>
          <div class="space-y-3">
            <div>
              <button type="button" class="w-full bg-primary text-on-primary font-bold text-ui-label uppercase p-md rounded-xs hover:bg-primary-deep transition-colors cursor-pointer shadow-level-3">
                Primary Button (2px)
              </button>
            </div>
            <div>
              <button type="button" class="w-full bg-canvas-soft text-primary font-bold text-ui-label uppercase p-md rounded-xs hover:bg-mint-50 border border-hairline transition-colors cursor-pointer">
                Secondary Button (2px)
              </button>
            </div>
            <div>
              <button type="button" class="w-full bg-transparent text-primary font-bold text-ui-label px-md py-xs rounded-lg border border-hairline-strong hover:bg-mint-50 transition-colors cursor-pointer">
                Outline Button (8px)
              </button>
            </div>
          </div>
        </div>

        <!-- Expert Tip Panel -->
        <div class="rounded-lg bg-lime-panel text-ink p-6 space-y-4">
          <div class="flex items-center gap-2">
            <span class="text-primary font-bold text-ui-label">PRO TIP →</span>
            <span class="text-micro font-bold text-forest uppercase">Fee Optimization</span>
          </div>
          <p class="text-body-md font-light text-ink">
            Use Whatnot’s integrated USPS flat rate boxes for items weighing over 1 lb to save up to $4.20 on shipping fees.
          </p>
          <div class="rounded-lg bg-primary-deep text-on-primary p-4 space-y-1">
            <span class="text-caption text-mint-100 uppercase tracking-wider block font-medium">Estimated Net Savings</span>
            <span class="text-stat-value font-bold text-white block">$18.50 / order</span>
          </div>
        </div>

        <!-- Product / Rate Card -->
        <div class="rounded-lg border border-hairline-strong bg-canvas p-6 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-ui-label uppercase tracking-wider text-muted font-bold">eBay Seller</span>
            <span class="bg-mint-100 text-primary text-eyebrow px-2 py-0.5 rounded-xs font-bold">Top Rated</span>
          </div>
          <div>
            <h4 class="text-heading-3 text-ink font-bold">Final Value Fee</h4>
            <p class="text-body-sm text-muted font-light">13.25% + $0.30 per order</p>
          </div>
          <div class="border-t border-hairline pt-3 flex justify-between items-baseline">
            <span class="text-caption text-body">Net Payout on $100:</span>
            <span class="text-stat-value font-bold text-primary">$86.45</span>
          </div>
          <button type="button" class="w-full bg-primary text-on-primary font-bold text-ui-label uppercase py-2 px-md rounded-xs hover:bg-primary-deep transition-colors cursor-pointer">
            Calculate eBay Fee
          </button>
        </div>
      </div>
    </section>

    <!-- Related Component Demos -->
    <section class="rounded-lg border border-hairline-strong bg-canvas-soft p-6 space-y-3">
      <h2 class="text-heading-3 font-bold text-ink">Related Design System Pages</h2>
      <p class="text-body-md text-muted">
        Review interactive keypad behaviors, input modes, and form validation controls:
      </p>
      <div>
        <a
          href="/inputs-demo/"
          class="inline-flex items-center gap-1.5 text-primary font-bold hover:underline"
        >
          <span>Explore Shared Input Components Demo</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
