---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EmailAction from '../components/EmailAction.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Privacy Policy' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Privacy Policy - Seller Calc Hub',
    url: 'https://sellercalchub.com/privacy/',
    description:
      'Seller Calc Hub Privacy Policy: zero selling of user data, 100% client-side calculations, no tracking cookies, and full GDPR & CCPA compliance.',
    publisher: {
      '@type': 'Organization',
      name: 'Seller Calc Hub',
      url: 'https://sellercalchub.com/',
      logo: 'https://sellercalchub.com/favicon.svg',
    },
  },
  buildBreadcrumbSchema(breadcrumbs, '/privacy/'),
];

const localStorageKeys = [
  {
    key: 'sch_theme',
    purpose: 'Stores your preferred color scheme (light, dark, or system default) to prevent screen flickering between page visits.',
    duration: 'Persistent until cleared by user',
    type: 'Local Browser Storage',
  },
  {
    key: 'sch_privacy_notice_dismissed',
    purpose: 'Records whether you dismissed the non-intrusive informational notice regarding client-side data privacy.',
    duration: 'Persistent until cleared by user',
    type: 'Local Browser Storage',
  },
];
---

<BaseLayout
  title="Privacy Policy - Seller Calc Hub"
  description="Seller Calc Hub Privacy Policy: zero selling of user data, 100% client-side calculations, no tracking cookies, and full GDPR & CCPA compliance."
  canonicalPath="/privacy/"
  structuredData={structuredData}
>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-xs bg-mint-50 dark:bg-mint-200/10 border border-mint-200 text-caption text-primary font-bold">
        <span>Privacy &amp; Data Protection</span>
      </div>

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        Privacy Policy
      </h1>

      <p class="text-body-sm text-muted">
        Last Updated &amp; Effective Date: <strong class="text-ink">November 23, 2026</strong>
      </p>

      <p class="text-body-lg text-body leading-relaxed">
        Seller Calc Hub (“we”, “us”, or “our”) is dedicated to absolute data privacy. Our privacy philosophy is simple and uncompromising: <strong class="text-ink font-semibold">we do not collect, store, transmit, or sell the pricing figures, costs of goods sold (COGS), or profit calculations you enter on our website.</strong>
      </p>
    </header>

    <!-- Main Policy Sections -->
    <div class="space-y-10 border-t border-hairline pt-8 text-body text-body leading-relaxed">
      <!-- Section 1 -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">1. Client-Side Calculation Guarantee</h2>
        <p>
          All fee computations, shipping expense breakdowns, net payout deductions, and return on investment (ROI) simulations are executed entirely within your web browser using client-side JavaScript or pre-compiled static HTML.
        </p>
        <div class="bg-mint-50/50 dark:bg-mint-200/10 border border-mint-200 rounded-lg p-5 text-body-sm font-medium text-ink space-y-2">
          <p class="font-bold flex items-center gap-2 text-primary">
            <span class="w-2.5 h-2.5 rounded-full bg-primary" aria-hidden="true"></span>
            <span>Zero-Transmission Architecture</span>
          </p>
          <p>
            When you type a sale price, shipping charge, or inventory acquisition cost into any calculator input on Seller Calc Hub, those numbers remain exclusively in your local device memory. We never transmit your entries across the internet to our servers or any remote database. When you refresh or close your browser tab, your entered figures are erased unless you voluntarily bookmark an optional shareable URL containing your calculation state parameters.
          </p>
        </div>
      </section>

      <!-- Section 2 -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">2. Information We Do NOT Collect</h2>
        <p>
          Unlike conventional software platforms, Seller Calc Hub operates with zero requirement for personal data collection:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-body-sm">
          <li><strong>No User Registration or Profiles:</strong> You do not need to register an account, set up a password, or submit your name or email address to access our complete suite of calculators.</li>
          <li><strong>No Financial Account Integration:</strong> We do not integrate with, connect to, or request credentials for your bank accounts, eBay Managed Payments, PayPal, Etsy Payments, or merchant accounts.</li>
          <li><strong>No Store or Inventory Scraping:</strong> We do not scrape, inspect, or connect to your active store listings, order history, or customer shipping addresses.</li>
          <li><strong>No Cross-Site Behavioral Tracking:</strong> We do not profile your shopping or browsing behavior across other websites, nor do we sell user data to advertising exchanges, data brokers, or financial institutions.</li>
        </ul>
      </section>

      <!-- Section 3 -->
      <section class="space-y-4">
        <h2 class="text-heading-2 font-bold text-ink">3. Cookies &amp; Local Browser Storage Transparency</h2>
        <p>
          Seller Calc Hub does not use third-party tracking cookies or fingerprinting scripts. We utilize standard browser local storage (<code class="text-ink font-mono text-micro">localStorage</code>) strictly for essential user experience preferences:
        </p>

        <div class="overflow-x-auto rounded-lg border border-hairline">
          <table class="w-full text-left text-body-sm">
            <thead class="bg-canvas-soft border-b border-hairline text-caption font-bold text-ink uppercase tracking-wider">
              <tr>
                <th class="p-3.5">Storage Key</th>
                <th class="p-3.5">Purpose &amp; Description</th>
                <th class="p-3.5">Storage Mechanism</th>
                <th class="p-3.5">Retention</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {localStorageKeys.map((item) => (
                <tr class="hover:bg-canvas-soft/40 transition-colors">
                  <td class="p-3.5 font-mono text-ui-sm font-semibold text-primary">{item.key}</td>
                  <td class="p-3.5 text-body-sm text-body">{item.purpose}</td>
                  <td class="p-3.5 text-caption text-muted">{item.type}</td>
                  <td class="p-3.5 text-caption text-muted">{item.duration}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="text-caption text-muted">
          You may clear your browser local storage or disable local storage at any time via your browser settings. Doing so will simply reset your color theme to your operating system default and will not impact the mathematical functionality of our calculators.
        </p>
      </section>

      <!-- Section 4 -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">4. Advertising &amp; Future Monetization Transparency</h2>
        <p>
          Seller Calc Hub is currently 100% free of commercial display advertisements, popups, and sponsored tracking tags.
        </p>
        <p class="text-body-sm text-body">
          To ensure long-term sustainability while keeping our calculators free forever, we may in the future introduce non-intrusive contextual display advertising or transparent affiliate links to reputable seller tools (such as shipping label services or inventory management platforms). If and when monetization is introduced:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-body-sm">
          <li>We will <strong>never</strong> use invasive behavioral tracking cookies or sell your browsing history to third-party ad networks.</li>
          <li>Any affiliate partnerships will be clearly disclosed in accordance with Federal Trade Commission (FTC) guidelines.</li>
          <li>Affiliate relationships or advertising will <strong>never</strong> influence or alter our published fee schedules, calculation formulas, or editorial ratings.</li>
        </ul>
      </section>

      <!-- Section 5 -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">5. Server Infrastructure &amp; Technical Security</h2>
        <p>
          Like all web services delivered via standard web infrastructure, our hosting delivery network (CDN) ephemerally processes standard web request headers (including IP address, browser user-agent, requested file URL, and timestamp). This information is processed exclusively for technical security, rate limiting, and DDoS defense, and is routinely purged. All data transmitted between your browser and Seller Calc Hub is protected using modern HTTPS (TLS) encryption.
        </p>
      </section>

      <!-- Section 6 -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">6. Third-Party Links to Marketplace Documentation</h2>
        <p>
          Our calculators, fee changelogs, and methodology pages include outbound links to official marketplace policies (e.g. eBay, Etsy, Whatnot, TikTok Shop, Depop, and Twitch). Once you navigate away from SellerCalcHub.com, your activity is subject to the terms and privacy practices of those external platforms. We encourage you to review their privacy policies directly.
        </p>
      </section>

      <!-- Section 7 -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">7. European Union &amp; UK Data Protection (GDPR)</h2>
        <p>
          If you are an individual resident within the European Economic Area (EEA) or the United Kingdom, the General Data Protection Regulation (GDPR) and UK Data Protection Act 2018 afford you specific statutory rights regarding personal data:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-body-sm">
          <li><strong>Right of Access (Article 15):</strong> The right to obtain confirmation as to whether your personal data is processed.</li>
          <li><strong>Right to Rectification (Article 16):</strong> The right to rectify inaccurate personal information.</li>
          <li><strong>Right to Erasure (Article 17):</strong> The right to request deletion of personal information.</li>
          <li><strong>Right to Restriction of Processing (Article 18):</strong> The right to restrict certain processing activities.</li>
          <li><strong>Right to Data Portability (Article 20):</strong> The right to receive your personal data in a machine-readable format.</li>
          <li><strong>Right to Object (Article 21):</strong> The right to object to data processing based on legitimate interests.</li>
        </ul>
        <p class="text-body-sm text-body">
          Because Seller Calc Hub does not collect or store personal profiles, email addresses, or transaction data, our platform is private by default. For any inquiries regarding GDPR data rights, please contact our Data Protection Officer at <EmailAction variant="inline" email="info@sellercalchub.com" subject="GDPR & Data Rights Inquiry" />.
        </p>
      </section>

      <!-- Section 8 -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">8. California Privacy Rights (CCPA / CPRA)</h2>
        <p>
          Under the California Consumer Privacy Act (CCPA) as amended by the California Privacy Rights Act (CPRA), California residents are entitled to notice regarding their personal information:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-body-sm">
          <li><strong>Zero Sale of Personal Information:</strong> We do not sell, rent, or trade personal data to third parties.</li>
          <li><strong>Zero Sharing for Cross-Context Behavioral Advertising:</strong> We do not share personal data with advertisers for targeted marketing.</li>
          <li><strong>Right to Know &amp; Delete:</strong> You have the right to request disclosure or deletion of any personal data held by us.</li>
          <li><strong>Right to Non-Discrimination:</strong> You will never be denied equal access or pricing for exercising your privacy rights.</li>
        </ul>
      </section>

      <!-- Section 9 -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">9. Children’s Online Privacy Protection (COPPA)</h2>
        <p>
          Seller Calc Hub is a commercial calculation and business planning utility intended strictly for adult online sellers, independent business owners, and resellers aged 18 and older. We do not knowingly collect, request, or maintain information from children under the age of 13 in compliance with the Children’s Online Privacy Protection Act (COPPA).
        </p>
      </section>

      <!-- Section 10 -->
      <section class="space-y-4">
        <h2 class="text-heading-2 font-bold text-ink">10. Contacting Our Privacy Team</h2>
        <p>
          If you have questions, feedback, or formal data protection requests regarding this Privacy Policy or our client-side architecture, please contact us:
        </p>
        <div class="p-5 rounded-lg border border-hairline bg-canvas font-mono text-ui-sm text-ink space-y-2">
          <p class="flex flex-wrap items-center gap-2">
            <strong>Data Protection Team:</strong> <EmailAction variant="inline" email="info@sellercalchub.com" subject="Privacy Policy Inquiry" />
          </p>
          <p class="text-caption font-sans text-muted">
            Seller Calc Hub Data Protection Officer · SellerCalcHub.com · Privacy Inquiries
          </p>
        </div>
      </section>
    </div>

    <!-- Navigation Footer -->
    <section class="border-t border-hairline pt-6 flex flex-wrap items-center justify-between gap-4 text-ui-sm font-bold text-primary">
      <div class="flex flex-wrap items-center gap-6">
        <a href="/terms/" class="hover:underline min-h-[44px] inline-flex items-center gap-1.5">
          <span>Terms of Service &amp; Fee Disclaimer</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/about/" class="hover:underline min-h-[44px] inline-flex items-center gap-1.5">
          <span>About Seller Calc Hub</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <a href="/contact/" class="hover:underline min-h-[44px] inline-flex items-center gap-1.5">
        <span>Contact Us</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </section>
  </div>
</BaseLayout>
