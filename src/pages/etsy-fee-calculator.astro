---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalculatorIsland from "../components/CalculatorIsland.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustHeader from "../components/TrustHeader.astro";
import FormulaBlock from "../components/FormulaBlock.astro";
import WorkedExample from "../components/WorkedExample.astro";
import EdgeCases from "../components/EdgeCases.astro";
import FAQ from "../components/FAQ.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import LastVerified from "../components/LastVerified.astro";
import AuthorByline from "../components/AuthorByline.astro";
import { getPageSeo } from "../lib/seo";
import { buildCalculatorStructuredData } from "../lib/schema";

const seo = getPageSeo("/etsy-fee-calculator/");

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "All Calculators", href: "/marketplace-fee-calculators/" },
  { name: "Etsy Fee Calculator" },
];

// FAQ definitions
const faqs = [
  {
    question: "How much does Etsy take per sale in total?",
    answer:
      "On a standard sale without Offsite Ads, Etsy takes a $0.20 listing fee, a 6.5% transaction fee on the full sale price (including shipping), and a 3.0% + $0.25 payment processing fee. For typical items, this averages out to approximately 9.5% to 11.5% in total fees.",
  },
  {
    question: "Does Etsy charge the 6.5% transaction fee on shipping costs?",
    answer:
      "Yes. Etsy charges the 6.5% transaction fee on the total amount the buyer pays, which includes both the item price and any shipping or delivery fees you charge. This prevents sellers from artificially lowering item prices and inflating shipping costs to avoid fees.",
  },
  {
    question: "How does the $0.20 listing fee and auto-renewal work?",
    answer:
      "A $0.20 USD listing fee is charged whenever you publish a new listing or renew an existing one. Each listing remains active for 4 months or until the item sells. If you list multiple quantities of the same item, you are charged $0.20 initially, and another $0.20 each time an additional unit sells and auto-renews.",
  },
  {
    question: "What are Etsy Offsite Ads and how much do they cost?",
    answer:
      "Etsy advertises your products across Google, Facebook, Instagram, Pinterest, and Bing. If a buyer clicks an external ad and buys from your shop within 30 days, Etsy charges an Offsite Ads fee: 15% for shops under $10,000/year (optional) or 12% for shops over $10,000/year (mandatory). The fee is strictly capped at a maximum of $100.00 USD per order.",
  },
  {
    question: "Can I opt out of Etsy Offsite Ads?",
    answer:
      "If your shop has made less than $10,000 USD in total sales over the past 12 months, you can opt out of Offsite Ads at any time in your Shop Manager settings. Once your shop crosses $10,000 USD in 12-month sales, participation becomes mandatory for the remaining lifetime of your shop at the lower 12% rate.",
  },
];

// Structured Data
const structuredData = buildCalculatorStructuredData({
  name: seo.h1,
  url: "/etsy-fee-calculator/",
  description: seo.metaDescription,
  currency: "USD",
  breadcrumbs,
  faqs,
});
---

<BaseLayout
  title={seo.title}
  description={seo.metaDescription}
  canonicalPath="/etsy-fee-calculator/"
  structuredData={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header & Direct Answer in First Paragraph -->
    <header class="space-y-4">
      <TrustHeader platform="etsy" />

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>

      <p class="text-body-lg text-body leading-relaxed max-w-3xl">
        Etsy charges a <strong class="text-ink">6.5% transaction fee</strong> on the total sale price (including shipping and gift wrapping), a flat <strong class="text-ink">$0.20 listing fee</strong> active for 4 months, and a <strong class="text-ink">3.0% + $0.25 payment processing fee</strong> via Etsy Payments in the US. Total standard fees average 9.5% to 10.5% + $0.45 per transaction. An additional 15% (or mandatory 12% for shops over $10,000 trailing sales) applies only if an item sells through Etsy Offsite Ads. Enter your item price and production costs below to see your true take-home earnings.
      </p>
    </header>

    <!-- 2. Calculator Island Above the Fold -->
    <section aria-label="Etsy Fee Calculator Island">
      <CalculatorIsland
        platform="etsy"
        showPlatformTabs={false}
        initialPrice={45.0}
        initialShippingCharged={4.5}
        initialItemCost={12.0}
        initialShippingCost={4.5}
        initialQuantity={1}
      />
    </section>

    <!-- 3. Formula in Plain Text -->
    <FormulaBlock platform="etsy" />

    <!-- 4. One Worked Example -->
    <WorkedExample
      platform="etsy"
      title="Worked Example: Selling a $45 Handmade Ceramic Mug"
      description="Here is the step-by-step breakdown of what you actually keep when selling an artisan mug for $45.00 with $4.50 buyer shipping and $12.00 materials:"
      itemPrice={45.0}
      shippingCharged={4.5}
      itemCost={12.0}
      shippingCost={4.5}
    />

    <!-- 5. Edge Cases -->
    <EdgeCases platform="etsy" />

    <!-- Offsite Ads Specialized Deep-Dive Callout -->
    <section class="rounded-lg border-2 border-primary/20 bg-mint-50/50 dark:bg-mint-200/10 p-6 md:p-8 space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-micro font-bold uppercase tracking-wider text-primary-deep dark:text-emerald-300 bg-mint-100 dark:bg-mint-200/20 px-2 py-0.5 rounded-xs">
          Specialized Analysis
        </span>
      </div>
      <h2 class="text-heading-2 font-bold text-ink">
        Evaluating the Impact of Etsy Offsite Ads?
      </h2>
      <p class="text-body-md text-body leading-relaxed max-w-3xl">
        Offsite Ads add an extra 12% to 15% deduction on attributed sales, bringing total fees over 25%. We built a dedicated Offsite Ads calculator to help you analyze your break-even pricing, evaluate opt-out thresholds, and model the $100 fee cap.
      </p>
      <div>
        <a
          href="/etsy-offsite-ads-fee-calculator/"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-on-primary font-bold text-ui-label rounded-xs hover:bg-primary-deep transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary min-h-[44px]"
        >
          <span>Open Dedicated Etsy Offsite Ads Calculator</span>
          <svg class="w-4 h-4" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </section>

    <!-- 6. FAQ Section -->
    <FAQ
      items={faqs}
      title="Frequently Asked Questions About Etsy Fees"
      description="Everything handmade and vintage sellers need to know about listing costs, processing rates, and ad deductions."
    />

    <!-- 7. Related Calculators Grid -->
    <RelatedCalculators currentPlatform="etsy" />

    <!-- Trust signals footer -->
    <AuthorByline platform="etsy" />
    <LastVerified platform="etsy" />
  </div>
</BaseLayout>
