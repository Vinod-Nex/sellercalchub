---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FeeDisclaimer from '../components/FeeDisclaimer.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'About Seller Calc Hub' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Seller Calc Hub: Free & Verified Fee Calculators',
    url: 'https://sellercalchub.com/about/',
    description:
      'Learn about Seller Calc Hub: our mission to provide fast, 100% free, transparent, and verified marketplace fee and profit calculators for online resellers.',
    publisher: {
      '@type': 'Organization',
      name: 'Seller Calc Hub',
      url: 'https://sellercalchub.com/',
      logo: 'https://sellercalchub.com/favicon.svg',
    },
  },
  buildBreadcrumbSchema(breadcrumbs, '/about/'),
];

const supportedPlatforms = [
  {
    name: 'eBay US & UK',
    focus: 'Managed Payments, Category Ladders, Shipping Fee Cuts & 0% UK Private Rates',
    status: 'Verified & Active',
    href: '/ebay-fee-calculator/',
  },
  {
    name: 'Whatnot',
    focus: '8.0% Commission, 2.9% + $0.30 Processing on Gross (incl. Tax), Smart Bundling',
    status: 'Verified & Active',
    href: '/whatnot-fee-calculator/',
  },
  {
    name: 'TikTok Shop',
    focus: 'Category Referral Fees (6.0% to 8.0%), Co-Funded Vouchers & Sample Rules',
    status: 'Verified & Active',
    href: '/tiktok-shop-fee-calculator/',
  },
  {
    name: 'Etsy & Offsite Ads',
    focus: '6.5% Transaction Fee, $0.20 Listing Fee, 3% + $0.25 Processing & Mandatory Ads',
    status: 'Verified & Active',
    href: '/etsy-fee-calculator/',
  },
  {
    name: 'Depop',
    focus: '0% US/UK Selling Fees, 3.3% + $0.45 Payment Processing & Marketplace Buyer Fees',
    status: 'Verified & Active',
    href: '/depop-fee-calculator/',
  },
  {
    name: 'Twitch Bits',
    focus: 'Fixed $0.01 per Bit Streamer Cash Payout & Direct Threshold Estimates',
    status: 'Verified & Active',
    href: '/twitch-bits-to-usd/',
  },
];
---

<BaseLayout
  title="About Seller Calc Hub: Free & Verified Fee Calculators"
  description="Learn about Seller Calc Hub: our mission to provide fast, 100% free, transparent, and verified marketplace fee and profit calculators for online resellers."
  canonicalPath="/about/"
  structuredData={structuredData}
>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-xs bg-mint-50 dark:bg-mint-200/10 border border-mint-200 text-caption text-primary font-bold">
        <span>Our Mission &amp; Editorial Standards</span>
      </div>

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        Built for Online Resellers Who Value Precision
      </h1>

      <p class="text-body-lg text-body leading-relaxed">
        Online resellers lose thousands of dollars every year to unexpected marketplace fee deductions, payment processing surcharges on buyer sales tax, and hidden shipping commissions. Existing fee calculators across the internet are bloated with intrusive video ads, broken on mobile devices, or rely on stale fee schedules from 2019. We built <strong class="text-ink font-semibold">Seller Calc Hub</strong> to deliver fast, verified, and completely free financial clarity.
      </p>
    </header>

    <!-- The Problem We Saw in the Reselling Space -->
    <section class="space-y-6 border-t border-hairline pt-8">
      <div class="space-y-2">
        <h2 class="text-heading-2 font-bold text-ink">The Reseller Dilemma: Why Accurate Fee Math Matters</h2>
        <p class="text-body text-body leading-relaxed">
          Selling fees represent the single largest variable operating expense for ecommerce resellers outside of inventory acquisition costs. Yet platforms frequently adjust commission brackets, introduce regulatory operating fees, and change payment processing structures:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="rounded-lg border border-hairline bg-canvas p-6 space-y-3 shadow-xs">
          <div class="flex items-center gap-2 text-primary font-bold">
            <span class="w-2.5 h-2.5 rounded-full bg-primary" aria-hidden="true"></span>
            <h3 class="text-heading-4 text-ink">Surprise Deductions on Shipping &amp; Sales Tax</h3>
          </div>
          <p class="text-body-sm text-body leading-relaxed">
            Many sellers fail to realize that platforms like eBay, Etsy, and Whatnot assess their full percentage commission not only on the item price, but also on the shipping fee paid by the buyer and state sales taxes collected under marketplace facilitator laws. Charging a buyer $15 for postage on eBay reduces your label budget by approximately $2.00, quietly eroding your bottom line.
          </p>
        </div>

        <div class="rounded-lg border border-hairline bg-canvas p-6 space-y-3 shadow-xs">
          <div class="flex items-center gap-2 text-primary font-bold">
            <span class="w-2.5 h-2.5 rounded-full bg-primary" aria-hidden="true"></span>
            <h3 class="text-heading-4 text-ink">Rapidly Shifting Marketplace Policies</h3>
          </div>
          <p class="text-body-sm text-body leading-relaxed">
            Marketplace policies have changed dramatically: Depop eliminated selling fees for US and UK sellers; eBay launched 0% selling fees for UK private sellers; Etsy enforced mandatory 12% to 15% Offsite Ads fees for high-volume shops; and TikTok Shop transitioned from promotional launch cuts to standard category referral rates. Using outdated fee tables leads directly to selling at a loss.
          </p>
        </div>
      </div>
    </section>

    <!-- Our Five Core Commitments -->
    <section class="space-y-6 border-t border-hairline pt-8">
      <div class="space-y-2">
        <h2 class="text-heading-2 font-bold text-ink">Our Five Architectural &amp; Editorial Commitments</h2>
        <p class="text-body text-body leading-relaxed">
          Every tool, formula, and page on Seller Calc Hub is governed by five strict principles:
        </p>
      </div>

      <div class="space-y-4">
        <div class="rounded-lg border border-hairline bg-canvas p-5 space-y-2">
          <h3 class="text-heading-4 font-bold text-ink flex items-center gap-2">
            <span class="text-primary font-mono text-ui-label">1.</span>
            <span>100% Free Forever with Zero Distracting Popups</span>
          </h3>
          <p class="text-body-sm text-body leading-relaxed">
            No full-screen interstitials, no auto-playing media, no layout shifts, no mandatory email newsletter gates, and no paid premium tiers. Resellers standing in thrift stores, estate sales, or storage units need immediate numbers, not advertising clutter.
          </p>
        </div>

        <div class="rounded-lg border border-hairline bg-canvas p-5 space-y-2">
          <h3 class="text-heading-4 font-bold text-ink flex items-center gap-2">
            <span class="text-primary font-mono text-ui-label">2.</span>
            <span>Strict Zero-Hallucination Rate Integrity</span>
          </h3>
          <p class="text-body-sm text-body leading-relaxed">
            We never guess, invent, or approximate platform fee rates. Every rate, category ladder, and payment surcharge is tied directly to an official marketplace seller policy URL and verified by date. If official verification is not available, our automated production build fails automatically.
          </p>
        </div>

        <div class="rounded-lg border border-hairline bg-canvas p-5 space-y-2">
          <h3 class="text-heading-4 font-bold text-ink flex items-center gap-2">
            <span class="text-primary font-mono text-ui-label">3.</span>
            <span>Sub-Second Static Performance (Astro SSG)</span>
          </h3>
          <p class="text-body-sm text-body leading-relaxed">
            Built using modern Static Site Generation (SSG). We ship pre-rendered HTML and minimal client-side islands. Our pages achieve perfect Core Web Vitals, sub-second First Contentful Paint, and zero cumulative layout shift (CLS = 0).
          </p>
        </div>

        <div class="rounded-lg border border-hairline bg-canvas p-5 space-y-2">
          <h3 class="text-heading-4 font-bold text-ink flex items-center gap-2">
            <span class="text-primary font-mono text-ui-label">4.</span>
            <span>Local Browser Privacy First</span>
          </h3>
          <p class="text-body-sm text-body leading-relaxed">
            All calculations occur inside your local browser runtime. Your sale prices, item acquisition costs, and net profit margins are never transmitted to our servers or stored in any remote database. Read our full <a href="/privacy/" class="text-primary hover:underline font-semibold">Privacy Policy</a>.
          </p>
        </div>

        <div class="rounded-lg border border-hairline bg-canvas p-5 space-y-2">
          <h3 class="text-heading-4 font-bold text-ink flex items-center gap-2">
            <span class="text-primary font-mono text-ui-label">5.</span>
            <span>WCAG AA Accessible by Design</span>
          </h3>
          <p class="text-body-sm text-body leading-relaxed">
            Every input field, tabular result, button, and navigation element satisfies WCAG 2.1 AA accessibility standards, featuring high contrast ratios, semantic ARIA landmarks, complete keyboard navigability, and full screen-reader support.
          </p>
        </div>
      </div>
    </section>

    <!-- Platforms Covered & Expansion Roadmap -->
    <section class="space-y-6 border-t border-hairline pt-8">
      <div class="space-y-2">
        <h2 class="text-heading-2 font-bold text-ink">Platforms Covered &amp; Roadmap</h2>
        <p class="text-body text-body leading-relaxed">
          Seller Calc Hub currently models fee structures across major marketplaces, with ongoing research to expand our coverage:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {supportedPlatforms.map((platform) => (
          <a
            href={platform.href}
            class="group block p-5 rounded-lg border border-hairline bg-canvas hover:border-primary transition-all shadow-xs"
          >
            <div class="flex items-center justify-between gap-2 mb-1.5">
              <span class="text-heading-4 font-bold text-ink group-hover:text-primary transition-colors">
                {platform.name}
              </span>
              <span class="text-micro font-bold px-2 py-0.5 rounded-xxs bg-mint-50 dark:bg-mint-200/10 text-primary border border-mint-200">
                {platform.status}
              </span>
            </div>
            <p class="text-caption text-body leading-relaxed">
              {platform.focus}
            </p>
          </a>
        ))}
      </div>

      <div class="p-4 rounded-lg border border-dashed border-hairline-strong bg-canvas-soft text-body-sm text-body space-y-1">
        <p class="font-bold text-ink">Upcoming Platform Coverage on Our Roadmap:</p>
        <p>
          We are actively developing fee models for <strong>Amazon Seller Central (FBA &amp; FBM)</strong>, <strong>Poshmark</strong>, <strong>Mercari</strong>, and <strong>Shopify Payments</strong>. Have a specific marketplace request? <a href="/contact/" class="text-primary hover:underline font-semibold">Let our engineering team know</a>.
        </p>
      </div>
    </section>

    <!-- Engineering & Automated Quality Pipeline -->
    <section class="space-y-4 border-t border-hairline pt-8">
      <h2 class="text-heading-2 font-bold text-ink">Continuous Verification &amp; Engineering Rigor</h2>
      <div class="text-body text-body leading-relaxed space-y-3">
        <p>
          Maintaining accurate fee calculators requires continuous testing. Every calculation formula in our codebase is governed by an automated test suite containing over <strong>320 vitest unit tests</strong>. We test complex boundary conditions, including eBay category ladders, $7,500 tier caps, Etsy Offsite Ads 10,000 threshold triggers, and UK VAT calculations.
        </p>
        <p>
          Our automated build pipeline runs strict linters and content guards on every commit to prevent data discrepancies, layout shifts, or duplicate content. When a platform modifies its fee policy, we update our source datasets, document the change in our public <a href="/fee-changes/" class="text-primary hover:underline font-semibold">Fee Changes Changelog</a>, and deploy refreshed calculations within 24 to 48 hours.
        </p>
      </div>
    </section>

    <!-- Disclaimer Callout -->
    <FeeDisclaimer />

    <!-- Navigation Footer -->
    <section class="border-t border-hairline pt-6 flex flex-wrap items-center justify-between gap-4 text-ui-sm font-bold text-primary">
      <div class="flex flex-wrap items-center gap-6">
        <a href="/methodology/" class="hover:underline min-h-[44px] inline-flex items-center gap-1.5">
          <span>Read Verification Methodology</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/fee-changes/" class="hover:underline min-h-[44px] inline-flex items-center gap-1.5">
          <span>View Policy Changelog</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <a href="/contact/" class="hover:underline min-h-[44px] inline-flex items-center gap-1.5">
        <span>Contact Editorial Team</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </section>
  </div>
</BaseLayout>
