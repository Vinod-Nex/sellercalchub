---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Calculation Disclaimer' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Seller Calc Hub Fee Calculation & Estimates Disclaimer',
  url: 'https://sellercalchub.com/disclaimer/',
  description:
    'Official fee calculation and estimates disclaimer for Seller Calc Hub: rate verification, tax nuances, and independent marketplace policies.',
};

const supportedMarketplaces = [
  { name: 'Whatnot Fee Calculator', href: '/whatnot-fee-calculator/' },
  { name: 'TikTok Shop Fee Calculator', href: '/tiktok-shop-fee-calculator/' },
  { name: 'Depop Fee Calculator', href: '/depop-fee-calculator/' },
  { name: 'Etsy Fee Calculator', href: '/etsy-fee-calculator/' },
  { name: 'eBay Fee Calculator (US)', href: '/ebay-fee-calculator/' },
  { name: 'eBay Fee Calculator (UK)', href: '/ebay-fee-calculator-uk/' },
  { name: 'Twitch Bits to USD Converter', href: '/twitch-bits-to-usd/' },
  { name: 'Multi-Marketplace Comparison Hub', href: '/marketplace-fee-calculators/' },
];
---

<BaseLayout
  title="Fee Calculation & Estimates Disclaimer - Seller Calc Hub"
  description="Official fee calculation and estimates disclaimer for Seller Calc Hub: rate verification, tax nuances, and independent marketplace policies."
  canonicalPath="/disclaimer/"
  structuredData={structuredData}
>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-xs bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/40 text-caption text-amber-800 dark:text-amber-300 font-bold">
        <span>Financial &amp; Estimation Policy</span>
      </div>

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        Fee Calculation &amp; Estimates Disclaimer
      </h1>

      <p class="text-body-lg text-body leading-relaxed">
        Seller Calc Hub is a free educational and business planning utility designed to give online resellers and marketplace sellers fast, transparent estimates of platform fees, processing costs, and profit margins.
      </p>
    </header>

    <!-- Main Content Sections -->
    <div class="space-y-8 border-t border-hairline pt-8">
      <!-- Section 1: Nature of Estimates -->
      <section class="space-y-4">
        <h2 class="text-heading-2 font-bold text-ink">1. Nature of Calculations &amp; Estimates</h2>
        <div class="text-body-md text-body leading-relaxed space-y-3">
          <p>
            All figures, calculations, margins, return on investment (ROI) metrics, and break-even sale prices generated by Seller Calc Hub are <strong>estimates for business simulation and planning purposes only</strong>.
          </p>
          <p>
            Our calculators do not constitute legal, tax, accounting, or professional financial advice. While we strive to maintain 100% precision with officially published marketplace rate schedules, individual transaction fees assessed on your seller account may vary due to multiple factors beyond standard base percentage schedules.
          </p>
        </div>
      </section>

      <!-- Section 2: Factors That May Cause Fee Variations -->
      <section class="space-y-4">
        <h2 class="text-heading-2 font-bold text-ink">2. Why Actual Fees May Differ</h2>
        <div class="text-body-md text-body leading-relaxed space-y-3">
          <p>
            Real-world marketplace invoices and payout deductions can differ from estimates due to:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-body-sm text-body">
            <li>
              <strong>Buyer State &amp; Local Sales Tax:</strong> Marketplaces like eBay and Etsy charge transaction or payment processing percentages on the gross order total including sales tax collected by marketplace facilitator laws. Sales tax rates vary by buyer jurisdiction (typically 0% to 10%+).
            </li>
            <li>
              <strong>Category-Specific Surcharges &amp; Tiers:</strong> Platforms apply tiered rates for specific categories (e.g. musical instruments, sneakers over $150, heavy equipment, jewelry). Our category selector models standard published tiers, but sub-category nuances may apply.
            </li>
            <li>
              <strong>Seller Performance Standards:</strong> Below-standard seller ratings or high "Item Not as Described" return metrics can trigger platform penalties (such as eBay's 5% below-standard final value fee penalty).
            </li>
            <li>
              <strong>Promoted Listings &amp; Ad Spends:</strong> Dynamic ad rates, Etsy Offsite Ads (12% vs 15%), and automated CPC campaigns fluctuate dynamically based on seller configuration and sales attribution.
            </li>
            <li>
              <strong>International &amp; Currency Conversion Fees:</strong> Cross-border sales often incur additional foreign exchange or international payment processing fees (e.g. 1.5% to 3.0%).
            </li>
          </ul>
        </div>
      </section>

      <!-- Section 3: Marketplace Independence & Trademarks -->
      <section class="space-y-4">
        <h2 class="text-heading-2 font-bold text-ink">3. Independence &amp; Trademark Disclaimers</h2>
        <div class="text-body-md text-body leading-relaxed space-y-3">
          <p>
            Seller Calc Hub (<code>sellercalchub.com</code>) is an entirely independent software utility. We are not affiliated with, authorized, maintained, sponsored, or in any way officially connected with:
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
            <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
              eBay Inc.
            </div>
            <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
              Etsy, Inc.
            </div>
            <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
              Depop Ltd.
            </div>
            <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
              Whatnot Inc.
            </div>
            <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
              ByteDance / TikTok
            </div>
            <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
              Twitch Interactive Inc.
            </div>
          </div>
          <p class="text-caption text-muted pt-2">
            All marketplace names, logos, registered trademarks, and brand marks belong exclusively to their respective owners. Their mention on this website is solely for nominative identification and descriptive reference under fair use.
          </p>
        </div>
      </section>

      <!-- Section 4: Rate Verification & Audit Policy -->
      <section class="space-y-4">
        <h2 class="text-heading-2 font-bold text-ink">4. How We Audit &amp; Verify Rates</h2>
        <div class="text-body-md text-body leading-relaxed space-y-3">
          <p>
            We enforce a strict <strong>Zero Invented Rates</strong> rule: every percentage, fixed fee, and category threshold in our codebase is directly linked to an official primary marketplace URL and tagged with an audit verification date.
          </p>
          <p>
            Our automated fee freshness pipeline scans fee datasets monthly. For complete details on our sourcing criteria and audit standards, read our full{' '}
            <a href="/methodology/" class="text-primary hover:underline font-bold">
              Fee Methodology &amp; Sources documentation
            </a>.
          </p>
        </div>
      </section>

      <!-- Section 5: Corrections & Reporting -->
      <section class="space-y-4 border-t border-hairline pt-8">
        <h2 class="text-heading-2 font-bold text-ink">5. Report a Rate Discrepancy</h2>
        <p class="text-body-md text-body leading-relaxed">
          Marketplace fee structures change regularly. If you identify a recent policy update, an unannounced fee adjustment, or a calculation difference on your seller account, please alert our editorial and engineering team:
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href="/report-fee/"
            class="inline-flex items-center justify-center px-5 py-2.5 min-h-[44px] bg-forest hover:bg-primary-deep text-white font-bold text-ui-label rounded-xs transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            <span>Report a Wrong Fee</span>
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-5 py-2.5 min-h-[44px] bg-canvas border border-hairline-strong hover:border-primary text-ink font-bold text-ui-label rounded-xs transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            <span>Contact Editorial Support</span>
          </a>
        </div>
      </section>

      <!-- Section 6: Marketplace Calculators Directory -->
      <section class="space-y-4 border-t border-hairline pt-8">
        <h2 class="text-heading-2 font-bold text-ink">Explore Marketplace Calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {supportedMarketplaces.map((item) => (
            <a
              href={item.href}
              class="flex items-center justify-between p-3.5 rounded-sm border border-hairline bg-canvas hover:border-primary transition-colors text-body-sm font-semibold text-ink group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              <span>{item.name}</span>
              <span class="text-muted group-hover:text-primary transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
