---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorIsland from '../components/CalculatorIsland.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TrustHeader from '../components/TrustHeader.astro';
import FormulaBlock from '../components/FormulaBlock.astro';
import WorkedExample from '../components/WorkedExample.astro';
import EdgeCases from '../components/EdgeCases.astro';
import AuthorByline from '../components/AuthorByline.astro';
import FAQ from '../components/FAQ.astro';
import RelatedCalculators from '../components/RelatedCalculators.astro';
import LastVerified from '../components/LastVerified.astro';
import { getPageSeo } from '../lib/seo';

const seo = getPageSeo('/depop-fee-calculator/');

// FAQ definitions
const faqs = [
  {
    question: 'Does Depop charge selling fees?',
    answer:
      'Depop eliminated its 10% selling fee for US and UK sellers. In the US, Depop charges zero selling fee to the seller, but standard payment processing fees (3.3% + $0.45 via Depop Payments) apply to the total transaction amount.',
  },
  {
    question: 'How much are Depop payment processing fees in the US?',
    answer:
      'Depop Payments in the US charges 3.3% of the total order value (item price + shipping + applicable sales tax) plus a fixed $0.45 per transaction.',
  },
  {
    question: 'Does Depop charge listing fees?',
    answer:
      'No. Depop has no listing fees or subscription fees. You can list as many vintage, streetwear, and second-hand items as you want for free.',
  },
  {
    question: 'Who pays for shipping on Depop?',
    answer:
      'Sellers can choose "Ship with Depop" (using prepaid USPS labels where either buyer or seller pays) or arrange their own custom shipping. If the seller offers free shipping, the cost of the label comes out of their sale earnings.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Depop Fee & Profit Calculator',
    url: 'https://sellercalchub.com/depop-fee-calculator/',
    description: seo.metaDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Depop Seller Fee Calculator',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'All',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={seo.title}
  description={seo.metaDescription}
  canonicalPath="/depop-fee-calculator/"
  structuredData={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'All Calculators', href: '/marketplace-fee-calculators/' },
        { name: 'Depop Fee Calculator' },
      ]}
    />

    <!-- Header & Direct Answer in First Paragraph -->
    <header class="space-y-4">
      <TrustHeader platform="depop" />

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>

      <p class="text-body-lg text-body leading-relaxed max-w-3xl">
        Depop charges a <strong class="text-ink">0% selling fee</strong> for US and UK sellers. US sellers only pay standard <strong class="text-ink">Depop Payments processing of 3.3% + $0.45</strong> on the total buyer payment (including shipping and applicable sales tax). Listing items is completely free with no monthly subscription charges or insertion fees. An optional 8.0% fee applies only if you choose to boost your listings. Enter your listing price and packaging costs below to calculate your exact take-home earnings.
      </p>
    </header>

    <!-- 2. Calculator Island Above the Fold -->
    <section aria-label="Depop Fee Calculator Island">
      <CalculatorIsland platform="depop" showPlatformTabs={false} />
    </section>

    <!-- 3. Formula Block -->
    <FormulaBlock platform="depop" />

    <!-- 4. One Worked Example -->
    <WorkedExample
      platform="depop"
      title="Worked Example: Selling a $35 Vintage Item on Depop"
      description="Here is how Depop Payments processes a typical $35.00 vintage clothing sale with $10.00 sourcing and $4.50 postage:"
      itemPrice={35.0}
      itemCost={10.0}
      shippingCharged={0.0}
      shippingCost={4.5}
    />

    <!-- 5. Edge Cases -->
    <EdgeCases platform="depop" />

    <!-- 6. FAQ Accordion -->
    <FAQ
      items={faqs}
      title="Frequently Asked Questions About Depop Fees"
      description="Answers to common questions about Depop's 0% selling fee policy, payments, and boosted listings."
    />

    <!-- 7. Related Calculators -->
    <RelatedCalculators currentPlatform="depop" />

    <!-- Trust signals footer -->
    <AuthorByline platform="depop" />
    <LastVerified platform="depop" />
  </div>
</BaseLayout>
