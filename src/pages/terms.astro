---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FeeDisclaimer from '../components/FeeDisclaimer.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Terms of Service' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Terms of Service & Fee Disclaimer - Seller Calc Hub',
    url: 'https://sellercalchub.com/terms/',
    description:
      'Terms of Service and fee disclaimer for Seller Calc Hub: fee calculation estimates only, non-affiliation, permissible use, and embeddable widget terms.',
    publisher: {
      '@type': 'Organization',
      name: 'Seller Calc Hub',
      url: 'https://sellercalchub.com/',
      logo: 'https://sellercalchub.com/favicon.svg',
    },
  },
  buildBreadcrumbSchema(breadcrumbs, '/terms/'),
];
---

<BaseLayout
  title="Terms of Service & Fee Disclaimer - Seller Calc Hub"
  description="Terms of Service and fee disclaimer for Seller Calc Hub: fee calculation estimates only, non-affiliation, permissible use, and embeddable widget terms."
  canonicalPath="/terms/"
  structuredData={structuredData}
>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-xs bg-mint-50 dark:bg-mint-200/10 border border-mint-200 text-caption text-primary font-bold">
        <span>Legal Terms &amp; Conditions</span>
      </div>

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        Terms of Service &amp; Fee Disclaimer
      </h1>

      <p class="text-body-sm text-muted">
        Last Updated &amp; Effective Date: <strong class="text-ink">November 23, 2026</strong>
      </p>

      <p class="text-body-lg text-body leading-relaxed">
        Please read these Terms of Service carefully before utilizing SellerCalcHub.com (“Seller Calc Hub”, “the Site”, “we”, “our”). By accessing, using, or embedding our calculation utilities and content, you agree to be bound by these terms.
      </p>
    </header>

    <!-- Prominent Disclaimer Card -->
    <FeeDisclaimer />

    <!-- Terms Sections -->
    <div class="space-y-10 border-t border-hairline pt-8 text-body text-body leading-relaxed">
      <!-- Section 1: Estimates Only -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">1. Calculations Are Estimates Only (Check the Platform's Own Page)</h2>
        <p>
          All calculations, fee breakdowns, effective commission rates, profit margins, return on investment (ROI) metrics, and break-even sales prices generated by Seller Calc Hub are <strong>mathematical simulations provided for educational, simulation, and business planning purposes only</strong>.
        </p>
        <p>
          While we make every commercially reasonable effort to audit and verify our rate schedules against officially published marketplace seller handbooks (as detailed in our <a href="/methodology/" class="text-primary hover:underline font-semibold">Verification Methodology</a>), real-world marketplace transactions are subject to variable factors beyond our control, including but not limited to:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-body-sm">
          <li><strong>Destination-Based Buyer Sales Tax:</strong> Marketplaces like eBay, Etsy, and Whatnot assess percentage transaction and payment processing fees on the gross order total, which includes state and local sales taxes collected under marketplace facilitator laws;</li>
          <li><strong>Seller Account Rating Penalties:</strong> Performance tier deductions (such as eBay's 5% Below Standard final value fee penalty);</li>
          <li><strong>Unannounced Platform Fee Hikes:</strong> Category reclassifications, promotional waivers, or interim schedule updates announced by platforms between our audit cycles;</li>
          <li><strong>Voluntary Advertising Fees:</strong> Deductions for optional campaigns (such as Etsy Offsite Ads at 12% to 15%, eBay Promoted Listings, or Depop Boosted items);</li>
          <li><strong>Postage Label Surcharges:</strong> Dimensional weight adjustments, carrier residential delivery fees, signature confirmation fees, and currency conversion spreads.</li>
        </ul>
        <p class="font-bold text-ink bg-canvas-soft border border-hairline p-4 rounded-lg">
          Always consult your official marketplace seller statements, invoices, and transaction histories before finalizing product pricing or making inventory acquisition commitments.
        </p>
      </section>

      <!-- Section 2: No Professional Advice -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">2. No Accounting, Tax, or Legal Advice</h2>
        <p>
          Seller Calc Hub is a financial calculation utility, not a certified public accounting (CPA) firm, registered investment advisor, tax specialist, or legal counselor. Nothing published on this Site constitutes professional financial, tax, or legal advice.
        </p>
        <p class="text-body-sm text-body">
          Ecommerce taxation regulations—including IRS Form 1099-K reporting thresholds, state economic nexus thresholds, and value-added tax (VAT) obligations—differ substantially by region and business structure. You should consult a licensed certified public accountant (CPA) or tax attorney regarding your specific business tax obligations.
        </p>
      </section>

      <!-- Section 3: Non-Affiliation & Trademarks -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">3. Marketplace Trademark &amp; Non-Affiliation Disclaimer</h2>
        <p>
          Seller Calc Hub is an entirely independent software utility. We are not affiliated with, sponsored by, authorized by, endorsed by, or in any way officially connected with:
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
          <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
            eBay Inc.
          </div>
          <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
            Etsy, Inc.
          </div>
          <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
            Whatnot, Inc.
          </div>
          <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
            ByteDance Ltd. / TikTok Inc.
          </div>
          <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
            Depop Limited
          </div>
          <div class="p-3 rounded-xs border border-hairline bg-canvas-soft text-caption text-ink font-semibold text-center">
            Twitch Interactive / Amazon
          </div>
        </div>
        <p class="text-caption text-muted pt-2">
          All registered trademarks, brand names, product logos, and platform references mentioned on this website belong exclusively to their respective trademark owners. Their mention on Seller Calc Hub is strictly for nominative fair use to describe and identify third-party fee structures for resellers.
        </p>
      </section>

      <!-- Section 4: Embeddable Calculator Widgets -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">4. Embeddable Calculator Widgets Terms of Use</h2>
        <p>
          Seller Calc Hub makes available responsive calculator widgets (accessible via our <a href="/embed/ebay-fee-calculator/" class="text-primary hover:underline font-semibold">Embed Utilities</a>) that webmasters, reseller bloggers, and tool directories may embed on their own websites via an HTML iframe. By embedding our calculators, you agree to the following conditions:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-body-sm">
          <li><strong>Attribution Requirement:</strong> You must retain the embedded widget's footer attribution link back to SellerCalcHub.com;</li>
          <li><strong>No Content Tampering:</strong> You may not modify, tamper with, or conceal the calculation formulas, disclaimer notices, or source citations rendered within the widget;</li>
          <li><strong>No Paywalling:</strong> You may not place the embedded calculator behind a paid paywall or require users to provide payment to access the calculator;</li>
          <li><strong>Revocation Right:</strong> We reserve the right to restrict or disable embed delivery to websites that violate these terms, engage in deceptive spam, or host malicious content.</li>
        </ul>
      </section>

      <!-- Section 5: Permissible Use -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">5. Permissible Use &amp; Intellectual Property</h2>
        <p>
          Seller Calc Hub is free for personal, commercial, and educational use by online sellers, resellers, and ecommerce businesses. You are permitted to use our calculators to evaluate pricing for your own inventory, publish summary insights, or calculate business margins.
        </p>
        <p class="text-body-sm text-body">
          You agree not to engage in malicious scraping, denial-of-service (DDoS) attacks, automated bot traffic that impairs website availability for other sellers, or unauthorized reverse-engineering of our proprietary source code.
        </p>
      </section>

      <!-- Section 6: User Submissions & Feedback -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">6. User Submissions &amp; Rate Corrections</h2>
        <p>
          When you submit marketplace fee corrections, policy announcements, or suggestions through our <a href="/report-fee/" class="text-primary hover:underline font-semibold">Fee Reporting tool</a> or <a href="/contact/" class="text-primary hover:underline font-semibold">Contact page</a>, you grant Seller Calc Hub a perpetual, irrevocable, royalty-free license to verify, integrate, publish, and utilize such factual fee data across our platform for the benefit of the reselling community.
        </p>
      </section>

      <!-- Section 7: Limitation of Liability -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">7. Limitation of Liability &amp; "As Is" Warranty</h2>
        <p>
          TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, SELLER CALC HUB, ITS DEVELOPERS, EDITORS, CONTRIBUTORS, AND OPERATORS DISCLAIM ALL WARRANTIES OF ANY KIND, WHETHER EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE IMPLIED WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND ACCURACY.
        </p>
        <p class="text-body-sm text-muted">
          Under no circumstances shall Seller Calc Hub or its operators be liable for any direct, indirect, incidental, special, consequential, or punitive damages (including, without limitation, lost profits, inventory losses, tax penalties, marketplace seller suspensions, or discrepancies between our calculated estimates and your actual marketplace bank deposits) arising from your use of or reliance upon this website.
        </p>
      </section>

      <!-- Section 8: Indemnification -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">8. Indemnification</h2>
        <p>
          You agree to defend, indemnify, and hold harmless Seller Calc Hub, its owners, and contributors against any claims, liabilities, losses, damages, and expenses (including reasonable attorney fees) arising from your violation of these Terms of Service or your commercial listing decisions on third-party marketplace platforms.
        </p>
      </section>

      <!-- Section 9: Governing Law & Severability -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">9. Governing Law &amp; Severability</h2>
        <p>
          These Terms of Service are governed by and construed in accordance with the laws of the United States. If any provision of these Terms is held to be invalid or unenforceable, that provision shall be enforced to the maximum extent permissible, and the remaining provisions shall remain in full force and effect.
        </p>
      </section>

      <!-- Section 10: Modifications -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">10. Modifications to Terms</h2>
        <p>
          We reserve the right to revise these Terms of Service at any time. When modifications are made, the “Last Updated” date at the top of this document will be revised accordingly. Continued use of the website following any changes constitutes your binding acceptance of the updated terms.
        </p>
      </section>

      <!-- Section 11: Contact Information -->
      <section class="space-y-4">
        <h2 class="text-heading-2 font-bold text-ink">11. Legal Inquiries &amp; Copyright Notices</h2>
        <p>
          For legal inquiries, copyright notices, or questions regarding these Terms of Service, please contact our administrative team:
        </p>
        <div class="p-5 rounded-lg border border-hairline bg-canvas font-mono text-ui-sm text-ink space-y-2">
          <p>
            <strong>Legal Department:</strong> <a href="mailto:legal@sellercalchub.com" class="text-primary hover:underline font-bold">legal@sellercalchub.com</a>
          </p>
          <p class="text-caption font-sans text-muted">
            Seller Calc Hub Legal Affairs · SellerCalcHub.com · Independent Reseller Utility
          </p>
        </div>
      </section>
    </div>

    <!-- Navigation Footer -->
    <section class="border-t border-hairline pt-6 flex flex-wrap items-center justify-between gap-4 text-ui-sm font-bold text-primary">
      <div class="flex flex-wrap items-center gap-6">
        <a href="/privacy/" class="hover:underline min-h-[44px] inline-flex items-center gap-1.5">
          <span>Privacy Policy</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/disclaimer/" class="hover:underline min-h-[44px] inline-flex items-center gap-1.5">
          <span>Calculation Disclaimer</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <a href="/contact/" class="hover:underline min-h-[44px] inline-flex items-center gap-1.5">
        <span>Contact Legal Team</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </section>
  </div>
</BaseLayout>
