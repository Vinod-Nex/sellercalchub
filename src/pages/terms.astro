---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FeeDisclaimer from '../components/FeeDisclaimer.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Terms of Service' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Terms of Service & Fee Disclaimer - Seller Calc Hub',
    url: 'https://sellercalchub.com/terms/',
    description:
      'Terms of Service and official Fee Disclaimer for Seller Calc Hub: fee estimates only, non-affiliation, and limitation of liability.',
  },
  buildBreadcrumbSchema(breadcrumbs, '/terms/'),
];
---

<BaseLayout
  title="Terms of Service & Fee Disclaimer - Seller Calc Hub"
  description="Terms of Service and official Fee Disclaimer for Seller Calc Hub: fee estimates only, non-affiliation, and limitation of liability."
  canonicalPath="/terms/"
  structuredData={structuredData}
>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-xs bg-mint-50 dark:bg-mint-200/10 border border-mint-200 text-caption text-primary font-bold">
        <span>Legal Terms &amp; Conditions</span>
      </div>

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        Terms of Service &amp; Fee Disclaimer
      </h1>

      <p class="text-body-sm text-muted">
        Last Updated &amp; Effective Date: <strong class="text-ink">November 22, 2026</strong>
      </p>

      <p class="text-body-lg text-body leading-relaxed">
        Please read these Terms of Service carefully before utilizing SellerCalcHub.com (“Seller Calc Hub”, “the Site”, “we”, “our”). By accessing or using our calculation utilities and content, you agree to be bound by these terms.
      </p>
    </header>

    <!-- Prominent Disclaimer Card -->
    <FeeDisclaimer />

    <!-- Terms Sections -->
    <div class="space-y-8 border-t border-hairline pt-8 text-body text-body leading-relaxed">
      <!-- Section 1: Estimates Only -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">1. Calculations Are Estimates Only (Check the Platform's Own Page)</h2>
        <p>
          All calculations, fee breakdowns, effective fee rates, profit margins, ROI metrics, and break-even sales prices generated by Seller Calc Hub are <strong>estimates provided for educational, simulation, and business planning purposes only</strong>.
        </p>
        <p>
          While we make every commercially reasonable effort to audit and verify our rate schedules against officially published marketplace seller handbooks (as detailed in our <a href="/methodology/" class="text-primary hover:underline font-semibold">Verification Methodology</a>), real-world marketplace transactions are subject to variable factors beyond our control, including but not limited to:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-body-sm">
          <li>Destination-based state and local sales taxes collected from the buyer (which platforms like eBay and Etsy include when assessing transaction and processing fees);</li>
          <li>Seller performance status (e.g. Below Standard penalties, Top Rated Plus discounts);</li>
          <li>Unannounced marketplace fee schedule changes, category reclassifications, or promotional fee waivers;</li>
          <li>Voluntary advertising deductions (e.g. Etsy Offsite Ads, eBay Promoted Listings, Depop Boosted items);</li>
          <li>Dimensional weight carrier surcharges, return shipping label disputes, and currency exchange spreads.</li>
        </ul>
        <p class="font-bold text-ink">
          Always consult your official marketplace seller statements and transaction history before making financial, inventory purchasing, or pricing decisions.
        </p>
      </section>

      <!-- Section 2: No Professional Advice -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">2. No Accounting, Tax, or Legal Advice</h2>
        <p>
          Seller Calc Hub is a mathematical simulation utility. Nothing published on this Site constitutes certified public accounting (CPA), tax, investment, or legal advice. Online selling tax regulations (including 1099-K reporting thresholds and sales tax nexus obligations) vary significantly across jurisdictions. You should consult a licensed tax advisor or certified accountant regarding your specific business tax liabilities.
        </p>
      </section>

      <!-- Section 3: Non-Affiliation & Trademarks -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">3. Marketplace Trademark &amp; Non-Affiliation Disclaimer</h2>
        <p>
          Seller Calc Hub is an independent software tool. We are not affiliated with, authorized by, sponsored by, or in any way officially connected with:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-body-sm">
          <li><strong>eBay Inc.</strong> or any of its subsidiaries;</li>
          <li><strong>Etsy, Inc.</strong>;</li>
          <li><strong>Whatnot, Inc.</strong>;</li>
          <li><strong>ByteDance Ltd. / TikTok Inc.</strong>;</li>
          <li><strong>Depop Limited</strong>;</li>
          <li><strong>Twitch Interactive, Inc. / Amazon.com, Inc.</strong></li>
        </ul>
        <p class="text-caption text-muted">
          All registered trademarks, logos, brand names, and platform references mentioned on this website belong exclusively to their respective owners. Their mention on Seller Calc Hub is solely for descriptive, comparative, and nominative fair use identification purposes.
        </p>
      </section>

      <!-- Section 4: Limitation of Liability -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">4. Limitation of Liability</h2>
        <p>
          To the maximum extent permitted by applicable law, Seller Calc Hub, its developers, contributors, and operators shall not be liable for any direct, indirect, incidental, special, consequential, or punitive damages resulting from your use of or inability to use the calculators or data on this website.
        </p>
        <p class="text-body-sm text-muted">
          This includes, without limitation, lost profits, inventory losses, tax penalties, marketplace suspensions, or discrepancies between our calculated estimates and the actual payout deposited by any marketplace.
        </p>
      </section>

      <!-- Section 5: Permissible Use -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">5. Permissible Use &amp; Intellectual Property</h2>
        <p>
          Seller Calc Hub is free for personal, commercial, and educational use by online sellers, resellers, and ecommerce businesses. You may use our calculators to evaluate pricing for your own store inventory.
        </p>
        <p>
          You agree not to engage in malicious scraping, denial-of-service attacks, automated bot traffic that degrades website availability for other users, or unauthorized framing of our calculators without written consent.
        </p>
      </section>

      <!-- Section 6: Modifications -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">6. Modifications to Terms</h2>
        <p>
          We reserve the right to revise these Terms of Service at any time. When modifications are made, the “Last Updated” date at the top of this document will be updated accordingly. Continued use of the website following any changes constitutes your acceptance of the updated terms.
        </p>
      </section>

      <!-- Section 7: Contact Information -->
      <section class="space-y-3">
        <h2 class="text-heading-2 font-bold text-ink">7. Questions &amp; Legal Inquiries</h2>
        <p>
          For legal inquiries, copyright notices, or questions regarding these Terms, please contact our administrative team:
        </p>
        <div class="p-4 rounded-lg border border-hairline bg-canvas font-mono text-ui-sm text-ink">
          <p>Email: <a href="mailto:legal@sellercalchub.com" class="text-primary hover:underline font-bold">legal@sellercalchub.com</a></p>
          <p class="text-caption font-sans text-muted mt-1">Seller Calc Hub Legal Affairs · SellerCalcHub.com</p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
