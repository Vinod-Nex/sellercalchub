---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalculatorIsland from "../components/CalculatorIsland.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustHeader from "../components/TrustHeader.astro";
import FormulaBlock from "../components/FormulaBlock.astro";
import WorkedExample from "../components/WorkedExample.astro";
import EdgeCases from "../components/EdgeCases.astro";
import FAQ from "../components/FAQ.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import LastVerified from "../components/LastVerified.astro";
import AuthorByline from "../components/AuthorByline.astro";
import { getPageSeo } from "../lib/seo";
import { buildCalculatorStructuredData } from "../lib/schema";

const seo = getPageSeo("/ebay-fee-calculator-uk/");

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "All Calculators", href: "/marketplace-fee-calculators/" },
  { name: "eBay UK Fee Calculator" },
];

// FAQ definitions
const faqs = [
  {
    question: "Is selling on eBay UK really 100% free for private sellers?",
    answer:
      "Yes. For private individual sellers residing in the UK, eBay eliminated all Final Value Fees and insertion fees across almost all categories (including Fashion, Electronics, Home & Garden, and Collectibles). You keep 100% of the item sale price and shipping charged. You only pay if you choose optional listing upgrades (such as reserve prices or subtitles) or opt into Promoted Listings.",
  },
  {
    question: "Which categories are excluded from 0% private seller fees?",
    answer:
      "The only major exclusion is the Motors category (Cars, Motorcycles, Aircraft, Boats, and Commercial Vehicles), which still incurs standard insertion fees and transaction fees. All other typical resale and household categories are completely free for private UK sellers.",
  },
  {
    question: "How does 20% UK VAT apply to eBay business seller fees?",
    answer:
      "Because UK business sellers contract with eBay (UK) Limited, HMRC requires eBay to charge 20% standard UK VAT on all business selling fees (Final Value Fees, per-order fees, and Promoted Listings). The advertised 12.8% fee plus £0.30 per order becomes an effective fee of 15.36% plus £0.36 per order when 20% VAT is included.",
  },
  {
    question:
      "Can VAT-registered businesses reclaim the VAT charged on eBay fees?",
    answer:
      "Yes. If your business is registered for UK VAT with HMRC, you can download monthly VAT invoices directly from your eBay Seller Hub and reclaim the 20% VAT paid on eBay fees as input tax on your quarterly VAT return.",
  },
  {
    question:
      "Does eBay UK charge any separate payment processing or PayPal fees?",
    answer:
      "No. Payment processing is completely handled through eBay Managed Payments and is bundled into the platform. Private sellers pay £0.00 for payment processing, and business sellers pay no extra gateway fees beyond their standard final value fee. Payouts deposit directly into your UK bank account in GBP (£).",
  },
];

// Structured Data
const structuredData = buildCalculatorStructuredData({
  name: seo.h1,
  url: "/ebay-fee-calculator-uk/",
  description: seo.metaDescription,
  currency: "GBP",
  breadcrumbs,
  faqs,
});
---

<BaseLayout
  title={seo.title}
  description={seo.metaDescription}
  canonicalPath="/ebay-fee-calculator-uk/"
  structuredData={structuredData}
>
  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 space-y-12">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header & Direct Answer in the First Paragraph -->
    <header class="space-y-4">
      <TrustHeader platform="ebay-uk" />

      <h1 class="text-display-lg md:text-display-xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>

      <p class="text-body-lg text-body max-w-3xl leading-relaxed">
        eBay UK charges private individual sellers <strong class="text-ink">0% final value fees</strong> across all eligible categories, making it completely free to sell personal items. Registered business sellers pay a standard <strong class="text-ink">12.8% final value fee plus a fixed £0.30 per order</strong>, subject to <strong class="text-ink">20% UK VAT on eBay fees</strong> (an effective 15.36% + £0.36 total charge per sale). Enter your sale price and costs below to calculate your exact net proceeds in GBP (£).
      </p>

      <!-- US vs UK Cross Link -->
      <div class="pt-1">
        <a
          href="/ebay-fee-calculator/"
          class="inline-flex items-center gap-1.5 min-h-[44px] py-2 text-primary hover:underline font-semibold text-ui-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary rounded-xxs"
        >
          <svg
            class="w-4 h-4"
            width="16"
            height="16"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z"
              clip-rule="evenodd"
            />
          </svg>
          <span>
            Selling in the United States? Check the US eBay Fee Calculator (USD $)
          </span>
        </a>
      </div>
    </header>

    <!-- 2. Calculator Island Above the Fold -->
    <section class="space-y-4" id="calculator">
      <CalculatorIsland platform="ebay-uk" showPlatformTabs={false} />
    </section>

    <!-- 3. Formula in Plain Text -->
    <FormulaBlock platform="ebay-uk" />

    <!-- 4. One Worked Example -->
    <WorkedExample
      platform="ebay-uk"
      title="Worked Example: £50 Item Sold in the UK"
      description="Here is the step-by-step breakdown of what you actually keep when selling an item for £50.00 with £4.00 buyer postage and £15.00 sourcing cost:"
      itemPrice={50.0}
      shippingCharged={4.0}
      itemCost={15.0}
      shippingCost={4.0}
    />

    <!-- 5. Edge Cases -->
    <EdgeCases platform="ebay-uk" />

    <!-- Private vs Business Comparison Guide -->
    <section class="space-y-4 border-t border-hairline pt-8">
      <h2 class="text-heading-2 font-bold text-ink">
        Private vs. Business Sellers on eBay UK
      </h2>
      <p class="text-body text-body leading-relaxed">
        The fee structure on eBay UK differs dramatically depending on your account registration status with HMRC and eBay:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Private Seller Card -->
        <div class="rounded-lg border-2 border-primary/30 bg-mint-50/50 dark:bg-mint-200/10 p-5 space-y-3">
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-xs bg-primary text-on-primary text-micro font-bold uppercase tracking-wider">
            Private Sellers (Individuals)
          </div>
          <h3 class="text-heading-3 font-bold text-ink">
            0% Final Value Fee (Free to Sell)
          </h3>
          <ul class="space-y-2 text-body-sm text-body list-disc pl-5">
            <li>
              <strong>Listing Fee:</strong> £0.00 (up to 300 free monthly listings).
            </li>
            <li>
              <strong>Final Value Fee:</strong> 0.0% on total order (item price + postage).
            </li>
            <li>
              <strong>Per-Order Fee:</strong> £0.00.
            </li>
            <li>
              <strong>Payment Processing:</strong> 100% free via eBay Managed Payments.
            </li>
            <li>
              <strong>VAT:</strong> Any optional listing upgrades (e.g., subtitle) are inclusive of 20% VAT.
            </li>
          </ul>
        </div>

        <!-- Business Seller Card -->
        <div class="rounded-lg border border-hairline-strong bg-canvas p-5 space-y-3">
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-xs bg-canvas-soft border border-hairline text-ink text-micro font-bold uppercase tracking-wider">
            Business Sellers (Commercial)
          </div>
          <h3 class="text-heading-3 font-bold text-ink">
            12.8% + £0.30 (+ 20% UK VAT)
          </h3>
          <ul class="space-y-2 text-body-sm text-body list-disc pl-5">
            <li>
              <strong>Base Final Value Fee:</strong> 12.8% (exclusive of VAT).
            </li>
            <li>
              <strong>Per-Order Fee:</strong> £0.30 per order (exclusive of VAT).
            </li>
            <li>
              <strong>HMRC VAT:</strong> 20% VAT added to all eBay fees billed to the seller.
            </li>
            <li>
              <strong>Effective Total Fee:</strong> 15.36% + £0.36 per order.
            </li>
            <li>
              <strong>VAT Recovery:</strong> VAT-registered businesses can reclaim this input VAT on HMRC returns.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. FAQ Section -->
    <FAQ
      items={faqs}
      title="Frequently Asked Questions About eBay UK Fees"
      description="Clear answers regarding eBay UK private seller exemptions, business rates, and HMRC VAT compliance."
    />

    <!-- 7. Related Calculators -->
    <RelatedCalculators currentPlatform="ebay-uk" />

    <!-- Trust signals footer -->
    <AuthorByline platform="ebay-uk" />
    <LastVerified platform="ebay-uk" />
  </div>
</BaseLayout>
