---
import montserratWoff2 from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonicalPath,
  ogImage = '/og-default.png',
  ogType = 'website',
  noindex = false,
  structuredData,
} = Astro.props;

// Ensure absolute canonical URL with trailing slash compliance pointing ONLY to the clean page
const siteUrl = Astro.site ? Astro.site.toString() : 'https://sellercalchub.com/';
const currentPath = canonicalPath ?? Astro.url.pathname;
const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const canonicalUrl = new URL(normalizedPath, siteUrl).toString();

// Check if query params exist during SSR/prerender
const hasQueryParams = Boolean(Astro.url.search && Astro.url.search.length > 1);

// Resolve absolute Open Graph image URL
const fullOgImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, siteUrl).toString();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Preload Critical Latin Variable Font (Zero CLS) -->
<link rel="preload" href={montserratWoff2} as="font" type="font/woff2" crossorigin="anonymous" />

<!-- Robots / Indexing: Query-parameter URLs carry noindex, follow; clean pages carry index, follow -->
{hasQueryParams ? (
  <meta name="robots" content="noindex, follow" />
) : noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Seller Calc Hub" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImageUrl} />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImageUrl} />

<!-- Theme Colors (Light & Dark) -->
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0c120f" media="(prefers-color-scheme: dark)" />

<!-- Favicon Set -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="any" />

<!-- Structured Data (JSON-LD) -->
{structuredData && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
)}

<!-- Synchronous Head Script: handles Theme (FOUC), Query-URL Robots/Canonical, and Flash Prevention -->
<script is:inline>
  (function () {
    // 1. Theme initialization (prevents FOUC)
    try {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      } else {
        document.documentElement.classList.add('light');
        document.documentElement.classList.remove('dark');
      }
    } catch {
      // Ignore theme storage errors
    }

    // 2. Query Parameter Handling: enforce noindex, follow, clean canonical, and prevent flash of default values
    try {
      if (typeof window !== 'undefined' && window.location.search && window.location.search.length > 1) {
        // Enforce noindex, follow on query-parameter URLs
        let robots = document.querySelector('meta[name="robots"]');
        if (!robots) {
          robots = document.createElement('meta');
          robots.setAttribute('name', 'robots');
          document.head.appendChild(robots);
        }
        robots.setAttribute('content', 'noindex, follow');

        // Enforce canonical points strictly to clean page without query parameters
        const canonical = document.querySelector('link[rel="canonical"]');
        if (canonical) {
          const cleanPath = window.location.pathname.endsWith('/')
            ? window.location.pathname
            : window.location.pathname + '/';
          canonical.setAttribute('href', window.location.origin + cleanPath);
        }

        // Add class to prevent flash of default values while calculator island restores state
        document.documentElement.classList.add('calc-restoring');

        // Safety fallback: ensure calc-restoring is cleared within 1s even under script delay
        setTimeout(function () {
          document.documentElement.classList.remove('calc-restoring');
        }, 1000);
      }
    } catch {
      // Ignore query parameter errors
    }
  })();
</script>
