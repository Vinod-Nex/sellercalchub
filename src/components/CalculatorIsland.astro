---
import {
  runCalculator,
  PLATFORM_CONFIGS,
  type PlatformId,
  type CalcResult,
} from '../lib/calc';
import MoneyInput from './inputs/MoneyInput.astro';
import PercentInput from './inputs/PercentInput.astro';
import SelectInput from './inputs/SelectInput.astro';
import ToggleSwitch from './inputs/ToggleSwitch.astro';
import StepperInput from './inputs/StepperInput.astro';
import ResultsPanel from './ResultsPanel.astro';

export interface Props {
  platform?: PlatformId;
  showPlatformTabs?: boolean;
  initialPrice?: number;
  initialShippingCharged?: number;
  initialItemCost?: number;
  initialShippingCost?: number;
  initialQuantity?: number;
  initialOptions?: Record<string, unknown>;
}

const {
  platform = 'whatnot',
  showPlatformTabs = true,
  initialPrice,
  initialShippingCharged,
  initialItemCost,
  initialShippingCost,
  initialQuantity,
  initialOptions,
} = Astro.props;

const config = PLATFORM_CONFIGS[platform] ?? PLATFORM_CONFIGS.whatnot;

const price = initialPrice ?? config.defaultPrice;
const shippingCharged = initialShippingCharged ?? config.defaultShippingCharged;
const itemCost = initialItemCost ?? config.defaultItemCost;
const shippingCost = initialShippingCost ?? config.defaultShippingCost;
const quantity = initialQuantity ?? config.defaultQuantity;
const options = initialOptions ?? config.defaultOptions;

// Pre-render the default calculation completely on the server
const serverResult: CalcResult = runCalculator(
  platform,
  {
    price,
    shippingCharged,
    itemCost,
    shippingCost,
    quantity,
  },
  options
);

const currencySymbol = config.currencySymbol;

const platformList: { id: PlatformId; label: string }[] = [
  { id: 'whatnot', label: 'Whatnot' },
  { id: 'tiktok-shop', label: 'TikTok Shop' },
  { id: 'depop', label: 'Depop' },
  { id: 'etsy', label: 'Etsy' },
  { id: 'ebay-us', label: 'eBay US' },
  { id: 'ebay-uk', label: 'eBay UK' },
  { id: 'twitch-bits', label: 'Twitch Bits' },
];
---

<seller-calculator
  class="block w-full"
  data-platform={platform}
  data-currency={config.defaultCurrency}
  data-symbol={currencySymbol}
>
  <div class="rounded-lg border border-hairline-strong bg-canvas p-6 md:p-8 shadow-level-3 space-y-8">
    <!-- Platform Switcher Tabs (Optional, works without JS via links or with JS via tabs) -->
    {
      showPlatformTabs && (
        <div class="border-b border-hairline pb-4">
          <label class="block text-eyebrow font-bold text-muted uppercase tracking-wider mb-2">
            Select Marketplace Platform
          </label>
          <div class="flex flex-wrap gap-2" role="tablist" aria-label="Marketplace Platforms">
            {platformList.map((p) => {
              const isActive = p.id === platform;
              return (
                <button
                  type="button"
                  role="tab"
                  data-platform-tab={p.id}
                  aria-selected={isActive ? 'true' : 'false'}
                  class:list={[
                    'px-4 py-2.5 min-h-[44px] inline-flex items-center justify-center text-ui-sm font-semibold rounded-xs border transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary',
                    isActive
                      ? 'bg-primary text-on-primary border-primary'
                      : 'bg-canvas-soft text-body border-hairline-strong hover:border-primary hover:text-ink',
                  ]}
                >
                  {p.label}
                </button>
              );
            })}
          </div>
        </div>
      )
    }

    <!-- Fallback Notice for Non-JS Browsers -->
    <noscript>
      <div class="p-3 bg-mint-50 dark:bg-mint-200/10 border border-mint-200 text-body text-caption rounded-sm">
        <strong>JavaScript is disabled.</strong> Showing default worked calculation results for {config.name}. Enable JavaScript for instant real-time calculation as you type.
      </div>
    </noscript>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Inputs Form -->
      <form class="lg:col-span-6 space-y-5" data-calculator-form onsubmit="return false;">
        <div class="border-b border-hairline pb-3">
          <h2 class="text-heading-3 font-bold text-ink">
            <span data-platform-display-name>{config.name}</span> Calculator Inputs
          </h2>
          <p class="text-caption text-muted">
            Enter your sale details below. Results calculate automatically.
          </p>
        </div>

        <!-- Calculation Mode Toggle: Forward vs Reverse -->
        <div class="rounded-xs bg-canvas-soft border border-hairline-strong p-1 flex items-center gap-1 select-none" role="radiogroup" aria-label="Calculation Mode">
          <button
            type="button"
            role="radio"
            data-mode-btn="forward"
            aria-checked="true"
            class="flex-1 py-2.5 px-3 min-h-[44px] inline-flex items-center justify-center text-ui-sm font-bold rounded-xs transition-colors cursor-pointer text-center bg-primary text-on-primary shadow-sm"
          >
            Forward (Price → Profit)
          </button>
          <button
            type="button"
            role="radio"
            data-mode-btn="reverse"
            aria-checked="false"
            class="flex-1 py-2.5 px-3 min-h-[44px] inline-flex items-center justify-center text-ui-sm font-semibold rounded-xs transition-colors cursor-pointer text-center text-body hover:text-ink hover:bg-canvas"
          >
            Reverse (Target → Price)
          </button>
        </div>

        <!-- Forward Mode Panel: Sold Price Input -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" data-mode-panel="forward">
          <div class="sm:col-span-2">
            <MoneyInput
              id="calc-price"
              name="price"
              label={platform === 'twitch-bits' ? 'Bits Amount' : 'Sold Item Price'}
              value={price}
              currencySymbol={platform === 'twitch-bits' ? '✦' : currencySymbol}
              helpText={platform === 'twitch-bits' ? 'Number of Bits cheered' : 'Final sale price excluding shipping'}
              required={true}
            />
          </div>

          <div>
            <StepperInput
              id="calc-quantity"
              name="quantity"
              label="Quantity"
              value={quantity}
              min={1}
              helpText="Units sold"
            />
          </div>
        </div>

        <!-- Reverse Mode Panel: Target Goal Inputs & Solved Listing Price Banner -->
        <div class="hidden space-y-4" data-mode-panel="reverse">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2 space-y-3">
              <!-- Target Type Selector -->
              <div>
                <label class="block text-caption font-bold text-ink mb-1.5">
                  Target Goal Type
                </label>
                <div class="flex gap-2">
                  <label class="flex-1 text-center py-2.5 px-3 min-h-[44px] inline-flex items-center justify-center rounded-xs border border-primary bg-mint-50 text-primary font-bold text-ui-sm cursor-pointer select-none" data-target-type-label="profit">
                    <input type="radio" name="reverseTargetType" value="profit" checked class="sr-only" />
                    Target Net Profit ({currencySymbol})
                  </label>
                  <label class="flex-1 text-center py-2.5 px-3 min-h-[44px] inline-flex items-center justify-center rounded-xs border border-hairline-strong bg-canvas-soft text-body font-medium text-ui-sm cursor-pointer select-none" data-target-type-label="margin">
                    <input type="radio" name="reverseTargetType" value="margin" class="sr-only" />
                    Target Margin (%)
                  </label>
                </div>
              </div>

              <!-- Target Value Inputs -->
              <div data-target-input-profit>
                <MoneyInput
                  id="calc-target-profit"
                  name="targetProfit"
                  label="Target Net Profit"
                  value={25.00}
                  currencySymbol={currencySymbol}
                  helpText="Exact take-home profit you want to keep"
                />
              </div>

              <div class="hidden" data-target-input-margin>
                <PercentInput
                  id="calc-target-margin"
                  name="targetMargin"
                  label="Target Profit Margin"
                  value={35.0}
                  min={0}
                  max={90}
                  helpText="Desired net profit percentage of gross revenue"
                />
              </div>
            </div>

            <div>
              <StepperInput
                id="calc-reverse-quantity"
                name="reverseQuantity"
                label="Quantity"
                value={quantity}
                min={1}
                helpText="Units to sell"
              />
            </div>
          </div>

          <!-- Solved Required Price Banner -->
          <div class="rounded-sm bg-mint-50 dark:bg-mint-200/10 border border-mint-200 p-4 space-y-1">
            <span class="block text-eyebrow text-primary uppercase font-bold tracking-wider">
              Required Listing Price
            </span>
            <div class="flex items-baseline gap-2">
              <span class="text-stat-value md:text-heading-2 font-bold text-ink tabular-nums" data-reverse-solved-price>
                $43.34
              </span>
              <span class="text-caption text-muted font-medium" data-reverse-solved-desc>
                List at $43.34 to keep $25.00 profit
              </span>
            </div>
          </div>
        </div>

        <!-- Shipping Charged & Shipping Cost (Hidden for Twitch Bits) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-shipping-section>
          <div>
            <MoneyInput
              id="calc-shipping-charged"
              name="shippingCharged"
              label="Buyer Paid Shipping"
              value={shippingCharged}
              currencySymbol={currencySymbol}
              helpText="Shipping charged to the buyer"
            />
          </div>

          <div>
            <MoneyInput
              id="calc-shipping-cost"
              name="shippingCost"
              label="Your Shipping Cost"
              value={shippingCost}
              currencySymbol={currencySymbol}
              helpText="Actual postage & packaging cost"
            />
          </div>
        </div>

        <!-- Item Cost (COGS) -->
        <div data-cogs-section>
          <MoneyInput
            id="calc-item-cost"
            name="itemCost"
            label="Item Cost (COGS)"
            value={itemCost}
            currencySymbol={currencySymbol}
            helpText="What you paid for the inventory per unit"
          />
        </div>

        <!-- Platform-Specific Options Panels -->
        <!-- eBay US Options -->
        <div
          class:list={['space-y-3 pt-3 border-t border-hairline', platform === 'ebay-us' ? 'block' : 'hidden']}
          data-options-panel="ebay-us"
        >
          <span class="block text-eyebrow font-bold text-muted uppercase tracking-wider">eBay US Options</span>
          <div class="space-y-3">
            <SelectInput
              id="opt-category-us"
              name="category"
              label="eBay Category"
              options={[
                { value: 'most_categories', label: 'Most Categories (13.25% / 12.35% Store)' },
                { value: 'books_movies_music', label: 'Books, Movies & Music (15.3% / 14.95%)' },
                { value: 'consumer_electronics', label: 'Computers & Electronics (13.25% / 9.35%)' },
                { value: 'musical_instruments', label: 'Guitars & Musical Instruments (6.7% / 6.35%)' },
                { value: 'jewelry_watches', label: 'Jewelry & Watches (15.0% / 13.0%)' },
                { value: 'athletic_shoes_150', label: 'Sneakers & Athletic Shoes ($150+ - 8.0%)' },
                { value: 'heavy_equipment', label: 'Heavy Equipment & Commercial (3.0% / 2.5%)' },
              ]}
              value={String(options.category ?? 'most_categories')}
              helpText="Final value fee percentage varies by category"
            />
            <ToggleSwitch
              id="opt-top-rated-us"
              name="isTopRatedSeller"
              label="Top Rated Plus Seller"
              description="10% discount on Final Value Fee portion"
              checked={Boolean(options.isTopRatedSeller)}
            />
            <ToggleSwitch
              id="opt-store-us"
              name="hasStoreSubscription"
              label="eBay Store Subscriber"
              description="Lower 12.35% base category rate"
              checked={Boolean(options.hasStoreSubscription)}
            />
            <PercentInput
              id="opt-promoted-us"
              name="promotedListingPercent"
              label="Promoted Listings Ad Rate"
              value={Number(options.promotedListingPercent ?? 0)}
              helpText="Optional promoted listing percentage"
            />
          </div>
        </div>

        <!-- eBay UK Options -->
        <div
          class:list={['space-y-3 pt-3 border-t border-hairline', platform === 'ebay-uk' ? 'block' : 'hidden']}
          data-options-panel="ebay-uk"
        >
          <span class="block text-eyebrow font-bold text-muted uppercase tracking-wider">eBay UK Options</span>
          <div class="space-y-3">
            <SelectInput
              id="opt-seller-type-uk"
              name="sellerType"
              label="Seller Type"
              value={String(options.sellerType ?? 'private')}
              options={[
                { value: 'private', label: 'Private Seller (0% Selling Fee)' },
                { value: 'business', label: 'Business Seller (12.8% + £0.30)' },
              ]}
              helpText="UK private sellers enjoy 0% selling fees on eBay"
            />
            <ToggleSwitch
              id="opt-vat-uk"
              name="includeVatOnFees"
              label="Include 20% UK VAT on Business Fees"
              description="HMRC requires 20% VAT on eBay business seller fees"
              checked={options.includeVatOnFees !== false}
            />
            <PercentInput
              id="opt-promoted-uk"
              name="promotedListingPercentUk"
              label="Promoted Listings Ad Rate"
              value={Number(options.promotedListingPercent ?? 0)}
              helpText="Optional promoted listing percentage"
            />
          </div>
        </div>

        <!-- TikTok Shop Options -->
        <div
          class:list={['space-y-3 pt-3 border-t border-hairline', platform === 'tiktok-shop' ? 'block' : 'hidden']}
          data-options-panel="tiktok-shop"
        >
          <span class="block text-eyebrow font-bold text-muted uppercase tracking-wider">TikTok Shop Options</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <PercentInput
              id="opt-referral-fee"
              name="referralFeePercent"
              label="Referral Fee Rate"
              value={Number(options.referralFeePercent ?? 6.0)}
              helpText="Platform referral percentage"
            />
            <PercentInput
              id="opt-affiliate-fee"
              name="affiliateCommissionPercent"
              label="Creator Affiliate Rate"
              value={Number(options.affiliateCommissionPercent ?? 0.0)}
              helpText="Optional affiliate creator rate"
            />
          </div>
        </div>

        <!-- Etsy Options -->
        <div
          class:list={['space-y-3 pt-3 border-t border-hairline', platform === 'etsy' ? 'block' : 'hidden']}
          data-options-panel="etsy"
        >
          <span class="block text-eyebrow font-bold text-muted uppercase tracking-wider">Etsy Options</span>
          <div class="space-y-3">
            <ToggleSwitch
              id="opt-offsite-ads"
              name="hasOffsiteAds"
              label="Offsite Ads Attributed"
              description="Apply ad fee when a sale is driven by Etsy Offsite Ads (max $100 fee per order)"
              checked={Boolean(options.hasOffsiteAds)}
            />
            <div
              class:list={['space-y-1.5 pl-6 pt-1', Boolean(options.hasOffsiteAds) ? 'block' : 'hidden']}
              data-etsy-ads-tier-container
            >
              <label for="opt-etsy-ads-tier" class="block text-caption font-bold text-ink">
                Annual Sales Tier (Offsite Ads Rate)
              </label>
              <select
                id="opt-etsy-ads-tier"
                name="offsiteAdsTier"
                class="w-full min-h-[44px] rounded-xs border border-hairline-strong bg-canvas px-3 py-2.5 text-ui-sm text-ink focus:border-primary focus:outline-none"
              >
                <option value="standard" selected={options.offsiteAdsTier !== 'high_volume'}>Standard (&lt; $10k/yr) — 15% (Optional)</option>
                <option value="high_volume" selected={options.offsiteAdsTier === 'high_volume'}>High Volume (&ge; $10k/yr) — 12% (Mandatory)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Reset Button -->
        <div class="pt-2 flex items-center justify-between">
          <button
            type="button"
            data-reset-btn
            class="text-ui-sm text-muted hover:text-ink underline py-3 inline-flex items-center min-h-[44px] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary"
          >
            Reset to defaults
          </button>
        </div>
      </form>

      <!-- Right Column: Results Panel (Headline, Margin/ROI, Stacked Bar, Fee Table, Copy Button, Verified Link) -->
      <div class="lg:col-span-6" aria-live="polite" data-results-container>
        <ResultsPanel
          result={serverResult}
          platform={platform}
          platformName={config.name}
          currencySymbol={currencySymbol}
          verifiedOn={config.verifiedOn}
          sourceUrl={config.sourceUrl}
        />
      </div>
    </div>
  </div>
</seller-calculator>

<script>
  import {
    runCalculator,
    calculateReverse,
    PLATFORM_CONFIGS,
    parseUrlState,
    buildUrlQuery,
    type PlatformId,
    type CalcResult,
    type ReverseTargetType,
    type CalculatorUrlState,
  } from '../lib/calc';
  import { trackEvent } from '../lib/analytics';

  class SellerCalculator extends HTMLElement {
    private currentPlatform: PlatformId = 'whatnot';
    private currentSymbol: string = '$';
    private currentMode: 'forward' | 'reverse' = 'forward';
    private currentReverseTargetType: ReverseTargetType = 'profit';
    private calcAnalyticsTimeout: ReturnType<typeof setTimeout> | null = null;

    private form: HTMLFormElement | null = null;
    private outNetProfit: HTMLElement | null = null;
    private outProfitMargin: HTMLElement | null = null;
    private outRoi: HTMLElement | null = null;
    private outBreakEven: HTMLElement | null = null;
    private outTotalFees: HTMLElement | null = null;
    private outFeeBreakdownBody: HTMLElement | null = null;
    private profitBadge: HTMLElement | null = null;
    private platformDisplayName: HTMLElement | null = null;

    private urlSyncTimeout: ReturnType<typeof setTimeout> | null = null;

    connectedCallback() {
      this.currentPlatform = (this.dataset.platform as PlatformId) || 'whatnot';
      const config = PLATFORM_CONFIGS[this.currentPlatform] ?? PLATFORM_CONFIGS.whatnot;
      this.currentSymbol = config.currencySymbol;
      this.form = this.querySelector('[data-calculator-form]');
      this.outNetProfit = this.querySelector('[data-out="net-profit"]');
      this.outProfitMargin = this.querySelector('[data-out="profit-margin"]');
      this.outRoi = this.querySelector('[data-out="roi"]');
      this.outBreakEven = this.querySelector('[data-out="break-even"]');
      this.outTotalFees = this.querySelector('[data-out="total-fees"]');
      this.outFeeBreakdownBody = this.querySelector('[data-out="fee-breakdown-body"]');
      this.profitBadge = this.querySelector('[data-profit-badge]');
      this.platformDisplayName = this.querySelector('[data-platform-display-name]');

      this.initEvents();

      // Restore state from URL query parameters without flash of default values
      try {
        if (typeof window !== 'undefined' && window.location.search && window.location.search.length > 1) {
          const urlState = parseUrlState(window.location.search);
          this.applyUrlState(urlState);
          this.calculate(false);
        }
      } catch (err) {
        console.error('Error restoring URL state:', err);
      } finally {
        this.setAttribute('data-initialized', 'true');
        if (typeof document !== 'undefined') {
          document.documentElement.classList.remove('calc-restoring');
        }
      }
    }

    private initEvents() {
      // Input & change events on form inputs
      this.form?.addEventListener('input', () => this.calculate(true));
      this.form?.addEventListener('change', () => this.calculate(true));

      // Reset button
      const resetBtn = this.querySelector('[data-reset-btn]');
      resetBtn?.addEventListener('click', () => this.resetDefaults());

      // Platform switcher tabs
      const tabs = this.querySelectorAll<HTMLButtonElement>('[data-platform-tab]');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const newPlatform = tab.dataset.platformTab as PlatformId;
          if (newPlatform && PLATFORM_CONFIGS[newPlatform]) {
            this.switchPlatform(newPlatform, true);
          }
        });
      });

      // Mode toggle buttons (Forward vs Reverse)
      const modeBtns = this.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');
      modeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.modeBtn as 'forward' | 'reverse';
          if (mode && mode !== this.currentMode) {
            this.switchMode(mode, true);
          }
        });
      });

      // Reverse target type radios (Profit vs Margin)
      const targetTypeRadios = this.querySelectorAll<HTMLInputElement>('input[name="reverseTargetType"]');
      targetTypeRadios.forEach((radio) => {
        radio.addEventListener('change', () => {
          this.switchTargetType(radio.value as ReverseTargetType, true);
        });
      });

      // Etsy Offsite Ads toggle listener to show/hide tier selector
      const offsiteAdsToggle = this.querySelector<HTMLInputElement>('#opt-offsite-ads');
      offsiteAdsToggle?.addEventListener('change', () => {
        const tierContainer = this.querySelector<HTMLElement>('[data-etsy-ads-tier-container]');
        if (tierContainer) {
          tierContainer.classList.toggle('hidden', !offsiteAdsToggle.checked);
          tierContainer.classList.toggle('block', offsiteAdsToggle.checked);
        }
      });
    }

    private switchMode(mode: 'forward' | 'reverse', shouldSyncUrl = true) {
      if (mode !== this.currentMode) {
        trackEvent('mode_changed', {
          platform: this.currentPlatform,
          previousMode: this.currentMode,
          newMode: mode,
        });
      }
      this.currentMode = mode;

      const modeBtns = this.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');
      modeBtns.forEach((btn) => {
        const isActive = btn.dataset.modeBtn === mode;
        btn.setAttribute('aria-checked', isActive ? 'true' : 'false');
        if (isActive) {
          btn.classList.add('bg-primary', 'text-on-primary', 'shadow-sm', 'font-bold');
          btn.classList.remove('text-body', 'font-semibold');
        } else {
          btn.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm', 'font-bold');
          btn.classList.add('text-body', 'font-semibold');
        }
      });

      const forwardPanel = this.querySelector<HTMLElement>('[data-mode-panel="forward"]');
      const reversePanel = this.querySelector<HTMLElement>('[data-mode-panel="reverse"]');

      if (forwardPanel) forwardPanel.classList.toggle('hidden', mode !== 'forward');
      if (reversePanel) reversePanel.classList.toggle('hidden', mode !== 'reverse');

      this.calculate(shouldSyncUrl);
    }

    private switchTargetType(type: ReverseTargetType, shouldSyncUrl = true) {
      this.currentReverseTargetType = type;

      const profitLabel = this.querySelector<HTMLElement>('[data-target-type-label="profit"]');
      const marginLabel = this.querySelector<HTMLElement>('[data-target-type-label="margin"]');

      if (profitLabel) {
        profitLabel.classList.toggle('border-primary', type === 'profit');
        profitLabel.classList.toggle('bg-mint-50', type === 'profit');
        profitLabel.classList.toggle('text-primary', type === 'profit');
        profitLabel.classList.toggle('font-bold', type === 'profit');
        profitLabel.classList.toggle('border-hairline-strong', type !== 'profit');
        profitLabel.classList.toggle('bg-canvas-soft', type !== 'profit');
        profitLabel.classList.toggle('text-body', type !== 'profit');
      }

      if (marginLabel) {
        marginLabel.classList.toggle('border-primary', type === 'margin');
        marginLabel.classList.toggle('bg-mint-50', type === 'margin');
        marginLabel.classList.toggle('text-primary', type === 'margin');
        marginLabel.classList.toggle('font-bold', type === 'margin');
        marginLabel.classList.toggle('border-hairline-strong', type !== 'margin');
        marginLabel.classList.toggle('bg-canvas-soft', type !== 'margin');
        marginLabel.classList.toggle('text-body', type !== 'margin');
      }

      const profitInputContainer = this.querySelector<HTMLElement>('[data-target-input-profit]');
      const marginInputContainer = this.querySelector<HTMLElement>('[data-target-input-margin]');

      if (profitInputContainer) profitInputContainer.classList.toggle('hidden', type !== 'profit');
      if (marginInputContainer) marginInputContainer.classList.toggle('hidden', type !== 'margin');

      this.calculate(shouldSyncUrl);
    }

    private switchPlatform(newPlatform: PlatformId, shouldSyncUrl = true) {
      this.currentPlatform = newPlatform;
      const config = PLATFORM_CONFIGS[newPlatform];
      this.currentSymbol = config.currencySymbol;
      this.dataset.platform = newPlatform;
      this.dataset.currency = config.defaultCurrency;
      this.dataset.symbol = config.currencySymbol;

      // Update tabs UI
      const tabs = this.querySelectorAll<HTMLButtonElement>('[data-platform-tab]');
      tabs.forEach((tab) => {
        const isActive = tab.dataset.platformTab === newPlatform;
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        if (isActive) {
          tab.classList.add('bg-primary', 'text-on-primary', 'border-primary');
          tab.classList.remove('bg-canvas-soft', 'text-body', 'border-hairline-strong');
        } else {
          tab.classList.remove('bg-primary', 'text-on-primary', 'border-primary');
          tab.classList.add('bg-canvas-soft', 'text-body', 'border-hairline-strong');
        }
      });

      // Update platform title
      if (this.platformDisplayName) {
        this.platformDisplayName.textContent = config.name;
      }

      // Update verification metadata
      const platformNameEl = this.querySelector('[data-platform-name]');
      if (platformNameEl) platformNameEl.textContent = config.name;

      const verifiedDateEl = this.querySelector('[data-verified-date]');
      if (verifiedDateEl) {
        try {
          const [year, month, day] = config.verifiedOn.split('-').map(Number);
          const date = new Date(Date.UTC(year, month - 1, day));
          verifiedDateEl.textContent = date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC',
          });
        } catch {
          verifiedDateEl.textContent = config.verifiedOn;
        }
      }

      const sourceLinkEl = this.querySelector<HTMLAnchorElement>('[data-source-link]');
      if (sourceLinkEl) sourceLinkEl.href = config.sourceUrl;

      // Update currency prefixes
      const prefixes = this.querySelectorAll('[data-currency-symbol]');
      prefixes.forEach((el) => {
        el.textContent = newPlatform === 'twitch-bits' ? '✦' : config.currencySymbol;
      });

      // Show/Hide platform options
      const optionPanels = this.querySelectorAll<HTMLElement>('[data-options-panel]');
      optionPanels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.optionsPanel !== newPlatform);
        panel.classList.toggle('block', panel.dataset.optionsPanel === newPlatform);
      });

      // Special handling for Twitch Bits inputs
      const isTwitch = newPlatform === 'twitch-bits';
      const shippingSection = this.querySelector<HTMLElement>('[data-shipping-section]');
      const cogsSection = this.querySelector<HTMLElement>('[data-cogs-section]');
      const labelPrice = this.querySelector<HTMLLabelElement>('label[for="calc-price"]');
      const priceInput = this.querySelector<HTMLInputElement>('#calc-price');

      if (shippingSection) shippingSection.classList.toggle('hidden', isTwitch);
      if (cogsSection) cogsSection.classList.toggle('hidden', isTwitch);
      if (labelPrice) {
        labelPrice.textContent = isTwitch ? 'Bits Amount' : 'Sold Item Price';
      }
      if (priceInput) {
        priceInput.step = isTwitch ? '1' : '0.01';
        priceInput.value = config.defaultPrice.toFixed(isTwitch ? 0 : 2);
      }

      this.calculate(shouldSyncUrl);
    }

    private applyUrlState(urlState: CalculatorUrlState) {
      // 1. Switch platform if specified
      if (urlState.platform && urlState.platform !== this.currentPlatform && PLATFORM_CONFIGS[urlState.platform]) {
        this.switchPlatform(urlState.platform, false);
      }

      // 2. Switch mode if specified
      if (urlState.mode && urlState.mode !== this.currentMode) {
        this.switchMode(urlState.mode, false);
      }

      // 3. Switch reverse target type if specified
      if (urlState.reverseTargetType && urlState.reverseTargetType !== this.currentReverseTargetType) {
        this.switchTargetType(urlState.reverseTargetType, false);
      }

      const isTwitch = this.currentPlatform === 'twitch-bits';

      // 4. Populate forward inputs
      if (typeof urlState.price === 'number') {
        const priceInput = this.querySelector<HTMLInputElement>('#calc-price');
        if (priceInput) priceInput.value = isTwitch ? Math.round(urlState.price).toString() : urlState.price.toFixed(2);
      }
      if (typeof urlState.quantity === 'number') {
        const qtyInput = this.querySelector<HTMLInputElement>('#calc-quantity');
        if (qtyInput) qtyInput.value = urlState.quantity.toString();
      }

      // 5. Populate reverse inputs
      if (typeof urlState.targetProfit === 'number') {
        const targetProfitInput = this.querySelector<HTMLInputElement>('#calc-target-profit');
        if (targetProfitInput) targetProfitInput.value = urlState.targetProfit.toFixed(2);
      }
      if (typeof urlState.targetMargin === 'number') {
        const targetMarginInput = this.querySelector<HTMLInputElement>('#calc-target-margin');
        if (targetMarginInput) targetMarginInput.value = urlState.targetMargin.toFixed(1);
      }
      if (typeof urlState.reverseQuantity === 'number') {
        const revQtyInput = this.querySelector<HTMLInputElement>('#calc-reverse-quantity');
        if (revQtyInput) revQtyInput.value = urlState.reverseQuantity.toString();
      }

      // 6. Populate costs
      if (typeof urlState.shippingCharged === 'number') {
        const shipChargedInput = this.querySelector<HTMLInputElement>('#calc-shipping-charged');
        if (shipChargedInput) shipChargedInput.value = urlState.shippingCharged.toFixed(2);
      }
      if (typeof urlState.shippingCost === 'number') {
        const shipCostInput = this.querySelector<HTMLInputElement>('#calc-shipping-cost');
        if (shipCostInput) shipCostInput.value = urlState.shippingCost.toFixed(2);
      }
      if (typeof urlState.itemCost === 'number') {
        const itemCostInput = this.querySelector<HTMLInputElement>('#calc-item-cost');
        if (itemCostInput) itemCostInput.value = urlState.itemCost.toFixed(2);
      }

      // 7. Populate platform options
      if (urlState.options) {
        if (this.currentPlatform === 'ebay-us') {
          const categoryEl = this.querySelector<HTMLSelectElement>('#opt-category-us');
          if (categoryEl && typeof urlState.options.category === 'string') {
            categoryEl.value = urlState.options.category;
          }
          const topRatedEl = this.querySelector<HTMLInputElement>('#opt-top-rated-us');
          if (topRatedEl && typeof urlState.options.isTopRatedSeller === 'boolean') {
            topRatedEl.checked = urlState.options.isTopRatedSeller;
          }
          const storeEl = this.querySelector<HTMLInputElement>('#opt-store-us');
          if (storeEl && typeof urlState.options.hasStoreSubscription === 'boolean') {
            storeEl.checked = urlState.options.hasStoreSubscription;
          }
          const promEl = this.querySelector<HTMLInputElement>('#opt-promoted-us');
          if (promEl && typeof urlState.options.promotedListingPercent === 'number') {
            promEl.value = urlState.options.promotedListingPercent.toString();
          }
        } else if (this.currentPlatform === 'ebay-uk') {
          const sellerTypeEl = this.querySelector<HTMLSelectElement>('#opt-seller-type-uk');
          if (sellerTypeEl && typeof urlState.options.sellerType === 'string') {
            sellerTypeEl.value = urlState.options.sellerType;
          }
          const vatEl = this.querySelector<HTMLInputElement>('#opt-vat-uk');
          if (vatEl && typeof urlState.options.includeVatOnFees === 'boolean') {
            vatEl.checked = urlState.options.includeVatOnFees;
          }
          const promUkEl = this.querySelector<HTMLInputElement>('#opt-promoted-uk');
          if (promUkEl && typeof urlState.options.promotedListingPercent === 'number') {
            promUkEl.value = urlState.options.promotedListingPercent.toString();
          }
        } else if (this.currentPlatform === 'tiktok-shop') {
          const refEl = this.querySelector<HTMLInputElement>('#opt-referral-fee');
          if (refEl && typeof urlState.options.referralFeePercent === 'number') {
            refEl.value = urlState.options.referralFeePercent.toString();
          }
          const affEl = this.querySelector<HTMLInputElement>('#opt-affiliate-fee');
          if (affEl && typeof urlState.options.affiliateCommissionPercent === 'number') {
            affEl.value = urlState.options.affiliateCommissionPercent.toString();
          }
        } else if (this.currentPlatform === 'etsy') {
          const offsiteEl = this.querySelector<HTMLInputElement>('#opt-offsite-ads');
          if (offsiteEl && typeof urlState.options.hasOffsiteAds === 'boolean') {
            offsiteEl.checked = urlState.options.hasOffsiteAds;
            const tierContainer = this.querySelector<HTMLElement>('[data-etsy-ads-tier-container]');
            if (tierContainer) {
              tierContainer.classList.toggle('hidden', !offsiteEl.checked);
              tierContainer.classList.toggle('block', offsiteEl.checked);
            }
          }
          const tierEl = this.querySelector<HTMLSelectElement>('#opt-etsy-ads-tier');
          if (tierEl && typeof urlState.options.offsiteAdsTier === 'string') {
            tierEl.value = urlState.options.offsiteAdsTier;
          }
        }
      }
    }

    private getCurrentState(): CalculatorUrlState {
      if (!this.form) return { platform: this.currentPlatform };
      const formData = new FormData(this.form);
      const state: CalculatorUrlState = {
        platform: this.currentPlatform,
        mode: this.currentMode,
      };

      const isTwitch = this.currentPlatform === 'twitch-bits';

      if (this.currentMode === 'reverse') {
        state.reverseTargetType = this.currentReverseTargetType;
        if (this.currentReverseTargetType === 'margin') {
          state.targetMargin = parseFloat(formData.get('targetMargin') as string) || 30.0;
        } else {
          state.targetProfit = parseFloat(formData.get('targetProfit') as string) || 25.0;
        }
        const rq = parseInt(formData.get('reverseQuantity') as string, 10);
        if (!isNaN(rq) && rq > 1) state.reverseQuantity = rq;
      } else {
        const p = parseFloat(formData.get('price') as string);
        if (!isNaN(p)) state.price = p;
        const q = parseInt(formData.get('quantity') as string, 10);
        if (!isNaN(q) && q > 1) state.quantity = q;
      }

      if (!isTwitch) {
        const sc = parseFloat(formData.get('shippingCharged') as string);
        if (!isNaN(sc) && sc > 0) state.shippingCharged = sc;
        const so = parseFloat(formData.get('shippingCost') as string);
        if (!isNaN(so) && so > 0) state.shippingCost = so;
        const ic = parseFloat(formData.get('itemCost') as string);
        if (!isNaN(ic) && ic > 0) state.itemCost = ic;
      }

      // Options
      const opts: Record<string, unknown> = {};
      if (this.currentPlatform === 'ebay-us') {
        const cat = formData.get('category') as string;
        if (cat && cat !== 'most_categories') opts.category = cat;
        if (formData.get('isTopRatedSeller') === 'on') opts.isTopRatedSeller = true;
        if (formData.get('hasStoreSubscription') === 'on') opts.hasStoreSubscription = true;
        const prom = parseFloat(formData.get('promotedListingPercent') as string);
        if (!isNaN(prom) && prom > 0) opts.promotedListingPercent = prom;
      } else if (this.currentPlatform === 'ebay-uk') {
        const st = formData.get('sellerType') as string;
        if (st && st !== 'private') opts.sellerType = st;
        if (formData.get('includeVatOnFees') === 'on') {
          opts.includeVatOnFees = true;
        } else {
          opts.includeVatOnFees = false;
        }
        const promUk = parseFloat(formData.get('promotedListingPercentUk') as string);
        if (!isNaN(promUk) && promUk > 0) opts.promotedListingPercent = promUk;
      } else if (this.currentPlatform === 'tiktok-shop') {
        const ref = parseFloat(formData.get('referralFeePercent') as string);
        if (!isNaN(ref) && ref !== 6.0) opts.referralFeePercent = ref;
        const aff = parseFloat(formData.get('affiliateCommissionPercent') as string);
        if (!isNaN(aff) && aff > 0) opts.affiliateCommissionPercent = aff;
      } else if (this.currentPlatform === 'etsy') {
        if (formData.get('hasOffsiteAds') === 'on') {
          opts.hasOffsiteAds = true;
          opts.offsiteAdsTier = formData.get('offsiteAdsTier') || 'standard';
        }
      }

      if (Object.keys(opts).length > 0) {
        state.options = opts;
      }

      return state;
    }

    private scheduleUrlSync() {
      if (typeof window === 'undefined' || !window.history?.replaceState) return;
      if (this.urlSyncTimeout) {
        clearTimeout(this.urlSyncTimeout);
      }
      this.urlSyncTimeout = setTimeout(() => {
        this.syncUrlNow();
      }, 150);
    }

    private syncUrlNow() {
      if (typeof window === 'undefined' || !window.history?.replaceState) return;
      const state = this.getCurrentState();
      const query = buildUrlQuery(state);
      const newRelative = `${window.location.pathname}${query}${window.location.hash}`;
      const currentRelative = `${window.location.pathname}${window.location.search}${window.location.hash}`;
      if (newRelative !== currentRelative) {
        window.history.replaceState({ sellerCalc: true }, '', newRelative);
      }
    }

    private resetDefaults() {
      const config = PLATFORM_CONFIGS[this.currentPlatform];
      const isTwitch = this.currentPlatform === 'twitch-bits';

      const priceInput = this.querySelector<HTMLInputElement>('#calc-price');
      const qtyInput = this.querySelector<HTMLInputElement>('#calc-quantity');
      const shippingChargedInput = this.querySelector<HTMLInputElement>('#calc-shipping-charged');
      const shippingCostInput = this.querySelector<HTMLInputElement>('#calc-shipping-cost');
      const itemCostInput = this.querySelector<HTMLInputElement>('#calc-item-cost');

      if (priceInput) priceInput.value = config.defaultPrice.toFixed(isTwitch ? 0 : 2);
      if (qtyInput) qtyInput.value = config.defaultQuantity.toString();
      if (shippingChargedInput) shippingChargedInput.value = config.defaultShippingCharged.toFixed(2);
      if (shippingCostInput) shippingCostInput.value = config.defaultShippingCost.toFixed(2);
      if (itemCostInput) itemCostInput.value = config.defaultItemCost.toFixed(2);

      this.calculate(true);
    }

    private formatMoney(amount: number): string {
      const formatted = Math.abs(amount).toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
      return amount < 0 ? `-${this.currentSymbol}${formatted}` : `${this.currentSymbol}${formatted}`;
    }

    private calculate(shouldSyncUrl = true) {
      if (!this.form) return;

      const formData = new FormData(this.form);
      const shippingCharged = parseFloat(formData.get('shippingCharged') as string) || 0;
      const shippingCost = parseFloat(formData.get('shippingCost') as string) || 0;
      const itemCost = parseFloat(formData.get('itemCost') as string) || 0;

      // Extract platform specific options
      const options: Record<string, unknown> = {};

      if (this.currentPlatform === 'ebay-us') {
        options.category = (formData.get('category') as string) || 'most_categories';
        options.isTopRatedSeller = formData.get('isTopRatedSeller') === 'on';
        options.hasStoreSubscription = formData.get('hasStoreSubscription') === 'on';
        options.promotedListingPercent = parseFloat(formData.get('promotedListingPercent') as string) || 0;
      } else if (this.currentPlatform === 'ebay-uk') {
        options.sellerType = formData.get('sellerType') || 'private';
        options.includeVatOnFees = formData.get('includeVatOnFees') === 'on';
        options.promotedListingPercent = parseFloat(formData.get('promotedListingPercentUk') as string) || 0;
      } else if (this.currentPlatform === 'tiktok-shop') {
        options.referralFeePercent = parseFloat(formData.get('referralFeePercent') as string) || 6.0;
        options.affiliateCommissionPercent = parseFloat(formData.get('affiliateCommissionPercent') as string) || 0.0;
      } else if (this.currentPlatform === 'etsy') {
        options.hasOffsiteAds = formData.get('hasOffsiteAds') === 'on';
        options.offsiteAdsTier = formData.get('offsiteAdsTier') || 'standard';
      } else if (this.currentPlatform === 'depop') {
        options.region = 'US';
      }

      if (this.currentMode === 'reverse') {
        const reverseQuantity = Math.max(1, parseInt(formData.get('reverseQuantity') as string, 10) || 1);
        const targetType = this.currentReverseTargetType;
        const targetValue =
          targetType === 'margin'
            ? parseFloat(formData.get('targetMargin') as string) || 30.0
            : parseFloat(formData.get('targetProfit') as string) || 25.0;

        const rev = calculateReverse(
          this.currentPlatform,
          {
            targetType,
            targetValue,
            quantity: reverseQuantity,
            shippingCharged,
            shippingCost,
            itemCost,
          },
          options
        );

        const isTwitch = this.currentPlatform === 'twitch-bits';
        const solvedPriceEl = this.querySelector('[data-reverse-solved-price]');
        const solvedDescEl = this.querySelector('[data-reverse-solved-desc]');

        if (solvedPriceEl) {
          solvedPriceEl.textContent = isTwitch
            ? `${Math.round(rev.targetPrice).toLocaleString()} Bits`
            : this.formatMoney(rev.targetPrice);
        }

        if (solvedDescEl) {
          const targetStr =
            targetType === 'margin'
              ? `${targetValue.toFixed(1)}% margin`
              : `${this.formatMoney(targetValue)} net profit`;
          solvedDescEl.textContent = `List at ${this.formatMoney(rev.targetPrice)} to achieve ${targetStr}`;
        }

        this.updateUI(rev.forwardResult);
      } else {
        const price = parseFloat(formData.get('price') as string) || 0;
        const quantity = Math.max(1, parseInt(formData.get('quantity') as string, 10) || 1);

        const result: CalcResult = runCalculator(
          this.currentPlatform,
          {
            price,
            quantity,
            shippingCharged,
            shippingCost,
            itemCost,
          },
          options
        );

        this.updateUI(result);
      }

      if (shouldSyncUrl) {
        this.scheduleUrlSync();
        this.queueAnalyticsCalc(options);
      }
    }

    private queueAnalyticsCalc(options?: Record<string, unknown>) {
      if (typeof window === 'undefined') return;
      if (this.calcAnalyticsTimeout) clearTimeout(this.calcAnalyticsTimeout);
      this.calcAnalyticsTimeout = setTimeout(() => {
        const categoryInput = this.querySelector<HTMLSelectElement>('#calc-category');
        const promotedInput = this.querySelector<HTMLInputElement>('#opt-promoted');
        const storeInput = this.querySelector<HTMLInputElement>('#opt-store');
        trackEvent('calculator_used', {
          platform: this.currentPlatform,
          mode: this.currentMode,
          category: typeof options?.category === 'string' ? options.category : (categoryInput ? categoryInput.value : undefined),
          hasPromoted: typeof options?.promotedListingPercent === 'number' ? options.promotedListingPercent > 0 : (promotedInput ? promotedInput.checked : undefined),
          hasStore: typeof options?.hasStoreSubscription === 'boolean' ? options.hasStoreSubscription : (storeInput ? storeInput.checked : undefined),
        });
      }, 700);
    }

    private updateUI(result: CalcResult) {
      const isProfitable = result.netProfit >= 0;

      // 1. Headline & Card
      const headlinePrefix = this.querySelector<HTMLElement>('[data-headline-prefix]');
      if (headlinePrefix) {
        headlinePrefix.textContent = isProfitable ? 'You keep' : 'You lose';
      }
      const netProfitCard = this.querySelector<HTMLElement>('[data-net-profit-card]');
      if (netProfitCard) {
        netProfitCard.classList.toggle('bg-primary-deep', isProfitable);
        netProfitCard.classList.toggle('bg-error', !isProfitable);
      }

      if (this.outNetProfit) {
        this.outNetProfit.textContent = this.formatMoney(result.netProfit);
      }
      if (this.outProfitMargin) {
        this.outProfitMargin.textContent = `${result.profitMargin.toFixed(1)}%`;
      }
      if (this.outRoi) {
        this.outRoi.textContent = `${result.roi.toFixed(1)}%`;
      }
      if (this.outBreakEven) {
        this.outBreakEven.textContent = this.formatMoney(result.breakEvenPrice);
      }
      if (this.outTotalFees) {
        this.outTotalFees.textContent = this.formatMoney(result.totalFees);
      }

      if (this.profitBadge) {
        this.profitBadge.textContent = isProfitable ? 'Profitable' : 'Loss';
        this.profitBadge.className = isProfitable
          ? 'text-micro uppercase font-bold px-2.5 py-0.5 rounded-xs bg-forest text-lime-hero'
          : 'text-micro uppercase font-bold px-2.5 py-0.5 rounded-xs bg-black/30 text-white';
      }

      // 2. Financial Distribution (Stacked Bar & Legend)
      const profitAmount = Math.max(0, result.netProfit);
      const feesAmount = Math.max(0, result.totalFees);
      const cogsAmount = Math.max(0, result.itemCostTotal);
      const shipAmount = Math.max(0, result.shippingCostTotal);
      const totalBasis = profitAmount + feesAmount + cogsAmount + shipAmount || result.grossRevenue || 1;

      const profitPct = Number(((profitAmount / totalBasis) * 100).toFixed(1));
      const feesPct = Number(((feesAmount / totalBasis) * 100).toFixed(1));
      const cogsPct = Number(((cogsAmount / totalBasis) * 100).toFixed(1));
      const shipPct = Number(((shipAmount / totalBasis) * 100).toFixed(1));

      const barProfit = this.querySelector<HTMLElement>('[data-bar-profit]');
      const barFees = this.querySelector<HTMLElement>('[data-bar-fees]');
      const barCogs = this.querySelector<HTMLElement>('[data-bar-cogs]');
      const barShipping = this.querySelector<HTMLElement>('[data-bar-shipping]');

      if (barProfit) {
        barProfit.style.width = `${profitPct}%`;
        barProfit.title = `Net Profit: ${profitPct}%`;
      }
      if (barFees) {
        barFees.style.width = `${feesPct}%`;
        barFees.title = `Platform Fees: ${feesPct}%`;
      }
      if (barCogs) {
        barCogs.style.width = `${cogsPct}%`;
        barCogs.title = `Product Cost (COGS): ${cogsPct}%`;
      }
      if (barShipping) {
        barShipping.style.width = `${shipPct}%`;
        barShipping.title = `Shipping Out-of-Pocket: ${shipPct}%`;
      }

      const barContainer = this.querySelector<HTMLElement>('[data-stacked-bar-container]');
      if (barContainer) {
        barContainer.setAttribute(
          'aria-label',
          `Financial distribution of sale proceeds: Net profit ${profitPct}%, Marketplace fees ${feesPct}%, Product cost ${cogsPct}%, Shipping cost ${shipPct}%`
        );
      }

      const legProfit = this.querySelector('[data-legend-profit]');
      const legFees = this.querySelector('[data-legend-fees]');
      const legCogs = this.querySelector('[data-legend-cogs]');
      const legShip = this.querySelector('[data-legend-shipping]');
      if (legProfit) legProfit.textContent = `${profitPct}%`;
      if (legFees) legFees.textContent = `${feesPct}%`;
      if (legCogs) legCogs.textContent = `${cogsPct}%`;
      if (legShip) legShip.textContent = `${shipPct}%`;

      const srProfit = this.querySelector('[data-sr-profit]');
      const srFees = this.querySelector('[data-sr-fees]');
      const srCogs = this.querySelector('[data-sr-cogs]');
      const srShip = this.querySelector('[data-sr-shipping]');
      if (srProfit) srProfit.textContent = `Net Profit: ${this.formatMoney(profitAmount)} (${profitPct}%)`;
      if (srFees) srFees.textContent = `Marketplace Fees: ${this.formatMoney(feesAmount)} (${feesPct}%)`;
      if (srCogs) srCogs.textContent = `Product Cost: ${this.formatMoney(cogsAmount)} (${cogsPct}%)`;
      if (srShip) srShip.textContent = `Shipping Cost: ${this.formatMoney(shipAmount)} (${shipPct}%)`;

      // 3. Fee Breakdown Table
      if (this.outFeeBreakdownBody) {
        this.outFeeBreakdownBody.innerHTML = result.fees
          .map(
            (fee) => `
          <tr>
            <th scope="row" class="py-2.5 px-4 font-normal text-left">
              <div class="font-semibold text-ink">${fee.name}</div>
              ${fee.description ? `<div class="text-micro text-muted">${fee.description}</div>` : ''}
            </th>
            <td class="py-2.5 px-4 text-right font-medium text-ink tabular-nums whitespace-nowrap">
              ${this.formatMoney(fee.amount)}
            </td>
          </tr>
        `
          )
          .join('');
      }
    }
  }

  if (!customElements.get('seller-calculator')) {
    customElements.define('seller-calculator', SellerCalculator);
  }
</script>
