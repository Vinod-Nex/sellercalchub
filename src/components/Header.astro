---
import ThemeToggle from "./ThemeToggle.astro";

const calculators = [
  {
    name: "Whatnot Fee Calculator",
    href: "/whatnot-fee-calculator/",
    badge: "Live Sales",
  },
  {
    name: "TikTok Shop Fee Calculator",
    href: "/tiktok-shop-fee-calculator/",
    badge: "E-commerce",
  },
  {
    name: "Depop Fee Calculator",
    href: "/depop-fee-calculator/",
    badge: "Fashion",
  },
  {
    name: "Etsy Fee Calculator",
    href: "/etsy-fee-calculator/",
    badge: "Handmade",
  },
  {
    name: "eBay Fee Calculator",
    href: "/ebay-fee-calculator/",
    badge: "Reselling",
  },
  {
    name: "Twitch Bits Converter",
    href: "/twitch-bits-to-usd/",
    badge: "Streaming",
  },
];
---

<header class="w-full bg-canvas border-b border-hairline relative">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <!-- Brand Wordmark -->
    <a
      href="/"
      class="flex items-center gap-2.5 min-h-[44px] py-1 text-heading-4 font-bold text-primary tracking-tight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-xs"
      aria-label="Seller Calc Hub Home"
    >
      <span
        class="inline-block w-4 h-4 rounded-xxs bg-logo-lime shrink-0"
        aria-hidden="true"
      ></span>
      <span class="text-ink hover:text-primary transition-colors">
        Seller Calc Hub
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden md:flex items-center gap-6"
      aria-label="Desktop Navigation"
    >
      <!-- Calculators Dropdown Menu (Accessible native details/summary) -->
      <details class="group relative">
        <summary class="list-none flex items-center gap-1.5 text-ui-label text-ink hover:text-primary transition-colors cursor-pointer py-1.5 px-2 rounded-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 select-none">
          <span>Calculators</span>
          <svg
            class="w-4 h-4 text-muted group-open:rotate-180 transition-transform duration-150"
            width="16"
            height="16"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"
            />
          </svg>
        </summary>

        <div class="absolute left-0 mt-2 w-72 rounded-lg bg-canvas border border-hairline-strong shadow-level-4 p-2 z-50 divide-y divide-hairline">
          <div class="space-y-1 pb-1">
            {calculators.map((calc) => (
              <a
                href={calc.href}
                class="flex items-center justify-between px-3 py-2 text-ui-sm text-ink hover:bg-mint-50 hover:text-primary rounded-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
              >
                <span>{calc.name}</span>
                <span class="text-micro text-muted font-normal px-1.5 py-0.5 rounded-xxs bg-canvas-soft border border-hairline">
                  {calc.badge}
                </span>
              </a>
            ))}
          </div>

          <div class="pt-1.5 mt-1 border-t border-hairline">
            <a
              href="/marketplace-fee-calculators/"
              class="flex items-center justify-between px-3 py-2 text-ui-sm font-bold text-primary hover:bg-mint-50 rounded-sm transition-colors"
            >
              <span>Compare All Platforms Side-by-Side</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </details>

      <a
        href="/marketplace-fee-calculators/"
        class="text-ui-label text-ink hover:text-primary transition-colors py-1.5 px-2 rounded-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1"
      >
        All Calculators
      </a>

      <a
        href="/methodology/"
        class="text-ui-label text-ink hover:text-primary transition-colors py-1.5 px-2 rounded-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1"
      >
        Methodology
      </a>

      <a
        href="/design-tokens/"
        class="text-ui-label text-link hover:underline py-1.5 px-2 rounded-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1"
      >
        Design Tokens
      </a>

      <!-- Theme Switcher -->
      <ThemeToggle />
    </nav>

    <!-- Mobile Navigation (Native details/summary: Zero JavaScript required) -->
    <div class="flex items-center gap-2 md:hidden">
      <div class="hidden sm:block">
        <ThemeToggle />
      </div>

      <details class="relative">
        <summary
          class="list-none flex items-center justify-center w-11 h-11 p-2 rounded-sm border border-hairline-strong text-ink hover:bg-canvas-soft cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          aria-label="Toggle mobile menu"
        >
          <!-- Hamburger Icon -->
          <svg
            class="w-5 h-5"
            width="20"
            height="20"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </summary>

        <div class="absolute right-0 mt-2 w-72 rounded-lg bg-canvas border border-hairline-strong shadow-level-4 p-3 z-50 space-y-3">
          <div class="text-eyebrow text-muted uppercase font-bold px-2">
            Marketplace Calculators
          </div>
          <div class="space-y-1">
            {calculators.map((calc) => (
              <a
                href={calc.href}
                class="flex items-center justify-between px-2.5 py-2.5 min-h-[44px] text-ui-sm text-ink hover:bg-mint-50 hover:text-primary rounded-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
              >
                <span>{calc.name}</span>
                <span class="text-micro text-muted font-normal px-1.5 py-0.5 rounded-xxs bg-canvas-soft border border-hairline">
                  {calc.badge}
                </span>
              </a>
            ))}
          </div>

          <div class="border-t border-hairline pt-2 space-y-1">
            <a
              href="/methodology/"
              class="flex items-center px-2.5 py-2.5 min-h-[44px] text-ui-sm text-ink hover:bg-mint-50 hover:text-primary rounded-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              Methodology & Sources
            </a>
            <a
              href="/about/"
              class="flex items-center px-2.5 py-2.5 min-h-[44px] text-ui-sm text-ink hover:bg-mint-50 hover:text-primary rounded-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              About Seller Calc Hub
            </a>
            <a
              href="/design-tokens/"
              class="flex items-center px-2.5 py-2.5 min-h-[44px] text-ui-sm text-link hover:underline rounded-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              Design Tokens Reference
            </a>
          </div>

          <!-- Mobile Theme Switcher (for small screens < sm) -->
          <div class="border-t border-hairline pt-2.5 flex items-center justify-between px-1 sm:hidden">
            <span class="text-caption text-muted font-medium">Appearance</span>
            <ThemeToggle />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
