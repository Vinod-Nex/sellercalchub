---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  items: FAQItem[];
  title?: string;
  description?: string;
  id?: string;
}

const {
  items,
  title = 'Frequently Asked Questions',
  description,
  id = 'faq',
} = Astro.props;
---

<section class="space-y-6 pt-6 border-t border-hairline" id={id}>
  <div class="space-y-2">
    <h2 class="text-heading-2 font-bold text-ink">{title}</h2>
    {description && <p class="text-body-md text-muted max-w-2xl">{description}</p>}
  </div>

  <div class="space-y-3">
    {
      items.map((faq) => (
        <details class="group rounded-lg border border-hairline-strong bg-canvas p-4 transition-colors hover:border-primary">
          <summary class="flex items-center justify-between min-h-[44px] py-1 font-bold text-ink text-ui-label cursor-pointer list-none select-none">
            <span>{faq.question}</span>
            <svg
              class="w-4 h-4 text-muted group-open:rotate-180 transition-transform duration-150 shrink-0 ml-2"
              width="16"
              height="16"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                clip-rule="evenodd"
              />
            </svg>
          </summary>
          <div class="mt-3 text-body text-body-sm leading-relaxed border-t border-hairline pt-3">
            {faq.answer}
          </div>
        </details>
      ))
    }
  </div>
</section>
