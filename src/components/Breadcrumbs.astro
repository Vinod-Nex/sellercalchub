---
import type { BreadcrumbItem } from '../lib/schema';
export type { BreadcrumbItem };

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<!-- Visible Semantic HTML Breadcrumbs (WCAG AA compliant) -->
<nav aria-label="Breadcrumb" class={`py-2 text-caption ${className}`}>
  <ol class="flex flex-wrap items-center gap-1.5 list-none p-0 m-0 text-muted">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="inline-flex items-center gap-1.5">
          {index > 0 && (
            <svg
              class="w-3.5 h-3.5 text-faint shrink-0"
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 12 10 8 6 4" />
            </svg>
          )}
          {isLast || !item.href ? (
            <span
              class="text-ink font-medium truncate max-w-xs sm:max-w-md"
              aria-current={isLast ? 'page' : undefined}
            >
              {item.name}
            </span>
          ) : (
            <a
              href={item.href}
              class="text-muted hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 rounded-xxs"
            >
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
