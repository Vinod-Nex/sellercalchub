---
/**
 * Centered, accessible privacy guarantee modal dialog.
 * Positioned squarely in the center of the viewport with a subtle backdrop overlay.
 * Dismissible via "Got it" button, close icon, clicking the backdrop, or pressing Escape.
 * Stored in localStorage (sch_privacy_notice_dismissed).
 */
---

<div
  id="privacy-notice"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 transition-all duration-200 hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="privacy-modal-title"
  aria-describedby="privacy-modal-desc"
>
  <!-- Semi-transparent backdrop overlay -->
  <div
    id="privacy-backdrop"
    class="fixed inset-0 bg-black/50 backdrop-blur-xs transition-opacity cursor-pointer"
    aria-hidden="true"
  ></div>

  <!-- Centered Modal Card -->
  <div
    class="relative w-full max-w-[560px] mx-auto rounded-xl border border-hairline-strong bg-canvas p-6 sm:p-7 shadow-level-4 text-ui-sm text-body z-10 space-y-4"
    style="max-width: min(560px, calc(100vw - 2rem)); width: 100%; box-sizing: border-box;"
  >
    <!-- Modal Header -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-mint-50 dark:bg-mint-200/10 border border-mint-200 flex items-center justify-center text-primary shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-xxs bg-mint-50 dark:bg-mint-200/10 text-primary text-micro font-bold uppercase tracking-wider border border-mint-200 mb-0.5">
            100% Client-Side Privacy
          </div>
          <h2 id="privacy-modal-title" class="text-heading-3 font-bold text-ink">
            Privacy &amp; Local Calculations
          </h2>
        </div>
      </div>
      <button
        type="button"
        id="dismiss-privacy-notice"
        class="text-muted hover:text-ink text-heading-3 font-bold min-w-[44px] min-h-[44px] -mr-2 -mt-2 flex items-center justify-center rounded-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer"
        aria-label="Close privacy notice"
      >
        &times;
      </button>
    </div>

    <!-- Modal Body -->
    <p id="privacy-modal-desc" class="text-body-sm text-body leading-relaxed">
      Seller Calc Hub runs all marketplace calculations directly in your web browser. Your entered prices, item acquisition costs, and profit margins are never transmitted across the internet, never collected, and never stored on any server or remote database.
    </p>

    <!-- 3-Pillar Privacy Badges -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1">
      <div class="p-3 rounded-sm border border-hairline bg-canvas-soft space-y-1">
        <span class="text-caption font-bold text-ink flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-primary shrink-0" aria-hidden="true"></span>
          Zero Tracking
        </span>
        <span class="text-micro text-muted block leading-tight">No third-party ad networks or marketing pixels.</span>
      </div>
      <div class="p-3 rounded-sm border border-hairline bg-canvas-soft space-y-1">
        <span class="text-caption font-bold text-ink flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-primary shrink-0" aria-hidden="true"></span>
          Local Device Math
        </span>
        <span class="text-micro text-muted block leading-tight">Calculations execute entirely inside your browser.</span>
      </div>
      <div class="p-3 rounded-sm border border-hairline bg-canvas-soft space-y-1">
        <span class="text-caption font-bold text-ink flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-primary shrink-0" aria-hidden="true"></span>
          Theme Storage
        </span>
        <span class="text-micro text-muted block leading-tight">Storage used strictly for light/dark theme preference.</span>
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-hairline">
      <a
        href="/privacy/"
        class="text-caption text-primary hover:underline font-semibold min-h-[44px] inline-flex items-center gap-1 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary rounded-xxs"
      >
        <span>Read Full Privacy Policy</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
      <button
        type="button"
        id="ack-privacy-notice"
        class="w-full sm:w-auto px-6 py-2.5 min-h-[44px] inline-flex items-center justify-center bg-forest hover:bg-primary-deep text-white text-ui-label font-bold rounded-xs transition-colors shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary cursor-pointer"
      >
        Got it, Continue
      </button>
    </div>
  </div>
</div>

<script>
  function initPrivacyNotice() {
    const modal = document.getElementById('privacy-notice');
    if (!modal) return;

    try {
      const isDismissed = localStorage.getItem('sch_privacy_notice_dismissed');
      if (!isDismissed) {
        modal.classList.remove('hidden');
      }
    } catch {
      // localStorage may be disabled in private browsing mode; leave hidden
    }

    const dismissBtn = document.getElementById('dismiss-privacy-notice');
    const ackBtn = document.getElementById('ack-privacy-notice');
    const backdrop = document.getElementById('privacy-backdrop');

    const handleDismiss = () => {
      modal.classList.add('hidden');
      try {
        localStorage.setItem('sch_privacy_notice_dismissed', 'true');
      } catch {
        // Ignore storage errors in private browsing
      }
    };

    dismissBtn?.addEventListener('click', handleDismiss);
    ackBtn?.addEventListener('click', handleDismiss);
    backdrop?.addEventListener('click', handleDismiss);

    // Close on Escape key press (WCAG AA accessible dialog pattern)
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        handleDismiss();
      }
    });
  }

  // Defer privacy banner initialization to idle time to preserve 0ms TBT on mobile
  const scheduleInit = () => {
    if ('requestIdleCallback' in window) {
      (window as unknown as { requestIdleCallback: (cb: () => void) => void }).requestIdleCallback(initPrivacyNotice);
    } else {
      setTimeout(initPrivacyNotice, 800);
    }
  };

  if (document.readyState === 'complete') {
    scheduleInit();
  } else {
    window.addEventListener('load', scheduleInit, { once: true });
  }
</script>
