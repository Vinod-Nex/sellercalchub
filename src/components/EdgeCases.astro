---
import { getPlatformFeeData } from '../lib/calc/fee-data';

export interface EdgeCaseItem {
  title: string;
  description: string;
  impact: string;
}

export interface Props {
  platform?: string;
  title?: string;
  description?: string;
  cases?: EdgeCaseItem[];
  id?: string;
}

const {
  platform,
  title,
  description,
  cases: propCases,
  id = 'edge-cases',
} = Astro.props;

const feeData = platform ? getPlatformFeeData(platform) : undefined;
const platformName = feeData?.platform_name ?? 'Marketplace';

function getDefaultEdgeCases(p?: string): EdgeCaseItem[] {
  if (propCases && propCases.length > 0) return propCases;

  switch (p) {
    case 'ebay-us':
      return [
        {
          title: 'Sales Tax Included in Fee Base',
          description:
            'eBay assesses its percentage Final Value Fee on the gross buyer total, which includes state sales tax automatically collected at checkout. This raises effective fees by 0.5% to 1.2% depending on the buyer’s state tax rate.',
          impact: '+0.5% to +1.2% effective fee on gross proceeds',
        },
        {
          title: 'High-Value Tier Reductions ($7,500+ Threshold)',
          description:
            'For most categories, the Final Value Fee drops from 13.25% down to 2.35% on the portion of the sale price above $7,500 per item ($2,500 for computers; $5,000 for watches and jewelry).',
          impact: '2.35% marginal rate above $7,500 threshold',
        },
        {
          title: 'Below Standard Seller Performance Penalty',
          description:
            'Sellers who do not meet eBay’s minimum performance standards are charged an additional 5.0% Final Value Fee surcharge on all item sales until their evaluation status improves.',
          impact: '+5.0% surcharge across all listing sales',
        },
        {
          title: 'Sneakers ($150+) & Heavy Equipment Exceptions',
          description:
            'Men’s and Women’s Athletic Shoes selling for $150 or more qualify for a lower 8.0% fee with the $0.40 per-order fee completely waived. Heavy Equipment fees are capped at 3.0% up to $15,000 and 0.5% thereafter.',
          impact: '8.0% flat fee and $0 per-order fee waived',
        },
        {
          title: 'Order Cancellations and Returns',
          description:
            'When a seller issues a full refund for a returned or cancelled order, eBay credits back the variable percentage Final Value Fee, but retains the fixed $0.40 per-order fee.',
          impact: 'Percentage refunded; $0.40 per-order fee retained',
        },
      ];

    case 'ebay-uk':
      return [
        {
          title: '0% Private Individual Sellers vs 12.8% Business',
          description:
            'eBay UK charges 0% final value fees for private non-business sellers on most categories. Registered UK business sellers pay standard 12.8% plus £0.30 per order.',
          impact: '0% commission for personal sellers vs 12.8% business',
        },
        {
          title: '20% UK VAT Applied to eBay Fees',
          description:
            'eBay selling fees charged to UK business sellers are subject to 20% UK VAT, resulting in an effective fee rate of 15.36% + £0.36 per order unless the seller reclaims VAT with HMRC.',
          impact: 'Effective 15.36% + £0.36 total business charge',
        },
        {
          title: 'International Buyer Cross-Border Fee',
          description:
            'If the buyer’s registered address is outside the UK, eBay assesses an additional international fee between 1.05% and 2.0% of the total transaction amount.',
          impact: '+1.05% to +2.0% on cross-border orders',
        },
        {
          title: 'Below Standard Performance Surcharge',
          description:
            'Business accounts falling below eBay UK minimum performance standards incur an additional 4.0% fee surcharge on the item value.',
          impact: '+4.0% penalty fee on below-standard listings',
        },
      ];

    case 'etsy':
      return [
        {
          title: 'Offsite Ads Mandatory Threshold ($10,000 Milestone)',
          description:
            'Once your shop generates $10,000 USD in 12-month trailing sales, participation in Etsy Offsite Ads becomes mandatory for the life of the shop at a 12% fee (capped at $100 per attributed sale). Standard shops pay 15% and can opt out.',
          impact: '12% mandatory fee on ad-driven sales',
        },
        {
          title: 'Multi-Quantity Listing Auto-Renewals',
          description:
            'When a customer buys an item from a multi-quantity listing, Etsy immediately charges a $0.20 renewal fee to re-list the remaining available stock for another 4-month cycle.',
          impact: '$0.20 charged on every additional unit sold',
        },
        {
          title: 'Payment Processing on Shipping and Sales Tax',
          description:
            'Etsy Payments charges 3.0% + $0.25 on the total buyer payment, which includes buyer-paid shipping and state sales tax automatically collected by Etsy.',
          impact: '3.0% + $0.25 applied to gross order total',
        },
        {
          title: 'Currency Conversion Surcharge (2.5%)',
          description:
            'If your listing price currency differs from the payment currency of your bank account, Etsy assesses a 2.5% currency conversion fee on the total transaction amount.',
          impact: '2.5% conversion fee on multi-currency shops',
        },
      ];

    case 'whatnot':
      return [
        {
          title: 'Commission vs Payment Processing Base',
          description:
            'Whatnot’s 8.0% commission applies strictly to the sold item hammer price. The 2.9% + $0.30 payment processing fee applies to the entire buyer order including shipping and sales tax.',
          impact: '8.0% on hammer price; 2.9% + $0.30 on order total',
        },
        {
          title: 'Livestream Buyer Giveaways',
          description:
            'Whatnot charges zero commission and zero processing fees on free giveaways held during livestreams; the seller only covers the cost of prepaid carrier postage.',
          impact: '$0.00 platform fees; seller pays postage only',
        },
        {
          title: 'Livestream Tips and Donations',
          description:
            'Tips sent by viewers during live auctions are not subject to the 8.0% commission, but incur standard 2.9% + $0.30 payment gateway processing.',
          impact: '2.9% + $0.30 processing; 0% commission',
        },
        {
          title: 'Package Weight Discrepancies and Overages',
          description:
            'If the package weight scanned by the postal carrier exceeds the declared shipping label tier, Whatnot automatically charges the postage difference to your seller payout balance.',
          impact: 'Carrier rate adjustment deducted from balance',
        },
      ];

    case 'tiktok-shop':
      return [
        {
          title: 'Platform Vouchers vs Seller-Funded Discounts',
          description:
            'When TikTok provides a platform-funded promotional voucher to buyers, the 6.0% referral fee is calculated on the pre-discount amount, but TikTok credits the seller the full voucher subsidy upon settlement.',
          impact: 'Full subsidy credited back to seller payout',
        },
        {
          title: 'Free Shipping Subsidies and Deductions',
          description:
            'When sellers opt into promotional free shipping campaigns, the actual postage label cost is deducted directly from the gross settlement amount.',
          impact: 'Seller-funded labels deducted from net payout',
        },
        {
          title: 'Return and Cancellation Fee Adjustments',
          description:
            'When a customer return or order cancellation is approved, TikTok Shop automatically credits back the 6.0% referral fee proportionately to the refunded amount.',
          impact: '100% of referral fee credited on full refunds',
        },
      ];

    case 'twitch-bits':
      return [
        {
          title: 'Guaranteed $0.01 Streamer Rate',
          description:
            'Creators receive exactly $0.01 USD per Bit cheered regardless of viewer bundle discounts, platform sales, or mobile app store markups.',
          impact: '$0.010 per bit fixed creator payout',
        },
        {
          title: 'Twitch Minimum Payout Threshold',
          description:
            'Twitch releases creator payouts only after your total channel balance reaches $50 for direct deposit/ACH, PayPal, or check, or $100 for international wire transfers.',
          impact: '$50 minimum account threshold for payout',
        },
        {
          title: 'International Creator Withholding Tax',
          description:
            'Non-US streamers without a certified W-8BEN tax treaty form on file with Twitch may be subject to up to 30% US IRS withholding tax deducted from their Bit payouts.',
          impact: '0% to 30% IRS backup withholding if untreatied',
        },
      ];

    case 'depop':
      return [
        {
          title: '0% Selling Fee with 3.3% + $0.45 Processing',
          description:
            'Depop has eliminated marketplace selling fees for US sellers, but Depop Payments processing (3.3% + $0.45) still applies to the full order total including shipping and sales tax.',
          impact: '3.3% + $0.45 gateway fee on total buyer payment',
        },
        {
          title: 'Depop Boosted Listing Surcharge (8.0%)',
          description:
            'Boosting listings is completely optional. If an item sells within 28 days of a buyer clicking your boosted listing, Depop charges an 8.0% boosting fee in addition to payment processing.',
          impact: '+8.0% optional fee on boosted sales',
        },
        {
          title: 'Custom Shipping Label Protection',
          description:
            'If you select custom shipping instead of "Ship with Depop" prepaid USPS labels, you must provide valid carrier tracking to retain seller dispute protection on lost packages.',
          impact: 'Requires manual tracking upload for protection',
        },
      ];

    default:
      return [
        {
          title: 'Sales Tax Processing Impact',
          description:
            'Most marketplaces (eBay, Etsy, Whatnot, Depop) calculate payment processing or final value percentages on the gross customer payment including state sales tax.',
          impact: '+0.5% to +1.2% effective fee on gross proceeds',
        },
        {
          title: 'Tiered High-Value Caps',
          description:
            'High-ticket items typically benefit from reduced commission percentages once sales pass thresholds ($7,500 on eBay, $100 fee cap on Etsy Offsite Ads).',
          impact: 'Substantial fee reductions on high-ticket sales',
        },
        {
          title: 'Seller Performance Metrics',
          description:
            'Maintaining top-tier seller ratings avoids below-standard fee penalties (e.g. eBay +5% surcharge) and unlocks lower commission tiers.',
          impact: 'Protects profit margins from penalty surcharges',
        },
      ];
  }
}

const resolvedTitle = title ?? `${platformName} Fee Edge Cases & Special Conditions`;
const resolvedDescription =
  description ??
  `Critical fee nuances, sales tax rules, category thresholds, and seller account exceptions that impact your take-home profits on ${platformName}.`;
const items = getDefaultEdgeCases(platform);
---

<section class="space-y-6 pt-6 border-t border-hairline" id={id} aria-label={`${platformName} Fee Edge Cases`}>
  <div class="space-y-2">
    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xs bg-canvas-soft border border-hairline text-caption font-bold text-ink">
      <span>Rule Exceptions &amp; Nuances</span>
    </div>
    <h2 class="text-heading-2 font-bold text-ink">{resolvedTitle}</h2>
    <p class="text-body text-body leading-relaxed max-w-3xl">{resolvedDescription}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {items.map((item) => (
      <div class="rounded-lg border border-hairline bg-canvas p-5 space-y-3 shadow-xs hover:border-hairline-strong transition-colors flex flex-col justify-between">
        <div class="space-y-2">
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-heading-4 font-bold text-ink">{item.title}</h3>
          </div>
          <p class="text-body-sm text-body leading-relaxed">{item.description}</p>
        </div>
        <div class="pt-2 border-t border-hairline/60">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-xs bg-canvas-soft border border-hairline text-[11px] font-semibold text-primary">
            <svg class="w-3 h-3 text-primary shrink-0" width="12" height="12" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
            </svg>
            <span>{item.impact}</span>
          </span>
        </div>
      </div>
    ))}
  </div>
</section>
