---
export interface Props {
  platformName?: string;
  sourceUrl?: string;
  compact?: boolean;
}

const {
  platformName,
  sourceUrl,
  compact = false,
} = Astro.props;
---

{
  compact ? (
    <div class="rounded-xs border border-amber-200 dark:border-amber-900/40 bg-amber-50 dark:bg-amber-950/20 p-3 text-caption text-amber-900 dark:text-amber-200 space-y-1">
      <div class="flex items-center gap-1.5 font-bold">
        <svg class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        <span>Estimates Only — Check Official Marketplace Statement</span>
      </div>
      <p class="leading-relaxed">
        Calculations are estimates for business planning. Always verify final transaction deductions on{' '}
        {sourceUrl ? (
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="underline font-semibold hover:text-amber-950 dark:hover:text-amber-100">
            {platformName ?? 'the official fee schedule'}
          </a>
        ) : (
          <span>the official marketplace fee schedule</span>
        )}.
      </p>
    </div>
  ) : (
    <aside class="rounded-lg border-2 border-hairline-strong bg-canvas p-6 space-y-3 shadow-sm" aria-label="Fee Disclaimer">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-100 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 text-caption font-bold shrink-0" aria-hidden="true">
          !
        </span>
        <h3 class="text-heading-4 font-bold text-ink">
          Official Fee Estimates &amp; Financial Disclaimer
        </h3>
      </div>
      <p class="text-body-sm text-body leading-relaxed">
        All calculations provided on Seller Calc Hub are estimates for educational, simulation, and business planning purposes only. While our rate schedules are audited against officially published documentation from {platformName ?? 'marketplace providers'}, actual fees assessed on individual transactions may vary due to buyer location, state sales tax collection, packaging dimensions, category-specific thresholds, or unannounced marketplace policy amendments.
      </p>
      <div class="flex flex-wrap items-center justify-between gap-3 pt-2 text-caption border-t border-hairline text-muted">
        <span>Always verify actual payout deductions on your official seller statements.</span>
        <div class="flex items-center gap-4">
          <a href="/methodology/" class="text-primary hover:underline font-semibold focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary rounded-xxs">
            Verification Methodology &rarr;
          </a>
          <a href="/terms/" class="text-primary hover:underline font-semibold focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary rounded-xxs">
            Terms of Service &rarr;
          </a>
        </div>
      </div>
    </aside>
  )
}
